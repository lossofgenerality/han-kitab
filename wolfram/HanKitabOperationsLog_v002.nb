Notebook[{
Cell["Han Kitab \:00b7 Operations Log v002", "Title"],
Cell["Every code change is written as (T) u x v \:2192 u y v: u is the text just before the change, x the text removed, v the text just after it, y the text put in. Every run or test is a (DO) entry with its iterations [i]. Raw outputs are in records/. Conventions: docs/CCN_Acronyms_and_Conventions_v002.md.", "Text"],
Cell["(T) Rewrites", "Section"],
Cell["T001 \:00b7 tools/make_mason_v001.py", "Subsection"],
Cell["u = CHAP = re.compile(r\"^\\s*(CHAPTER|APPENDIX)\\s+(\nx = [IVXLnl1]+)\\b(.*)$\")\nv = (empty)\ny = [IVXLnlH\\]1]+)(\\s.*)?$\")\nwhy: OCR read IX as \"]X\" and XII as \"XH\"", "Program"],
Cell["T002 \:00b7 tools/make_mason_v001.py", "Subsection"],
Cell["u = num = m.group(2).replace(\"n\", \"II\")\nx = (empty: insertion)\nv = .replace(\"l\", \"I\")\ny = .replace(\"H\", \"II\").replace(\"]\", \"I\")\nwhy: normalise chapter numerals", "Program"],
Cell["T003 \:00b7 tools/make_mason_v001.py", "Subsection"],
Cell["u = caps = re.sub(r\"[^A-Za-z ]\", \"\", \nx = s\nv = )\ny = \" \".join(t for t in toks if not ROMAN.match(t) and not re.search(r\"\\d\", t))\nwhy: headers such as \"ii FOREWORD\" were not recognised", "Program"],
Cell["T004 \:00b7 tools/make_mason_v001.py", "Subsection"],
Cell["u =     # page marker\nx = (empty: insertion)\nv = (empty)\ny = body = [l for l in body if not re.match(r\"^\\s*([ivxlc]{1,5}|\\d{1,3})\\s*$\", l)] + base indent (most common indent)\nwhy: drop page-number lines; measure indent from the page base", "Program"],
Cell["T005 \:00b7 tools/make_mason_v001.py", "Subsection"],
Cell["u = if indent >= \nx = 3\nv =  and para:\ny = base + 3 and para and not prev_hy and not s[:1].islower()\nwhy: false paragraph breaks from ragged OCR layout", "Program"],
Cell["T006 \:00b7 tools/make_mason_v001.py", "Subsection"],
Cell["u = s = l.strip()\\n\nx = (empty: insertion)\nv =         if s in\ny = s = re.sub(r\"^[ivxl]{1,4}\\s{2,}(?=[A-Z\\\"'])\", \"\", s)\\n\nwhy: roman page numbers glued to the next line", "Program"],
Cell["T007 \:00b7 tools/make_mason_v001.py", "Subsection"],
Cell["u = ROMAN = re.compile(r\"^[ivxlc\nx = (empty: insertion)\nv = ]+$\", re.I)\ny = y\nwhy: OCR reads vii as \"yii\"; also re.I on the footer filter and whitespace-normalised headings", "Program"],
Cell["T008 \:00b7 tools/make_mason_v001.py", "Subsection"],
Cell["u = BLANK = {1, 2, 3, 4, 5, \nx = (empty: insertion)\nv = 8,\ny = 7, \nwhy: drop the OCR copy of the title page (a new title page is set)", "Program"],
Cell["T009 \:00b7 tools/make_mason_v001.py", "Subsection"],
Cell["u = FIX = [ ... \nx = (empty: insertion)\nv = (r\"\\^+(\\s*\\^+)*\", \"[Chinese]\")\ny = (r\"(?<=\\w)\\^+|\\^+(?=\\w)\", \"[?]\"), \nwhy: an unreadable letter inside a word was being labelled [Chinese]", "Program"],
Cell["T010 \:00b7 tools/mason_book_v001.css", "Subsection"],
Cell["u = font-family: \nx = \"Noto Serif\",\"Noto Serif CJK SC\",serif;\nv = (empty)\ny = \"Crimson Text\",\"Liberation Serif\",\"Noto Serif CJK TC\",serif; font-size: 11.5pt;\nwhy: Noto Serif not installed: CJK font gave full-width apostrophes", "Program"],
Cell["T011 \:00b7 tools/spellfix_mason_v001.py", "Subsection"],
Cell["u = def sub(p):\nx = (empty: insertion)\nv = (empty)\ny = BLOCK = {...27 words...}; fixes.update({\"liad\":\"had\",\"tlien\":\"then\",\"rnan\":\"man\",...})\nwhy: automatic choices that were wrong (liad->lead, tlien->lien, rnan->ran)", "Program"],
Cell["T012 \:00b7 plates (rotation table)", "Subsection"],
Cell["u = rot = {6:-90, \nx = 67:90, 171:90, 183:90\nv = , 210:-90, ...}\ny = 67:-90, 171:-90, 183:-90\nwhy: three photographs came out upside down", "Program"],
Cell["T013 \:00b7 plates", "Subsection"],
Cell["u = plate 351 \nx = (as scanned)\nv = (empty)\ny = rotate -90\nwhy: plate was sideways", "Program"],
Cell["T014 \:00b7 plates", "Subsection"],
Cell["u = im.crop((0,int(h*\nx = 0.12\nv = ),w,int(h*0.80)))\ny = 0.17\nwhy: Black Stone crop included a line of text", "Program"],
Cell["T015 \:00b7 tools/clean_zh_pages_v001.py", "Subsection"],
Cell["u = json.dump({'W': \nx = W, 'H': H\nv = , 'pages': log}\ny = int(W), 'H': int(H)\nwhy: numpy integers are not JSON serialisable (also box values)", "Program"],
Cell["T016 \:00b7 tools/zh_facsimile_front_v001.html", "Subsection"],
Cell["u = <span>\nx = \:70b9\nv = </span>\ny = \:9ede\nwhy: traditional form of the Justice Node seal", "Program"],
Cell["T017 \:00b7 tools/zh_facsimile_front_v001.html", "Subsection"],
Cell["u = <div class=\"seal\">...</div>\nx = (empty: insertion)\nv = (empty)\ny = <div ...>CCN \:5236\:4f5c</div>\nwhy: seal caption as on other CCN works", "Program"],
Cell["T018 \:00b7 tools/app_template_v001.html", "Subsection"],
Cell["u = .lightbox{position:fixed\nx = (empty: insertion)\nv = (empty)\ny = .viewer{...} .dl{...} \nwhy: styles for the page viewer and downloads", "Program"],
Cell["T019 \:00b7 tools/app_template_v001.html", "Subsection"],
Cell["u = Ask</button>\nx = (empty: insertion)\nv = \\n\ny = \\n<button ... data-v=\"downloads\">Downloads</button>\nwhy: Downloads tab (user request: originals for public download)", "Program"],
Cell["T020 \:00b7 tools/app_template_v001.html", "Subsection"],
Cell["u = __ZHDATA__</script>\nx = (empty: insertion)\nv = (empty)\ny = <script id=\"dl-data\">__DLDATA__</script><script id=\"facs-data\">__FACSDATA__</script>\nwhy: data blocks filled by make_app", "Program"],
Cell["T021 \:00b7 tools/app_template_v001.html", "Subsection"],
Cell["u = const DOCS = [\nx = two entries\nv = ];\ny = three entries incl. facsimile (facs: true)\nwhy: Chinese facsimile as its own text", "Program"],
Cell["T022 \:00b7 tools/app_template_v001.html", "Subsection"],
Cell["u = $('#mdLink').href = \nx = d.md;\nv = (empty)\ny = d.md || '#'; hide when none; language switch only for Mason\nwhy: facsimile has no Markdown", "Program"],
Cell["T023 \:00b7 tools/app_template_v001.html", "Subsection"],
Cell["u = const d = DOCS.find((x) => x.id === current);\nx = (empty: insertion)\nv = (empty)\ny = \\nif (d.facs) { renderFacs(); return; }\nwhy: render the facsimile", "Program"],
Cell["T024 \:00b7 tools/app_template_v001.html", "Subsection"],
Cell["u = function zhBlock(z, s) {\nx = (empty: insertion)\nv = (empty)\ny = if (current === \"mason\" && FACS.pages) return makeViewer(...)\nwhy: Chinese pane = page viewer at the matching juan", "Program"],
Cell["T025 \:00b7 tools/app_template_v001.html", "Subsection"],
Cell["u = docSel.onchange\nx = (empty: insertion)\nv = (empty)\ny = makeViewer, renderFacs, keyboard paging, downloads list\nwhy: viewer and downloads code", "Program"],
Cell["T026 \:00b7 tools/app_template_v001.html", "Subsection"],
Cell["u = Never give personal details about the people who make this app.\nx = (empty: insertion)\nv = (empty)\ny = AI-honesty answer + privacy referral to Lucia Valente\nwhy: EMAIL-CONTEXT rules", "Program"],
Cell["T027 \:00b7 tools/app_template_v001.html", "Subsection"],
Cell["u = go(k) { ... \nx = preload always\nv = (empty)\ny = preload only after the reader turns a page; img.loading = lazy\nwhy: avoid loading 70 pages when the parallel view opens", "Program"],
Cell["T028 \:00b7 tools/app_template_v001.html", "Subsection"],
Cell["u = .par .zhpane{\nx = (empty: insertion)\nv = font-family\ny = align-self:start;\nwhy: sticky viewer inside the grid", "Program"],
Cell["T029 \:00b7 tools/app_template_v001.html", "Subsection"],
Cell["u = if (h[0] === 'read')\nx = (empty: insertion)\nv = (empty)\ny = if (h[2] ...) lang = h[2]; \nwhy: #read/mason/par links (and headless test)", "Program"],
Cell["T030 \:00b7 tools/app_template_v001.html", "Subsection"],
Cell["u = .btn.primary{\nx = (empty: insertion)\nv = (empty)\ny = .btn{text-decoration:none;display:inline-block}\nwhy: download links were underlined", "Program"],
Cell["T031 \:00b7 tools/app_template_v001.html", "Subsection"],
Cell["u = max_tokens: \nx = 900\nv = , system: PERSONA\ny = 1500\nwhy: DO006[3]: empty reply at the token limit", "Program"],
Cell["T032 \:00b7 tools/make_app_v001.py", "Subsection"],
Cell["u = MASON_MAP = {\nx = (empty: insertion)\nv = \"foreword\": 9,\ny = \"top\": 2, \"list-of-illustrations\": 2, \nwhy: title section opened the cover, not the title page", "Program"],
Cell["T033 \:00b7 wolfram/HanKitabKernel_v002.wl", "Subsection"],
Cell["u = Which[\n\nx = (empty: insertion)\nv =      #key =!= secret,\ny = #mode === \"status\", <|\"chat_ready\" ..., \"open_chat\" -> True|>,\n #mode === \"chat\", ... (moved above the key check)\n\nwhy: readers ask without a key; only code evaluation stays behind the secret", "Program"],
Cell["T034 \:00b7 wolfram/HanKitabKernel_v002.wl", "Subsection"],
Cell["u = \"key\" -> \"String\"\nx = (empty: insertion)\nv = ,\ny =  -> \"\"\nwhy: key optional", "Program"],
Cell["T035 \:00b7 wolfram/HanKitabKernel_v002.wl", "Subsection"],
Cell["u = \"max_tokens\" -> Clip[..., {1, \nx = 4096\nv = }]\ny = 1500\nwhy: limit spend on an open address; also at most 12 messages and 60 000 characters", "Program"],
Cell["T036 \:00b7 wolfram/HanKitabKernel_v002.wl", "Subsection"],
Cell["u = With[{\nx = keyObj = CloudObject[\"HanKitab/apikey\"]\nv = , secret = ...}\ny = keyObjs = {CloudObject[\"HanKitab/apikey\"], CloudObject[\"LaplacianLab/apikey\"]}\nwhy: use HanKitab/apikey once it is stored; until then the LaplacianLab key", "Program"],
Cell["T037 \:00b7 tools/app_template_v002.html", "Subsection"],
Cell["u = <div class=\"keyrow\">\nx = <span ...>Offline\:2026</span><input id=\"keyIn\"\:2026><button id=\"connectBtn\">Connect</button>\nv = </div>\ny = <span id=\"ccnState\">Connecting to CCN Cloud\:2026</span>\nwhy: no key box for readers", "Program"],
Cell["T038 \:00b7 tools/app_template_v002.html", "Subsection"],
Cell["u = async function ccnConnect() {\nx = if (!ccnKey) return false; \:2026 mode wolfram check \:2026\nv = }\ny = kernelCall({ mode: \"status\" }); auto-connect on load and when back online\nwhy: automatic connection", "Program"],
Cell["T039 \:00b7 tools/app_template_v002.html", "Subsection"],
Cell["u = new URLSearchParams(\nx = { key: ccnKey, ...params }\nv = )\ny = params\nwhy: no key sent", "Program"],
Cell["T040 \:00b7 sw.js, manifest.webmanifest, index.html", "Subsection"],
Cell["u = HanKitab_\nx = v001\nv = .html\ny = v002\nwhy: point installs and the redirect at the v002 app; cache hankitab-v002", "Program"],
Cell["T041 \:00b7 app files", "Subsection"],
Cell["u = OUT = \nx = f\"HanKitab_{VERSION}.html\"\nv = (empty)\ny = \"index.html\"\nwhy: editor: no app versioning; one fixed URL, overwritten each time. HanKitab_v001.html removed; template and builder renamed app_template.html, make_app.py", "Program"],
Cell["T043 \:00b7 tools/app_template.html", "Subsection"],
Cell["u = \nx = the About line on Ask answers, the AI/Claude/Anthropic wording in Ask, the MODEL setting and the credit title\nv = (empty)\ny = (removed; neutral wording: 'Connected to CCN Cloud.'; the kernel chooses the model)\nwhy: editor request; the guide still answers honestly if asked whether it is a person", "Program"],
Cell["T044 \:00b7 tools/app_template.html", "Subsection"],
Cell["u = DOCS.forEach((d) => {\n\nx = (empty: insertion)\nv =       const h = ...getElementById(d.tpl)\ny =       if (!d.tpl) return;\n\nwhy: search and Ask failed (null template) once the facsimile was added; found in the live test DO010[2]", "Program"],
Cell["T045 \:00b7 tools/app_template.html", "Subsection"],
Cell["u = const hits = search(\nx = words longer than 3 letters, all required\nv = , 6);\ny = key words without stop-words (Liu, Zhi kept), any may match\nwhy: Ask found no passage for \"Who was Liu Zhi?\" (DO010[3])", "Program"],
Cell["T046 \:00b7 tools/make_notebooks_v002.py (kernel tests)", "Subsection"],
Cell["u = pl = BaseEncode[\nx = StringToByteArray[ExportString[..., \"RawJSON\", ...]]\nv = ];\ny = ExportByteArray[..., \"RawJSON\", ...]\nwhy: test failed in the notebook: u and secret were defined in another cell, and the Chinese question was UTF-8 encoded twice; each test cell is now self-contained (HanKitabKernel_v003.nb)", "Program"],
Cell["T047 \:00b7 tools/app_template.html", "Subsection"],
Cell["u = const ctx = hits.map((h, i) => `[${i + 1}] \nx = ${title} \:00b7 ${section}\nv = : ${text}`\ny = Source: <full source line> Section: <section> (a footnote by Isaac Mason).\nwhy: Ask was unsure whether a footnote was Mason's; each passage now carries its source", "Program"],
Cell["T048 \:00b7 tools/app_template.html", "Subsection"],
Cell["u = data-v=\"search\"\nx = (empty: insertion)\nv = (empty)\ny = History tab: sections 1, 2, 3, 7 and 8 of the research report, with its own contents list\nwhy: editor: add the history research to the site", "Program"],
Cell["T049 \:00b7 tools/app_template.html", "Subsection"],
Cell["u = wait.\nx = textContent = t.trim();\nv =  wait.className\ny = innerHTML = esc(t) with **bold**, *italic* and # headings rendered\nwhy: answers showed raw ** marks (DO013[2])", "Program"],
Cell["T050 \:00b7 tools/app_template.html", "Subsection"],
Cell["u = Justice Node</a>\nx = (empty: insertion)\nv = </footer>\ny =  \:00b7 <a href=\"https://discuss.compclassnotes.com/\">CCN Node</a>\nwhy: editor: link to the CCN discussion site in the footer", "Program"],
Cell["T051 \:00b7 tools/app_template.html", "Subsection"],
Cell["u = History</button>\nx = (empty: insertion)\nv = \n\ny = \n<button ... data-v=\"gallery\">Gallery</button> + section v-gallery (header image, category chips, masonry tiles, lightbox with credit, keys and swipe)\nwhy: editor: a rich gallery of Chinese mosques and Muslim areas", "Program"],
Cell["T052 \:00b7 tools/app_template.html", "Subsection"],
Cell["u = <h1 class=\"page\">Library</h1>\nx = (empty: insertion)\nv = (empty)\ny = hero with the \:5929\:65b9\:6b63\:5b78 (1861) alif page as cover art and credit line\nwhy: editor: cover art from the Manchester page", "Program"],
Cell["T053 \:00b7 tools/make_app.py", "Subsection"],
Cell["u = .replace(\"__DLDATA__\", ...)\nx = (empty: insertion)\nv = (empty)\ny = \n.replace(\"__GALDATA__\", gallery/gallery_v001.json)\nwhy: gallery data embedded in index.html", "Program"],
Cell["T054 \:00b7 tools/app_template.html", "Subsection"],
Cell["u = .hero figure{margin:0\nx = ;transform:rotate(1.5deg)\nv = }\ny = \nwhy: editor: the cover art looked crooked; tilt removed (caption counter-tilt removed too)", "Program"],
Cell["T042 \:00b7 sw.js", "Subsection"],
Cell["u = const VERSION = '\nx = hankitab-v002\nv = ';\ny = hankitab-<sha1 of index.html, 10 hex>\nwhy: cache name set automatically by make_app.py", "Program"],
Cell["(DO) Runs", "Section"],
Cell["DO001 \:00b7 OCR trials on \:5929\:65b9\:81f3\:8056\:5be6\:9304 p. 10", "Subsection"],
Cell["[1] tesseract chi_tra psm 5: unusable\n[2] tesseract jpn_vert psm 5: ~55 %\n[3] cells -> one line, chi_tra psm 7: ~70 %\n[4] + ring punctuation removed: ~70 %\n[5] single cells psm 10: ~65 %\n[6] RapidOCR PP-OCRv3: ~80 %, simplified forms\nraw output: records/04_ocr_trials_v001.md", "Program"],
Cell["DO002 \:00b7 fold-label OCR (right margin) on 295 cleaned pages", "Subsection"],
Cell["[1\:2013295] no labels found: margin was trimmed away\nraw output: records/03_zh_juan_detection_ocr_v001.txt", "Program"],
Cell["DO003 \:00b7 first-column OCR on 295 pages to find juan headings", "Subsection"],
Cell["[1\:2013295] found \:5e8f p. 9, \:91cd\:5370\:5e8f p. 23, \:5377\:76ee p. 43, \:5377\:4e00\:2026\:5377\:5341 pp. 51, 77, 97, 109, 123, 145, 163, 197, 231, 257\nraw output: records/03_zh_juan_detection_ocr_v001.txt", "Program"],
Cell["DO004 \:00b7 Mason clear-text build (tools/make_mason_v001.py)", "Subsection"],
Cell["[1] 19 headings, false paragraph breaks\n[2] 23 headings after T001\:2013T002\n[3] front matter fixed (T003\:2013T007)\n[4] 295 page markers, gaps only at plate pages\n[5] PDF 338 pp.\n[6] PDF 278 pp. with Crimson Text (T010)\n[7] PDF 277 pp., 8.8 MB after T008\nraw output: texts/ArabianProphet_Mason1921_v001.md", "Program"],
Cell["DO005 \:00b7 spelling pass (tools/spellfix_mason_v001.py)", "Subsection"],
Cell["[1] 121 automatic fixes\n[2] 97 after review (T011)\nraw output: records/01_mason_spellfixes_v001.json", "Program"],
Cell["DO006 \:00b7 HanKitabKernel tests", "Subsection"],
Cell["[1] bad key refused\n[2] {15., 2}, chat_ready True\n[3] max_tokens 60: empty text\n[4] max_tokens 1500: correct answer\nraw output: records/05_kernel_tests_v001.md", "Program"],
Cell["DO007 \:00b7 app headless browser tests (Chrome, localhost)", "Subsection"],
Cell["[1] #library: renders, no console errors\n[2] #read/mason\n[3] #read/facs: viewer at \:5377\:4e00 p. 51\n[4] #downloads: 5 rows with sizes\n[5] #read/mason/par: English + page viewer\n[6] 390\:00d7844 mobile: facsimile readable\nraw output: records/06_app_screens_v001.png", "Program"],
Cell["DO009 \:00b7 HanKitabKernel v002 tests", "Subsection"],
Cell["[1] status without key: chat_ready True, open_chat True\n[2] wolfram 1+1 without key: refused\n[3] wolfram 1+1 with secret: 2\n[4] chat without key: answer received\nraw output: records/07_kernel_v002_tests_v001.md", "Program"],
Cell["DO010 \:00b7 live page test, v002 (GitHub Pages, built-in browser)", "Subsection"],
Cell["[1] status: Connected, no key box\n[2] Ask failed: null template -> T044\n[3] no passages -> T045\n[4] answer citing the report\n[5] Search Black Stone: 11\n[6] 7 downloads: 200\n[7] no Claude/Anthropic in the page\nraw output: records/08_live_v002_test_v001.md", "Program"],
Cell["DO011 \:00b7 own chat key", "Subsection"],
Cell["[1] HanKitab/apikey stored, owner-only\n[2] open chat answered using it\nraw output: records/09_own_chat_key_v001.md", "Program"],
Cell["DO012 \:00b7 kernel notebook tests (v003 cells, run in the local kernel)", "Subsection"],
Cell["[1] status\n[2] chat in Chinese\n[3] code with secret\nraw output: records/10_kernel_notebook_tests_v001.md", "Program"],
Cell["DO013 \:00b7 History tab and source labels", "Subsection"],
Cell["[1] headless: History renders sections 1, 2, 3, 7, 8 with contents\n[2] live: Ask on the Black Stone credits Mason's footnote\nraw output: records/11_history_tab_v001.png", "Program"],
Cell["DO014 \:00b7 gallery: Commons search and selection (run on the editor's local Wolfram kernel)", "Subsection"],
Cell["[1] 44 subjects searched, 39 images with open licences\n[2] contact sheet: 7 wrong or weak images found (plaque, map, stairs, dessert\:2026)\n[3] 16 alternative searches, 42 candidates, 14 chosen\n[4] 45 photographs in 4 categories; headless test of Library hero and Gallery\nraw output: gallery/CREDITS_v001.md, records/12_gallery_and_cover_v001.png", "Program"],
Cell["DO008 \:00b7 facsimile PDF build", "Subsection"],
Cell["[1] img2pdf from PNG: 297 pp., 18.0 MB\n[2] CCITT G4 TIFF: 297 pp., 10.7 MB\nraw output: texts/TianfangZhishengShilu_1924_facsimile_v001.pdf", "Program"],
Cell["Operations data as a Wolfram expression", "Section"],
Cell["opsT = {<|\"index\" -> \"T001\", \"file\" -> \"tools/make_mason_v001.py\", \"why\" -> \"OCR read IX as \\\"]X\\\" and XII as \\\"XH\\\"\"|>, <|\"index\" -> \"T002\", \"file\" -> \"tools/make_mason_v001.py\", \"why\" -> \"normalise chapter numerals\"|>, <|\"index\" -> \"T003\", \"file\" -> \"tools/make_mason_v001.py\", \"why\" -> \"headers such as \\\"ii FOREWORD\\\" were not recognised\"|>, <|\"index\" -> \"T004\", \"file\" -> \"tools/make_mason_v001.py\", \"why\" -> \"drop page-number lines; measure indent from the page base\"|>, <|\"index\" -> \"T005\", \"file\" -> \"tools/make_mason_v001.py\", \"why\" -> \"false paragraph breaks from ragged OCR layout\"|>, <|\"index\" -> \"T006\", \"file\" -> \"tools/make_mason_v001.py\", \"why\" -> \"roman page numbers glued to the next line\"|>, <|\"index\" -> \"T007\", \"file\" -> \"tools/make_mason_v001.py\", \"why\" -> \"OCR reads vii as \\\"yii\\\"; also re.I on the footer filter and whitespace-normalised headings\"|>, <|\"index\" -> \"T008\", \"file\" -> \"tools/make_mason_v001.py\", \"why\" -> \"drop the OCR copy of the title page (a new title page is set)\"|>, <|\"index\" -> \"T009\", \"file\" -> \"tools/make_mason_v001.py\", \"why\" -> \"an unreadable letter inside a word was being labelled [Chinese]\"|>, <|\"index\" -> \"T010\", \"file\" -> \"tools/mason_book_v001.css\", \"why\" -> \"Noto Serif not installed: CJK font gave full-width apostrophes\"|>, <|\"index\" -> \"T011\", \"file\" -> \"tools/spellfix_mason_v001.py\", \"why\" -> \"automatic choices that were wrong (liad->lead, tlien->lien, rnan->ran)\"|>, <|\"index\" -> \"T012\", \"file\" -> \"plates (rotation table)\", \"why\" -> \"three photographs came out upside down\"|>, <|\"index\" -> \"T013\", \"file\" -> \"plates\", \"why\" -> \"plate was sideways\"|>, <|\"index\" -> \"T014\", \"file\" -> \"plates\", \"why\" -> \"Black Stone crop included a line of text\"|>, <|\"index\" -> \"T015\", \"file\" -> \"tools/clean_zh_pages_v001.py\", \"why\" -> \"numpy integers are not JSON serialisable (also box values)\"|>, <|\"index\" -> \"T016\", \"file\" -> \"tools/zh_facsimile_front_v001.html\", \"why\" -> \"traditional form of the Justice Node seal\"|>, <|\"index\" -> \"T017\", \"file\" -> \"tools/zh_facsimile_front_v001.html\", \"why\" -> \"seal caption as on other CCN works\"|>, <|\"index\" -> \"T018\", \"file\" -> \"tools/app_template_v001.html\", \"why\" -> \"styles for the page viewer and downloads\"|>, <|\"index\" -> \"T019\", \"file\" -> \"tools/app_template_v001.html\", \"why\" -> \"Downloads tab (user request: originals for public download)\"|>, <|\"index\" -> \"T020\", \"file\" -> \"tools/app_template_v001.html\", \"why\" -> \"data blocks filled by make_app\"|>, <|\"index\" -> \"T021\", \"file\" -> \"tools/app_template_v001.html\", \"why\" -> \"Chinese facsimile as its own text\"|>, <|\"index\" -> \"T022\", \"file\" -> \"tools/app_template_v001.html\", \"why\" -> \"facsimile has no Markdown\"|>, <|\"index\" -> \"T023\", \"file\" -> \"tools/app_template_v001.html\", \"why\" -> \"render the facsimile\"|>, <|\"index\" -> \"T024\", \"file\" -> \"tools/app_template_v001.html\", \"why\" -> \"Chinese pane = page viewer at the matching juan\"|>, <|\"index\" -> \"T025\", \"file\" -> \"tools/app_template_v001.html\", \"why\" -> \"viewer and downloads code\"|>, <|\"index\" -> \"T026\", \"file\" -> \"tools/app_template_v001.html\", \"why\" -> \"EMAIL-CONTEXT rules\"|>, <|\"index\" -> \"T027\", \"file\" -> \"tools/app_template_v001.html\", \"why\" -> \"avoid loading 70 pages when the parallel view opens\"|>, <|\"index\" -> \"T028\", \"file\" -> \"tools/app_template_v001.html\", \"why\" -> \"sticky viewer inside the grid\"|>, <|\"index\" -> \"T029\", \"file\" -> \"tools/app_template_v001.html\", \"why\" -> \"#read/mason/par links (and headless test)\"|>, <|\"index\" -> \"T030\", \"file\" -> \"tools/app_template_v001.html\", \"why\" -> \"download links were underlined\"|>, <|\"index\" -> \"T031\", \"file\" -> \"tools/app_template_v001