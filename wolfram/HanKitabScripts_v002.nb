(* Content-type: application/vnd.wolfram.mathematica *)
(* \:00a9 Computational Classnotes \:00b7 CC BY-NC-SA 4.0 *)
Notebook[{
Cell["Han Kitab \:00b7 Scripts v002", "Title"],
Cell["Every script and template used to build this release, one cell each (Program style). The files themselves are in tools/ and wolfram/.", "Text"],
Cell["manifest.webmanifest", "Section"],
Cell["{\n  \"name\": \"Han Kitab \:00b7 \:6f22\:514b\:5854\:5e03\",\n  \"short_name\": \"Han Kitab\",\n  \"description\": \"Chinese Islamic classics: Liu Zhi's \:5929\:65b9\:81f3\:8056\:5be6\:9304 beside Mason's English, research and downloads. From Computational Classnotes.\",\n  \"id\": \"/han-kitab/\",\n  \"start_url\": \"./\",\n  \"scope\": \"./\",\n  \"display\": \"standalone\",\n  \"orientation\": \"any\",\n  \"background_color\": \"#F4F1EA\",\n  \"theme_color\": \"#1F5C4F\",\n  \"lang\": \"en\",\n  \"categories\": [\"education\", \"books\"],\n  \"icons\": [\n    { \"src\": \"icon-192.png\", \"sizes\": \"192x192\", \"type\": \"image/png\", \"purpose\": \"any\" },\n    { \"src\": \"icon-512.png\", \"sizes\": \"512x512\", \"type\": \"image/png\", \"purpose\": \"any\" },\n    { \"src\": \"icon-maskable-512.png\", \"sizes\": \"512x512\", \"type\": \"image/png\", \"purpose\": \"maskable\" }\n  ]\n}\n", "Program"],
Cell["sw.js", "Section"],
Cell["/* Han Kitab service worker: keeps the app working offline.\n   VERSION is set by tools/make_app.py from the app's content, so installed copies update by themselves.\n   \:00a9 Computational Classnotes \:00b7 CC BY-NC-SA 4.0 */\nconst VERSION = 'hankitab-2dcc6e29df';\nconst SHELL = ['./', './index.html', './manifest.webmanifest',\n  './icon-192.png', './icon-512.png', './icon-maskable-512.png', './apple-touch-icon.png', './favicon-32.png'];\n\nself.addEventListener('install', (e) => {\n  e.waitUntil(caches.open(VERSION).then((c) => c.addAll(SHELL)).then(() => self.skipWaiting()));\n});\nself.addEventListener('activate', (e) => {\n  e.waitUntil(caches.keys().then((keys) => Promise.all(keys.filter((k) => k !== VERSION).map((k) => caches.delete(k))))\n    .then(() => self.clients.claim()));\n});\nself.addEventListener('fetch', (e) => {\n  const req = e.request;\n  if (req.method !== 'GET') return;                       // HanKitabKernel calls are POSTs: never cached\n  const url = new URL(req.url);\n  if (req.mode === 'navigate') {                           // the app page: network first, cache when offline\n    e.respondWith(fetch(req).then((res) => { const copy = res.clone(); caches.open(VERSION).then((c) => c.put(req, copy)); return res; })\n      .catch(() => caches.match(req).then((hit) => hit || caches.match('./index.html'))));\n    return;\n  }\n  if (url.hostname === 'fonts.googleapis.com' || url.hostname === 'fonts.gstatic.com') {\n    e.respondWith(caches.open(VERSION).then((c) => c.match(req).then((hit) => {\n      const net = fetch(req).then((res) => { c.put(req, res.clone()); return res; }).catch(() => hit);\n      return hit || net;\n    })));\n    return;\n  }\n  if (url.origin === self.location.origin) {\n    // PDFs and original scans: straight from the network (too large to keep offline).\n    if (/\\.pdf$/i.test(url.pathname)) return;\n    // Pages, plates, text files: cache after the first view, so what you have read works offline.\n    e.respondWith(caches.open(VERSION).then((c) => c.match(req).then((hit) => hit || fetch(req).then((res) => {\n      if (res.ok) c.put(req, res.clone()); return res; }))));\n  }\n});\n", "Program"],
Cell["tools/app_template.html", "Section"],
Cell["<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<script>\n/* Hardwired CCN Cloud settings (same shape as Tutu Cat / Laplacian Lab). The key is typed on the page. */\nwindow.HANKITAB_CONFIG = window.HANKITAB_CONFIG || {\n  WOLFRAM_URL: \"https://www.wolframcloud.com/obj/ccn2/HanKitabKernel\"\n};\n/* Read-aloud voices. The first name found on the device wins. */\nwindow.HANKITAB_VOICE = window.HANKITAB_VOICE || {\n  RATE: 1.0,\n  EN: [\"Moira\", \"Microsoft Sonia\", \"Google UK English Female\", \"Daniel\", \"Samantha\", \"Microsoft Aria\", \"Google US English\"],\n  ZH: [\"Mei-Jia\", \"Ting-Ting\", \"Microsoft HsiaoChen\", \"Google \:570b\:8a9e\:ff08\:81fa\:7063\:ff09\", \"Google \:666e\:901a\:8bdd\:ff08\:4e2d\:56fd\:5927\:9646\:ff09\", \"Microsoft Xiaoxiao\"]\n};\n</script>\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Han Kitab \:00b7 \:6f22\:514b\:5854\:5e03</title>\n<link rel=\"manifest\" href=\"manifest.webmanifest\">\n<meta name=\"theme-color\" content=\"#1F5C4F\" media=\"(prefers-color-scheme: light)\">\n<meta name=\"theme-color\" content=\"#0F1715\" media=\"(prefers-color-scheme: dark)\">\n<meta name=\"description\" content=\"Han Kitab reader: Chinese Islamic classics, translations, research and an ask-the-texts guide. Computational Classnotes.\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"favicon-32.png\">\n<link rel=\"apple-touch-icon\" href=\"apple-touch-icon.png\">\n<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n<meta name=\"mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-title\" content=\"Han Kitab\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,600;1,400&family=Noto+Serif+TC:wght@400;600&family=Inter:wght@400;500;600&display=swap\">\n<style>\n:root{\n  --bg:#F4F1EA; --surface:#FFFDF8; --fg:#1E2421; --muted:#5E6A64; --line:#DDD6C8;\n  --accent:#1F5C4F; --accent2:#B0812F; --soft:#E7EFEB; --zh:\"Noto Serif TC\",\"Noto Serif CJK TC\",\"PingFang TC\",\"Songti TC\",serif;\n  --serif:\"Crimson Pro\",\"Noto Serif TC\",Georgia,serif; --sans:Inter,system-ui,-apple-system,\"Segoe UI\",sans-serif;\n  --fs:19px;\n}\n@media (prefers-color-scheme: dark){ :root{\n  --bg:#0F1715; --surface:#16201D; --fg:#E7ECE9; --muted:#9AA9A2; --line:#2A3833; --accent:#6FC2AC; --accent2:#E0B666; --soft:#1C2925; } }\n*{box-sizing:border-box}\nhtml,body{margin:0;background:var(--bg);color:var(--fg);font-family:var(--sans)}\nbody{padding:env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left)}\nheader.top{position:sticky;top:0;z-index:20;background:var(--accent);color:#fff;display:flex;align-items:center;gap:12px;padding:10px 16px;flex-wrap:wrap}\n@media (prefers-color-scheme: dark){ header.top{background:#12352D} }\n.brand{display:flex;align-items:center;gap:10px;font-weight:600;letter-spacing:.3px}\n.brand .seal{width:34px;height:34px;border-radius:7px;background:#fff;color:var(--accent);display:grid;place-items:center;font-family:var(--zh);font-weight:600;font-size:15px;line-height:1}\n@media (prefers-color-scheme: dark){ .brand .seal{background:#E7ECE9;color:#12352D} }\n.brand small{display:block;font-weight:400;opacity:.85;font-size:12px}\nnav.tabs{display:flex;gap:4px;margin-left:auto;flex-wrap:wrap}\nnav.tabs button{background:transparent;border:1px solid rgba(255,255,255,.35);color:#fff;padding:7px 13px;border-radius:999px;font:500 14px var(--sans);cursor:pointer}\nnav.tabs button[aria-selected=true]{background:#fff;color:var(--accent)}\nmain{max-width:1180px;margin:0 auto;padding:18px 16px 60px}\nsection.view{display:none} section.view.on{display:block}\n.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:18px}\n.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px}\n.book{cursor:pointer;transition:transform .15s}\n.book:hover{transform:translateY(-2px)}\n.book h3{margin:4px 0 6px;font-family:var(--serif);font-size:21px}\n.book .zh{font-family:var(--zh);color:var(--accent);font-size:17px}\n.book p{margin:6px 0;color:var(--muted);font-size:14px;line-height:1.45}\n.tag{display:inline-block;font-size:11px;padding:2px 8px;border-radius:999px;background:var(--soft);color:var(--accent);margin-right:4px}\n.tag.warn{background:#F6E7C9;color:#7A5416}\n@media (prefers-color-scheme: dark){ .tag.warn{background:#3A2F1A;color:#E0B666} }\nh1.page{font-family:var(--serif);font-weight:600;font-size:30px;margin:6px 0 4px}\np.lede{color:var(--muted);margin:0 0 16px;max-width:760px;line-height:1.5}\n.reader{display:grid;grid-template-columns:250px 1fr;gap:18px;align-items:start}\n.toc{position:sticky;top:70px;max-height:calc(100vh - 90px);overflow:auto;font-size:14px}\n.toc a{display:block;padding:5px 8px;border-radius:8px;color:var(--fg);text-decoration:none;line-height:1.3}\n.toc a:hover,.toc a.on{background:var(--soft);color:var(--accent)}\n.toolbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:12px}\n.toolbar button,.toolbar select,.btn{background:var(--surface);border:1px solid var(--line);color:var(--fg);padding:7px 12px;border-radius:10px;font:500 14px var(--sans);cursor:pointer}\n.btn{text-decoration:none;display:inline-block}\n.btn.primary{background:var(--accent);color:#fff;border-color:var(--accent)}\n.toolbar .seg{display:inline-flex;border:1px solid var(--line);border-radius:10px;overflow:hidden}\n.toolbar .seg button{border:0;border-radius:0}\n.toolbar .seg button[aria-pressed=true]{background:var(--accent);color:#fff}\narticle.text{font-family:var(--serif);font-size:var(--fs);line-height:1.62;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:22px 30px}\narticle.text h1,article.text h2,article.text h3{font-family:var(--serif);line-height:1.25}\narticle.text h2{font-size:1.45em;border-top:1px solid var(--line);padding-top:22px;margin-top:34px;scroll-margin-top:80px}\narticle.text h2:first-child{border-top:0;margin-top:0;padding-top:0}\narticle.text p{margin:.55em 0}\narticle.text table{border-collapse:collapse;width:100%;font-size:.8em;font-family:var(--sans);margin:12px 0;display:block;overflow-x:auto}\narticle.text td,article.text th{border:1px solid var(--line);padding:5px 8px;vertical-align:top}\narticle.text th{background:var(--soft)}\narticle.text .pg{font:500 11px var(--sans);color:var(--muted);background:var(--soft);padding:1px 5px;border-radius:5px;white-space:nowrap}\narticle.text .notes{font-size:.78em;line-height:1.45;color:var(--muted);border-left:3px solid var(--line);padding:4px 0 4px 12px;margin:6px 0 14px}\narticle.text .loc{font:11px var(--sans);color:var(--muted)}\narticle.text figure.plate{margin:20px auto;text-align:center}\narticle.text figure.plate img{max-width:100%;max-height:78vh;border-radius:6px;border:1px solid var(--line);background:#fff;cursor:zoom-in}\narticle.text figcaption{font-size:.82em;font-style:italic;color:var(--muted);margin-top:6px}\narticle.text .titlepage{text-align:center;padding:10px 0 20px}\narticle.text .titlepage h1{font-size:2em;margin:0}\narticle.text .ednote{font:14px/1.5 var(--sans);background:var(--soft);border-radius:10px;padding:10px 14px}\narticle.text .lines,article.text .dedication{text-align:center}\narticle.text .index{columns:2;font-size:.8em;line-height:1.4}\narticle.text mark{background:#F3DE9B;color:inherit;border-radius:3px}\n.zhcol{font-family:var(--zh);line-height:1.9}\n.par{display:grid;grid-template-columns:1fr 1fr;gap:20px}\n.par .zhpane{align-self:start;font-family:var(--zh);font-size:.95em;line-height:1.9;border-left:1px solid var(--line);padding-left:18px}\n.pending{color:var(--muted);font:14px/1.5 var(--sans);background:var(--soft);border-radius:10px;padding:10px 14px}\n.viewer{position:sticky;top:70px;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:10px}\n.viewer .vbar{display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-bottom:8px;font:13px var(--sans)}\n.viewer .vbar button,.viewer .vbar select{padding:5px 9px;border-radius:8px;border:1px solid var(--line);background:var(--bg);color:var(--fg);font:13px var(--sans);cursor:pointer}\n.viewer img{width:100%;height:auto;max-height:calc(100vh - 170px);object-fit:contain;background:#fff;border-radius:6px;cursor:zoom-in}\n.viewer .vnote{font:12px/1.4 var(--sans);color:var(--muted);margin-top:6px}\n@media (prefers-color-scheme: dark){ .viewer img{filter:invert(.88) hue-rotate(180deg)} }\n.dl{display:grid;grid-template-columns:1fr auto;gap:6px 14px;align-items:center;padding:10px 0;border-top:1px solid var(--line)}\n.dl:first-of-type{border-top:0} .dl .what b{font-family:var(--serif);font-size:18px} .dl .what div{font-size:13px;color:var(--muted)}\n.dl .get{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}\n/* hero + gallery */\n.hero{display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:22px;align-items:center;background:linear-gradient(135deg,var(--surface),var(--soft));border:1px solid var(--line);border-radius:18px;padding:22px 26px;margin-bottom:18px;overflow:hidden}\n.hero h1{font-family:var(--serif);font-size:38px;margin:0 0 4px;line-height:1.1}\n.hero .zhbig{font-family:var(--zh);font-size:22px;color:var(--accent);letter-spacing:.2em;margin-bottom:10px}\n.hero p{color:var(--muted);line-height:1.55;margin:6px 0;max-width:640px}\n.hero figure{margin:0}\n.hero figure img{width:100%;border-radius:6px;box-shadow:0 10px 30px rgba(0,0,0,.18);display:block}\n.hero figcaption{font-size:11px;color:var(--muted);margin-top:8px;line-height:1.35}\n.hero figcaption a{color:var(--accent)}\n.ghead{position:relative;border-radius:18px;overflow:hidden;margin-bottom:16px;min-height:220px;display:flex;align-items:flex-end;background:#1F5C4F}\n.ghead img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.55}\n.ghead .gt{position:relative;padding:22px 26px;color:#fff;text-shadow:0 2px 12px rgba(0,0,0,.5)}\n.ghead h1{font-family:var(--serif);font-size:36px;margin:0}\n.ghead p{margin:6px 0 0;max-width:720px;line-height:1.5;opacity:.95}\n.chips{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 14px}\n.chips button{border:1px solid var(--line);background:var(--surface);color:var(--fg);padding:7px 14px;border-radius:999px;font:500 14px var(--sans);cursor:pointer}\n.chips button[aria-pressed=true]{background:var(--accent);color:#fff;border-color:var(--accent)}\n.masonry{columns:4 260px;column-gap:14px}\n.tile{break-inside:avoid;margin:0 0 14px;border-radius:14px;overflow:hidden;background:var(--surface);border:1px solid var(--line);cursor:zoom-in;transition:transform .2s,box-shadow .2s;position:relative}\n.tile:hover{transform:translateY(-3px);box-shadow:0 10px 24px rgba(0,0,0,.12)}\n.tile img{width:100%;display:block;background:var(--soft)}\n.tile .cap{padding:9px 12px 11px}\n.tile .cap b{font-family:var(--serif);font-size:17px;display:block;line-height:1.2}\n.tile .cap .zh{font-family:var(--zh);color:var(--accent);font-size:14px}\n.tile .cap .pl{font-size:12px;color:var(--muted)}\n.tile .badge{position:absolute;top:10px;left:10px;background:rgba(0,0,0,.55);color:#fff;font:600 11px var(--sans);padding:3px 8px;border-radius:999px;letter-spacing:.3px}\n.glb{position:fixed;inset:0;background:rgba(10,14,13,.94);z-index:60;display:none;grid-template-rows:1fr auto;color:#eee}\n.glb.on{display:grid}\n.glb .stage{display:flex;align-items:center;justify-content:center;padding:16px 60px 0;min-height:0}\n.glb .stage img{max-width:100%;max-height:calc(100vh - 190px);border-radius:6px;box-shadow:0 10px 40px rgba(0,0,0,.6)}\n.glb .info{padding:14px 24px 20px;max-width:980px;margin:0 auto;line-height:1.5}\n.glb .info b{font-family:var(--serif);font-size:22px}\n.glb .info .zh{font-family:var(--zh);color:#9fe0cc;margin-left:8px}\n.glb .info .credit{font-size:12px;color:#aab}\n.glb .info a{color:#9fe0cc}\n.glb .nav{position:absolute;top:50%;transform:translateY(-50%);background:rgba(255,255,255,.12);border:0;color:#fff;font-size:28px;width:46px;height:64px;border-radius:10px;cursor:pointer}\n.glb .prev{left:10px}.glb .next{right:10px}\n.glb .close{position:absolute;top:12px;right:14px;background:rgba(255,255,255,.12);border:0;color:#fff;font-size:20px;width:40px;height:40px;border-radius:50%;cursor:pointer}\n@media (max-width:820px){.hero{grid-template-columns:1fr}.hero figure{max-width:220px;margin:auto}.glb .stage{padding:10px 8px 0}.glb .nav{display:none}}\n.lightbox{position:fixed;inset:0;background:rgba(0,0,0,.85);display:none;place-items:center;z-index:50;cursor:zoom-out}\n.lightbox.on{display:grid} .lightbox img{max-width:96vw;max-height:94vh;background:#fff}\n/* search */\n.searchbar{display:flex;gap:8px;margin:0 0 14px}\n.searchbar input{flex:1;padding:11px 14px;border-radius:12px;border:1px solid var(--line);background:var(--surface);color:var(--fg);font:16px var(--sans)}\n.hit{border-top:1px solid var(--line);padding:10px 2px;cursor:pointer}\n.hit b{color:var(--accent)} .hit .src{font-size:12px;color:var(--muted)}\n/* ask */\n.chat{display:flex;flex-direction:column;gap:10px;min-height:280px;max-height:62vh;overflow:auto;padding:4px}\n.msg{max-width:84%;padding:10px 14px;border-radius:14px;line-height:1.5;white-space:pre-wrap;font-size:15px}\n.msg.me{align-self:flex-end;background:var(--accent);color:#fff;border-bottom-right-radius:4px}\n.msg.bot{align-self:flex-start;background:var(--soft);border-bottom-left-radius:4px}\n.msg.wait{opacity:.7;font-style:italic}\n.askrow{display:flex;gap:8px;margin-top:12px}\n.askrow input{flex:1;padding:11px 14px;border-radius:12px;border:1px solid var(--line);background:var(--surface);color:var(--fg);font:16px var(--sans)}\n.keyrow{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:10px;font-size:14px;color:var(--muted)}\n.keyrow input{padding:8px 10px;border-radius:10px;border:1px solid var(--line);background:var(--surface);color:var(--fg);min-width:220px}\nfooter.ccn{max-width:1180px;margin:0 auto;padding:16px;color:var(--muted);font-size:12.5px;text-align:center}\n#installBtn{background:var(--accent);color:#fff;border-color:var(--accent);font-weight:600}\n#installBtn[hidden]{display:none}\n#installMsg{position:fixed;left:50%;bottom:22px;transform:translateX(-50%);max-width:min(560px,92vw);background:var(--fg);color:var(--bg);font-family:var(--sans);font-size:.85em;line-height:1.45;padding:12px 16px;border-radius:12px;box-shadow:0 8px 28px rgba(0,0,0,.25);z-index:60;cursor:pointer}\n#installMsg[hidden]{display:none}\n@media (max-width:820px){\n  .reader{grid-template-columns:1fr}\n  .toc{position:static;max-height:220px}\n  article.text{padding:16px 16px;--fs:17px}\n  .par{grid-template-columns:1fr} .par .zhpane{border-left:0;padding-left:0;border-top:1px solid var(--line);padding-top:10px}\n  nav.tabs{margin-left:0}\n}\n@media print{ header.top,nav,.toc,.toolbar,footer.ccn{display:none} article.text{border:0} }\n.editorial{max-width:820px;font-family:var(--serif);font-size:1.02em;line-height:1.55;border-left:3px solid var(--accent2);padding:2px 0 2px 18px;margin:6px 0 4px}\n.editorial p{margin:.5em 0}\n.news{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:18px 20px;margin:22px 0 6px}\n.news .nhead{display:flex;flex-wrap:wrap;align-items:baseline;gap:10px 16px;justify-content:space-between}\n.news h2{margin:0;font-family:var(--serif);font-size:1.35em}\n.news h2 .zh{font-family:var(--zh);color:var(--accent2);font-weight:600;margin-left:.35em}\n.news .seg{display:inline-flex;border:1px solid var(--line);border-radius:10px;overflow:hidden}\n.news .seg button{border:0;border-radius:0;background:transparent;color:var(--fg);padding:6px 12px;cursor:pointer;font:inherit;font-size:.82em}\n.news .seg button[aria-pressed=true]{background:var(--accent);color:#fff}\n.news ul{list-style:none;margin:12px 0 0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:4px 22px}\n.news li{padding:9px 0;border-top:1px solid var(--line)}\n.news li a{color:var(--fg);text-decoration:none;font-family:var(--serif);font-size:1.02em;line-height:1.3}\n.news li a:hover{color:var(--accent);text-decoration:underline}\n.news li.zh a{font-family:var(--zh)}\n.news .meta{font-family:var(--sans);font-size:.74em;color:var(--muted);margin-top:3px}\n.news .meta .new{color:var(--accent2);font-weight:600;margin-right:6px}\n.news .foot{font-family:var(--sans);font-size:.74em;color:var(--muted);margin-top:10px}\n</style>\n</head>\n<body>\n<header class=\"top\">\n  <div class=\"brand\"><div class=\"seal\" aria-hidden=\"true\">\:6f22\:7d93</div><div>Han Kitab \:00b7 \:6f22\:514b\:5854\:5e03<small>Chinese Islamic classics \:00b7 Computational Classnotes</small></div></div>\n  <nav class=\"tabs\" role=\"tablist\">\n    <button role=\"tab\" data-v=\"library\" aria-selected=\"true\">Library</button>\n    <button role=\"tab\" data-v=\"read\" aria-selected=\"false\">Read</button>\n    <button role=\"tab\" data-v=\"history\" aria-selected=\"false\">History</button>\n    <button role=\"tab\" data-v=\"gallery\" aria-selected=\"false\">Gallery</button>\n    <button role=\"tab\" data-v=\"news\" aria-selected=\"false\">News</button>\n    <button role=\"tab\" data-v=\"search\" aria-selected=\"false\">Search</button>\n    <button role=\"tab\" data-v=\"ask\" aria-selected=\"false\">Ask</button>\n    <button role=\"tab\" data-v=\"downloads\" aria-selected=\"false\">Downloads</button>\n    <button role=\"tab\" data-v=\"about\" aria-selected=\"false\">About</button>\n    <button id=\"installBtn\" class=\"btn\" type=\"button\" title=\"Install Han Kitab as an app\">Install app</button>\n  </nav>\n</header>\n\n<main>\n  <!-- LIBRARY -->\n  <section class=\"view on\" id=\"v-library\">\n    <div class=\"hero\">\n      <div>\n        <div class=\"zhbig\">\:6f22\:514b\:5854\:5e03</div>\n        <h1>Han Kitab</h1>\n        <p>Islamic books written in Classical Chinese by Chinese Muslims, from Wang Daiyu\:2019s <i>Zhengjiao zhenquan</i> (1642) to the late Qing: Islam explained in the language of the Confucian classics.</p>\n        <p>Read Liu Zhi\:2019s life of the Prophet in Chinese beside Isaac Mason\:2019s English, follow the history, browse the gallery of China\:2019s mosques and Muslim quarters, and download every text.</p>\n      </div>\n      <figure><a href=\"img/cover_TianfangZhengxue_1861.jpg\" id=\"coverLink\" title=\"View the full-size image\"><img src=\"img/cover_TianfangZhengxue_1861.jpg\" alt=\"Page of \:5929\:65b9\:6b63\:5b78 with the basmala and the alif figure\" style=\"cursor:zoom-in\"></a>\n        <figcaption>\:5929\:65b9\:5b57\:6bcd\:723e\:7acb\:752b\:7acb\:5716, the letter alif as the human form. Lan Zixi \:85cd\:7166, <i>Tianfang zhengxue</i> \:5929\:65b9\:6b63\:5b78 (1861). The University of Manchester Library, Chinese Crawford 326, CC BY-NC-SA 4.0.\n        <br><a href=\"img/cover_TianfangZhengxue_1861.jpg\" target=\"_blank\" rel=\"noopener\">Full size</a> \:00b7 <a href=\"img/cover_TianfangZhengxue_1861_original.jpg\" target=\"_blank\" rel=\"noopener\">original photograph with colour chart</a></figcaption></figure>\n    </div>\n    <h1 class=\"page\">Library</h1>\n    <div class=\"grid\" id=\"books\"></div>\n  </section>\n\n  <!-- READ -->\n  <section class=\"view\" id=\"v-read\">\n    <div class=\"reader\">\n      <nav class=\"toc card\" id=\"toc\" aria-label=\"Contents\"></nav>\n      <div>\n        <div class=\"toolbar\">\n          <select id=\"docSel\" aria-label=\"Choose text\"></select>\n          <span class=\"seg\" id=\"langSeg\" title=\"Language\">\n            <button data-l=\"en\" aria-pressed=\"true\">English</button>\n            <button data-l=\"par\" aria-pressed=\"false\">English + \:4e2d\:6587</button>\n            <button data-l=\"zh\" aria-pressed=\"false\">\:4e2d\:6587</button>\n          </span>\n          <button id=\"smaller\" title=\"Smaller text\">A\:2212</button>\n          <button id=\"larger\" title=\"Larger text\">A+</button>\n          <button id=\"readBtn\" title=\"Read the current section aloud\">\:25b6 Read aloud</button>\n          <button id=\"stopBtn\" title=\"Stop reading\" disabled>\:25a0 Stop</button>\n          <a class=\"btn\" id=\"pdfLink\" href=\"#\" download>PDF</a>\n          <a class=\"btn\" id=\"mdLink\" href=\"#\" download>Markdown</a>\n        </div>\n        <article class=\"text\" id=\"doc\"></article>\n      </div>\n    </div>\n  </section>\n\n  <!-- HISTORY -->\n  <section class=\"view\" id=\"v-history\">\n    <h1 class=\"page\">History of the Han Kitab</h1>\n    <p class=\"lede\">From the first Muslims in Tang China to the Han Kitab books (1642 onwards) and the Sinification of Islam today. From the Computational Classnotes research report (v001, November 2026); the full report, with the catalogue of publications, glossary and sources, is in the Library.</p>\n    <div class=\"reader\">\n      <nav class=\"toc card\" id=\"htoc\" aria-label=\"History contents\"></nav>\n      <article class=\"text\" id=\"hist\"></article>\n    </div>\n  </section>\n\n  <!-- NEWS -->\n  <section class=\"view\" id=\"v-news\">\n    <h1 class=\"page\">News \:00b7 \:4e2d\:570b\:7a46\:65af\:6797\:65b0\:805e</h1>\n    <div class=\"editorial\">\n      <p>This page is about Chinese Muslims: the Hui, the Uyghurs and the other Muslim peoples of China, their mosques, communities, festivals and food, and Chinese Muslims living abroad. It carries on, in today\:2019s news, the story that the Han Kitab began: Muslims living and writing as Chinese.</p>\n      <p>The headlines are gathered once a week, only from news outlets in China, elsewhere in Asia and in the Middle East. Chinese-language stories come mostly from Chinese state media; the English-language outlets of Asia and the Middle East often report the same subjects very differently. Each headline links to the original story, and the views in it are the outlet\:2019s own, not those of Computational Classnotes. Reading the tabs side by side gives the fullest picture.</p>\n    </div>\n    <section class=\"news\" id=\"news\" aria-label=\"News\">\n      <div class=\"nhead\">\n        <h2>Headlines<span class=\"zh\">\:672c\:9031\:65b0\:805e</span></h2>\n        <span class=\"seg\" id=\"newsSeg\">\n          <button data-s=\"zh\" aria-pressed=\"true\">\:4e2d\:6587</button>\n          <button data-s=\"china\" aria-pressed=\"false\">China</button>\n          <button data-s=\"mideast\" aria-pressed=\"false\">Middle East</button>\n          <button data-s=\"asia\" aria-pressed=\"false\">Asia</button>\n        </span>\n      </div>\n      <ul id=\"newsList\"><li class=\"meta\">Loading this week\:2019s headlines\:2026</li></ul>\n      <div class=\"foot\" id=\"newsFoot\">Updated weekly. Headlines from Chinese, Asian and Middle Eastern news outlets; each link opens the original story.</div>\n    </section>\n  </section>\n\n  <!-- GALLERY -->\n  <section class=\"view\" id=\"v-gallery\">\n    <div class=\"ghead\"><img id=\"gheadImg\" alt=\"\"><div class=\"gt\"><h1>Gallery \:00b7 \:6e05\:771f\:5bfa\:8207\:56de\:574a</h1>\n      <p>Mosques across China, from Tang-era foundations on the coast to the Ming temple-mosques of the interior and the brick minarets of Xinjiang, with the Muslim quarters, markets and food around them. Many mosques have been rebuilt or altered since these photographs were taken.</p></div></div>\n    <div class=\"chips\" id=\"gchips\"></div>\n    <div class=\"masonry\" id=\"gal\"></div>\n    <p class=\"lede\" style=\"font-size:13px;margin-top:10px\">Photographs from Wikimedia Commons, each under its own licence (shown with the photo). Captions \:00a9 Computational Classnotes \:00b7 CC BY-NC-SA 4.0.</p>\n  </section>\n\n  <!-- SEARCH -->\n  <section class=\"view\" id=\"v-search\">\n    <h1 class=\"page\">Search</h1>\n    <p class=\"lede\">Search every text in the app at once, in English or Chinese. Works offline.</p>\n    <form class=\"searchbar\" id=\"sForm\"><input id=\"sIn\" placeholder=\"e.g. Black Stone, Liu Zhi, \:6e05\:771f, Medina\" autocomplete=\"off\"><button class=\"btn primary\">Search</button></form>\n    <div class=\"card\" id=\"sOut\"><span class=\"pending\">Type a word or phrase.</span></div>\n  </section>\n\n  <!-- ASK -->\n  <section class=\"view\" id=\"v-ask\">\n    <h1 class=\"page\">Ask the texts</h1>\n    <p class=\"lede\">Ask a question about the Han Kitab. Answers come through HanKitabKernel, which is given the passages from these texts most relevant to your question. When you are offline, you get the matching passages themselves.</p>\n    <div class=\"card\">\n      <div class=\"keyrow\"><span id=\"ccnState\">Connecting to CCN Cloud\:2026</span></div>\n      <div class=\"chat\" id=\"log\"></div>\n      <form class=\"askrow\" id=\"askForm\"><input id=\"askIn\" placeholder=\"e.g. Who was Liu Zhi? What does Mason say about the Black Stone?\" autocomplete=\"off\"><button class=\"btn primary\" id=\"sendBtn\">Ask</button></form>\n    </div>\n  </section>\n\n  <!-- DOWNLOADS -->\n  <section class=\"view\" id=\"v-downloads\">\n    <h1 class=\"page\">Downloads</h1>\n    <p class=\"lede\">Every file is free to download. The original scans are kept exactly as they were published; the clear-text and facsimile editions are made from them.</p>\n    <div class=\"card\" id=\"dlList\"></div>\n  </section>\n\n  <!-- ABOUT -->\n  <section class=\"view\" id=\"v-about\">\n    <h1 class=\"page\">About</h1>\n    <div class=\"card\" style=\"line-height:1.6;max-width:820px\">\n      <p><b>Han Kitab \:00b7 \:6f22\:514b\:5854\:5e03</b> is a reader for Chinese Islamic classics and their translations, made by Computational Classnotes.</p>\n      <ul>\n        <li><b>Texts:</b> the 1921 text of Mason's <i>The Arabian Prophet</i> is in the public domain; this clear-text edition and the research report are \:00a9 Computational Classnotes \:00b7 CC BY-NC-SA 4.0.</li>\n        <li><b>Chinese originals:</b> added as clear text when made from public-domain scans. Machine-read Chinese is marked as such until it has been proofread.</li>\n        <li><b>Offline:</b> once opened, the app and its texts work without a connection. Ask needs one, unless it is answering from the texts.</li>\n      </ul>\n      <p>Production: Principal Investigator Lucval \:00b7 Editors Dara, Lucia \:00b7 Software FreeFormer \:00b7 Agent Kirari-chan (\:30ad\:30e9\:30ea\:3061\:3083\:3093). Programming: Hikari Noor Hoshino (\:661f\:91ce\:30cc\:30fc\:30eb).</p>\n      <p>Ask needs no key: anyone may ask. Answers are limited in length.</p>\n      <p>Source and files: <a href=\"https://github.com/lossofgenerality/han-kitab\">github.com/lossofgenerality/han-kitab</a></p>\n    </div>\n  </section>\n</main>\n<div id=\"installMsg\" role=\"status\" hidden></div>\n<footer class=\"ccn\">\:00a9 Computational Classnotes \:00b7 CC BY-NC-SA 4.0 \:00b7 <a href=\"https://justice.compclassnotes.com/\" style=\"color:inherit\">Justice Node</a> \:00b7 <a href=\"https://discuss.compclassnotes.com/\" style=\"color:inherit\">CCN Node</a></footer>\n<div class=\"lightbox\" id=\"lb\"><img alt=\"\"></div>\n<div class=\"glb\" id=\"glb\" role=\"dialog\" aria-modal=\"true\"><div class=\"stage\"><img alt=\"\"></div><div class=\"info\"></div>\n  <button class=\"nav prev\" aria-label=\"Previous\">\:2039</button><button class=\"nav next\" aria-label=\"Next\">\:203a</button><button class=\"close\" aria-label=\"Close\">\:2715</button></div>\n\n<!-- ===== CONTENT (generated by tools/make_app_v001.py) ===== -->\n<template id=\"doc-mason\">__MASON__</template>\n<template id=\"doc-report\">__REPORT__</template>\n<script id=\"zh-data\" type=\"application/json\">__ZHDATA__</script>\n<script id=\"dl-data\" type=\"application/json\">__DLDATA__</script>\n<script id=\"facs-data\" type=\"application/json\">__FACSDATA__</script>\n<script id=\"gal-data\" type=\"application/json\">__GALDATA__</script>\n\n<script>\n(() => {\n  const $ = (s, r = document) => r.querySelector(s), $$ = (s, r = document) => [...r.querySelectorAll(s)];\n\n  /* ---------- catalogue ---------- */\n  const ZH = JSON.parse(document.getElementById('zh-data').textContent || '{}');\n  const FACS = JSON.parse(document.getElementById('facs-data').textContent || '{}');\n  const DLS = JSON.parse(document.getElementById('dl-data').textContent || '[]');\n  const DOCS = [\n    { id: 'mason', tpl: 'doc-mason', title: 'The Arabian Prophet', zh: '\:5929\:65b9\:81f3\:8056\:5be6\:9304', by: 'Liu Zhi \:5289\:667a \:00b7 trans. Isaac Mason (1921)',\n      blurb: 'The first English version of Liu Zhi\:2019s life of the Prophet (completed 1724), with Mason\:2019s appendices on Chinese Islam and all twenty original illustrations. Choose \:201cEnglish + \:4e2d\:6587\:201d to read it beside the Chinese pages.',\n      tags: ['English', '1921 \:00b7 public domain', 'beside the Chinese pages'],\n      pdf: 'texts/ArabianProphet_Mason1921_v001.pdf', md: 'texts/ArabianProphet_Mason1921_v001.md',\n      source: 'Isaac Mason, The Arabian Prophet (Shanghai, 1921): his English translation of Liu Zhi\:2019s \:5929\:65b9\:81f3\:8056\:5be6\:9304 (1724). The footnotes, preface and appendices are Mason\:2019s own; the main text is Liu Zhi\:2019s in Mason\:2019s translation.' },\n    { id: 'facs', facs: true, title: 'Tianfang zhisheng shilu (1924)', zh: '\:5929\:65b9\:81f3\:8056\:5be6\:9304', by: 'Liu Zhi \:5289\:667a \:00b7 prefaces and juan 1\:201310 \:00b7 facsimile',\n      blurb: 'The Chinese original, page by page as printed in 1924: every page reproduced unchanged, with a contents list by juan.',\n      tags: ['\:4e2d\:6587', 'original pages, unchanged', '297 pages'],\n      pdf: 'texts/TianfangZhishengShilu_1924_facsimile_v001.pdf', md: null },\n    { id: 'report', tpl: 'doc-report', title: 'Han Kitab: research report', zh: '\:6f22\:514b\:5854\:5e03\:7814\:7a76', by: 'Computational Classnotes \:00b7 v001 (2026)',\n      blurb: 'What the Han Kitab is, a catalogue of the publications, Chinese passages beside English, and a history of Sinification from 1642 to today.',\n      tags: ['English + \:4e2d\:6587 passages', 'Research'],\n      pdf: 'docs/HanKitab_Research_v001.pdf', md: 'docs/HanKitab_Research_v001.md',\n      source: 'Computational Classnotes, Han Kitab research report v001 (November 2026).' }\n  ];\n  const books = $('#books'), docSel = $('#docSel');\n  DOCS.forEach((d) => {\n    const c = document.createElement('div'); c.className = 'card book'; c.tabIndex = 0;\n    c.innerHTML = `<div class=\"zh\">${d.zh}</div><h3>${d.title}</h3><p>${d.by}</p><p>${d.blurb}</p>` +\n      d.tags.map((t) => `<span class=\"tag${/coming/.test(t) ? ' warn' : ''}\">${t}</span>`).join('');\n    c.onclick = c.onkeydown = (e) => { if (e.type === 'click' || e.key === 'Enter') openDoc(d.id); };\n    books.appendChild(c);\n    const o = document.createElement('option'); o.value = d.id; o.textContent = d.title; docSel.appendChild(o);\n  });\n\n  /* ---------- tabs ---------- */\n  function show(v) {\n    $$('nav.tabs [role=tab]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.v === v)));\n    $$('section.view').forEach((s) => s.classList.toggle('on', s.id === 'v-' + v));\n    if (v === 'read' && !current) openDoc('mason', true);\n    if (v === 'history') renderHistory();\n    if (v === 'gallery') renderGallery();\n    try { history.replaceState(null, '', '#' + v + (v === 'read' && current ? '/' + current : '')); } catch (e) {}\n  }\n  $$('nav.tabs [role=tab]').forEach((b) => b.onclick = () => show(b.dataset.v));\n\n  /* ---------- reader ---------- */\n  const docEl = $('#doc'), tocEl = $('#toc');\n  let current = null, lang = 'en';\n  try { lang = localStorage.getItem('hk.lang') || 'en'; } catch (e) {}\n  let fs = 19; try { fs = +localStorage.getItem('hk.fs') || 19; } catch (e) {}\n  document.documentElement.style.setProperty('--fs', fs + 'px');\n\n  function sectionsOf(root) {   // split an article into sections at each h2\n    const out = []; let cur = null;\n    [...root.childNodes].forEach((n) => {\n      if (n.nodeType === 1 && n.tagName === 'H2') { cur = { id: n.id, title: n.textContent.replace(/\\s+/g, ' ').trim(), nodes: [n] }; out.push(cur); }\n      else { if (!cur) { cur = { id: 'top', title: 'Title', nodes: [] }; out.push(cur); } cur.nodes.push(n); }\n    });\n    return out;\n  }\n  function openDoc(id, quiet) {\n    const d = DOCS.find((x) => x.id === id); if (!d) return;\n    current = id; docSel.value = id;\n    $('#pdfLink').href = d.pdf; $('#mdLink').href = d.md || '#'; $('#mdLink').style.display = d.md ? '' : 'none';\n    $('#langSeg').style.display = d.id === 'mason' ? '' : 'none';\n    render();\n    if (!quiet) show('read');\n    window.scrollTo(0, 0);\n  }\n  function render() {\n    const d = DOCS.find((x) => x.id === current);\n    if (d.facs) { renderFacs(); return; }\n    const frag = document.getElementById(d.tpl).content.cloneNode(true);\n    const holder = document.createElement('div'); holder.appendChild(frag);\n    const secs = sectionsOf(holder);\n    const zh = (ZH[current] && ZH[current].sections) || {};\n    docEl.innerHTML = '';\n    tocEl.innerHTML = '<div style=\"font:600 12px var(--sans);color:var(--muted);padding:4px 8px\">CONTENTS</div>';\n    secs.forEach((s) => {\n      const wrap = document.createElement('div'); wrap.className = 'sec'; wrap.dataset.sec = s.id;\n      const en = document.createElement('div'); s.nodes.forEach((n) => en.appendChild(n));\n      const z = zh[s.id];\n      if (lang === 'en' || !Object.keys(zh).length && current !== 'mason') { wrap.appendChild(en); }\n      else if (lang === 'zh') {\n        const h = en.querySelector('h2'); if (h) wrap.appendChild(h.cloneNode(true));\n        wrap.appendChild(zhBlock(z, s));\n      } else {\n        const h = en.querySelector('h2'); if (h) { wrap.appendChild(h); }\n        const grid = document.createElement('div'); grid.className = 'par';\n        const zp = zhBlock(z, s); zp.classList.add('zhpane');\n        grid.appendChild(en); grid.appendChild(zp); wrap.appendChild(grid);\n      }\n      docEl.appendChild(wrap);\n      if (s.id !== 'top') { const a = document.createElement('a'); a.href = '#'; a.textContent = s.title; a.onclick = (e) => { e.preventDefault(); wrap.scrollIntoView({ behavior: 'smooth' }); }; tocEl.appendChild(a); }\n    });\n    $$('#langSeg button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.l === lang)));\n    $$('img', docEl).forEach((im) => { im.loading = 'lazy'; im.onclick = () => { const lb = $('#lb'); lb.firstElementChild.src = im.src; lb.classList.add('on'); }; });\n  }\n  function zhBlock(z, s) {\n    if (current === 'mason' && FACS.pages) {\n      const start = (FACS.mason_map || {})[s.id];\n      const v = makeViewer(start || FACS.juan[0].page, start ? null : 'This part of Mason\:2019s book is not in juan 1\:201310 (the scan covers the first half of the work). Browse the pages with the contents list.');\n      return v;\n    }\n    const div = document.createElement('div'); div.className = 'zhcol';\n    if (z && z.text) {\n      if (z.note) { const n = document.createElement('div'); n.className = 'pending'; n.textContent = z.note; div.appendChild(n); }\n      z.text.split(/\\n{2,}/).forEach((p) => { const e = document.createElement('p'); e.textContent = p; div.appendChild(e); });\n    } else {\n      const n = document.createElement('div'); n.className = 'pending';\n      n.textContent = current === 'mason'\n        ? '\:4e2d\:6587\:539f\:6587\:5f85\:88dc \:00b7 The Chinese text of this section has not been added yet. It will come from the public-domain scan of \:5929\:65b9\:81f3\:8056\:5be6\:9304 (1924 printing, juan 1\:201310).'\n        : 'No separate Chinese text for this section.';\n      div.appendChild(n);\n    }\n    return div;\n  }\n  /* ---------- page viewer for the Chinese facsimile ---------- */\n  const pageSrc = (n) => FACS.dir + '/page_' + String(n).padStart(3, '0') + '.png';\n  function juanOf(n) { let j = FACS.juan[0]; for (const x of FACS.juan) if (x.page <= n) j = x; return j; }\n  function makeViewer(start, note) {\n    const v = document.createElement('div'); v.className = 'viewer';\n    let n = start;\n    v.innerHTML = `<div class=\"vbar\"><button data-a=\"-1\" title=\"Previous page\">\:25c0</button><button data-a=\"1\" title=\"Next page\">\:25b6</button>\n      <select aria-label=\"Juan\">${FACS.juan.map((j) => `<option value=\"${j.page}\">${j.label}</option>`).join('')}</select>\n      <span class=\"pno\"></span></div><img alt=\"Page of \:5929\:65b9\:81f3\:8056\:5be6\:9304\"><div class=\"vnote\"></div>`;\n    const img = v.querySelector('img'), sel = v.querySelector('select'), pno = v.querySelector('.pno'), vn = v.querySelector('.vnote');\n    function go(k) {\n      n = Math.max(1, Math.min(FACS.pages, k)); img.src = pageSrc(n); pno.textContent = `p. ${n} / ${FACS.pages}`; sel.value = String(juanOf(n).page);\n      if (touched) [n + 1, n - 1].forEach((m) => { if (m >= 1 && m <= FACS.pages) { const i = new Image(); i.src = pageSrc(m); } });\n    }\n    let touched = false; img.loading = 'lazy';\n    v.querySelectorAll('button[data-a]').forEach((b) => b.onclick = () => { touched = true; go(n + +b.dataset.a); });\n    sel.onchange = () => { touched = true; go(+sel.value); };\n    img.onclick = () => { const lb = $('#lb'); lb.firstElementChild.src = img.src; lb.classList.add('on'); };\n    vn.textContent = (note ? note + ' ' : '') + (FACS.note || '');\n    go(n);\n    return v;\n  }\n  function renderFacs() {\n    docEl.innerHTML = '';\n    tocEl.innerHTML = '<div style=\"font:600 12px var(--sans);color:var(--muted);padding:4px 8px\">\:5377\:76ee \:00b7 CONTENTS</div>';\n    const head = document.createElement('div');\n    head.innerHTML = `<h2 style=\"border:0;margin-top:0;padding-top:0\">\:5929\:65b9\:81f3\:8056\:5be6\:9304 <span style=\"font-size:.6em;color:var(--muted)\">Tianfang zhisheng shilu, 1924 printing</span></h2>\n      <p style=\"font:14px/1.5 var(--sans);color:var(--muted)\">Original pages, unchanged. Use \:25c0 \:25b6 or the arrow keys to turn pages; tap a page to enlarge it. The book reads from the right column to the left.</p>`;\n    docEl.appendChild(head);\n    const v = makeViewer(FACS.juan.find((j) => j.label.startsWith('\:5377\:4e00')).page); docEl.appendChild(v);\n    v.querySelector('img').style.maxHeight = 'none';\n    FACS.juan.forEach((j) => { const a = document.createElement('a'); a.href = '#'; a.textContent = j.label; a.onclick = (e) => { e.preventDefault(); v.querySelector('select').value = j.page; v.querySelector('select').onchange(); }; tocEl.appendChild(a); });\n  }\n  document.addEventListener('keydown', (e) => {\n    if (!$('#v-read').classList.contains('on') || /INPUT|SELECT|TEXTAREA/.test(document.activeElement.tagName)) return;\n    const v = $('.viewer', docEl); if (!v || current !== 'facs') return;\n    if (e.key === 'ArrowLeft') v.querySelector('[data-a=\"1\"]').click();   // Chinese books advance to the left\n    if (e.key === 'ArrowRight') v.querySelector('[data-a=\"-1\"]').click();\n  });\n\n  /* ---------- downloads ---------- */\n  const dlEl = $('#dlList');\n  DLS.forEach((g) => {\n    const row = document.createElement('div'); row.className = 'dl';\n    row.innerHTML = `<div class=\"what\"><b>${g.title}</b><div>${g.desc}</div></div><div class=\"get\">${g.files.map((f) =>\n      `<a class=\"btn${f.primary ? ' primary' : ''}\" href=\"${f.href}\" download>${f.label} \:00b7 ${f.size}</a>`).join('')}</div>`;\n    dlEl.appendChild(row);\n  });\n\n  /* ---------- history (from the research report) ---------- */\n  const HIST = ['what-the-han-kitab-is', 'background-muslims-in-china-before-the-han-kitab', 'the-scripture-hall-movement-and-the-birth-of-the-corpus',\n    'sinification-and-the-han-kitab-a-history-from-the-first-publication-to-2026', 'scholarly-debates'];\n  let histDone = false;\n  function renderHistory() {\n    if (histDone) return; histDone = true;\n    const h = document.createElement('div'); h.appendChild(document.getElementById('doc-report').content.cloneNode(true));\n    const secs = sectionsOf(h), hist = $('#hist'), htoc = $('#htoc');\n    htoc.innerHTML = '<div style=\"font:600 12px var(--sans);color:var(--muted);padding:4px 8px\">HISTORY</div>';\n    HIST.forEach((id) => {\n      const s = secs.find((x) => x.id === id); if (!s) return;\n      const w = document.createElement('div'); w.className = 'sec'; s.nodes.forEach((n) => w.appendChild(n)); hist.appendChild(w);\n      const t = s.title.replace(/^\\d+\\.\\s*/, '');\n      const a = document.createElement('a'); a.href = '#'; a.textContent = t; a.onclick = (e) => { e.preventDefault(); w.scrollIntoView({ behavior: 'smooth' }); }; htoc.appendChild(a);\n      w.querySelectorAll('h3').forEach((h3) => { const b = document.createElement('a'); b.href = '#'; b.textContent = '\:00b7 ' + h3.textContent; b.style.paddingLeft = '18px'; b.onclick = (e) => { e.preventDefault(); h3.scrollIntoView({ behavior: 'smooth' }); }; htoc.appendChild(b); });\n    });\n  }\n\n  /* ---------- gallery ---------- */\n  const GAL = JSON.parse(document.getElementById('gal-data').textContent || '[]');\n  const CATS = [['all', 'All'], ['Mosques', 'Mosques \:6e05\:771f\:5bfa'], ['Heritage', 'Tombs & calligraphy'], ['Quarters', 'Muslim quarters \:56de\:574a'], ['Markets', 'Markets & food']];\n  let gcat = 'all', gview = [], gi = 0, galDone = false;\n  function renderGallery() {\n    if (!galDone) {\n      galDone = true;\n      $('#gheadImg').src = (GAL.find((g) => /Great Mosque of Xi/.test(g.label)) || GAL[0]).img;\n      $('#gchips').innerHTML = CATS.map(([k, l]) => `<button data-c=\"${k}\" aria-pressed=\"${k === gcat}\">${l}${k === 'all' ? '' : ' \:00b7 ' + GAL.filter((g) => g.cat === k).length}</button>`).join('');\n      $$('#gchips button').forEach((b) => b.onclick = () => { gcat = b.dataset.c; $$('#gchips button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); drawGal(); });\n    }\n    drawGal();\n  }\n  function drawGal() {\n    gview = GAL.filter((g) => gcat === 'all' || g.cat === gcat);\n    $('#gal').innerHTML = '';\n    gview.forEach((g, i) => {\n      const t = document.createElement('figure'); t.className = 'tile'; t.tabIndex = 0;\n      t.innerHTML = `<span class=\"badge\">${esc(g.cat === 'Quarters' ? 'Quarter' : g.cat === 'Markets' ? 'Market' : g.cat === 'Heritage' ? 'Heritage' : 'Mosque')}</span>\n        <img loading=\"lazy\" src=\"${g.thumb}\" width=\"${g.w}\" height=\"${g.h}\" alt=\"${esc(g.label)}\" style=\"aspect-ratio:${g.w}/${g.h};height:auto\">\n        <figcaption class=\"cap\"><b>${esc(g.label)}</b><span class=\"zh\">${esc(g.zh)}</span> <span class=\"pl\">\:00b7 ${esc(g.place)}</span></figcaption>`;\n      t.onclick = t.onkeydown = (e) => { if (e.type === 'click' || e.key === 'Enter') openG(i); };\n      $('#gal').appendChild(t);\n    });\n  }\n  function openG(i) {\n    gi = (i + gview.length) % gview.length; const g = gview[gi], box = $('#glb');\n    box.querySelector('.stage img').src = g.img; box.querySelector('.stage img').alt = g.label;\n    box.querySelector('.info').innerHTML = `<b>${esc(g.label)}</b><span class=\"zh\">${esc(g.zh)}</span> <span style=\"color:#aab\">\:00b7 ${esc(g.place)}</span>\n      <div>${esc(g.desc)}</div>\n      <div class=\"credit\">Photo: ${esc(g.artist)} \:00b7 <a href=\"${g.licenseUrl || g.page}\" target=\"_blank\" rel=\"noopener\">${esc(g.license)}</a> \:00b7 <a href=\"${g.page}\" target=\"_blank\" rel=\"noopener\">Wikimedia Commons</a> \:00b7 ${gi + 1} / ${gview.length}</div>`;\n    box.classList.add('on');\n  }\n  $('#glb .prev').onclick = (e) => { e.stopPropagation(); openG(gi - 1); };\n  $('#glb .next').onclick = (e) => { e.stopPropagation(); openG(gi + 1); };\n  $('#glb .close').onclick = () => $('#glb').classList.remove('on');\n  $('#glb').onclick = (e) => { if (e.target.id === 'glb' || e.target.classList.contains('stage')) $('#glb').classList.remove('on'); };\n  document.addEventListener('keydown', (e) => {\n    if (!$('#glb').classList.contains('on')) return;\n    if (e.key === 'Escape') $('#glb').classList.remove('on');\n    if (e.key === 'ArrowRight') openG(gi + 1);\n    if (e.key === 'ArrowLeft') openG(gi - 1);\n  });\n  let tx = 0; $('#glb').addEventListener('touchstart', (e) => { tx = e.touches[0].clientX; }, { passive: true });\n  $('#glb').addEventListener('touchend', (e) => { const d = e.changedTouches[0].clientX - tx; if (Math.abs(d) > 50) openG(gi + (d < 0 ? 1 : -1)); });\n\n  docSel.onchange = () => openDoc(docSel.value);\n  $$('#langSeg button').forEach((b) => b.onclick = () => { lang = b.dataset.l; try { localStorage.setItem('hk.lang', lang); } catch (e) {} render(); });\n  $('#smaller').onclick = () => setFs(fs - 1); $('#larger').onclick = () => setFs(fs + 1);\n  function setFs(v) { fs = Math.max(14, Math.min(28, v)); document.documentElement.style.setProperty('--fs', fs + 'px'); try { localStorage.setItem('hk.fs', fs); } catch (e) {} }\n  $('#lb').onclick = () => $('#lb').classList.remove('on');\n  $('#coverLink').onclick = (e) => { e.preventDefault(); const lb = $('#lb'); lb.firstElementChild.src = 'img/cover_TianfangZhengxue_1861.jpg'; lb.classList.add('on'); };\n\n  /* ---------- read aloud (browser voices) ---------- */\n  const VC = window.HANKITAB_VOICE || {}, synth = window.speechSynthesis;\n  function pickVoice(prefs, langPrefix) {\n    const vs = synth ? synth.getVoices() : [];\n    for (const p of prefs || []) { const v = vs.find((x) => x.name.includes(p)); if (v) return v; }\n    return vs.find((x) => x.lang && x.lang.toLowerCase().startsWith(langPrefix)) || null;\n  }\n  function visibleSection() {\n    const secs = $$('.sec', docEl); let best = secs[0];\n    for (const s of secs) { if (s.getBoundingClientRect().top < window.innerHeight * 0.4) best = s; }\n    return best;\n  }\n  $('#readBtn').onclick = () => {\n    if (!synth) { alert('This browser has no speech voices.'); return; }\n    synth.cancel();\n    const sec = visibleSection(); if (!sec) return;\n    const zhOnly = lang === 'zh';\n    const src = zhOnly ? $('.zhcol', sec) : (sec.querySelector('.par > div:first-child') || sec);\n    const text = [...src.querySelectorAll('h2,p')].map((p) => p.textContent.replace(/\\[p\\. \\d+\\]/g, '')).join('\\n');\n    const chunks = text.match(/[^.!?\:3002\:ff01\:ff1f\\n]+[.!?\:3002\:ff01\:ff1f]?/g) || [];\n    const voice = zhOnly ? pickVoice(VC.ZH, 'zh') : pickVoice(VC.EN, 'en');\n    chunks.forEach((c, i) => {\n      const u = new SpeechSynthesisUtterance(c.trim()); if (voice) u.voice = voice; u.lang = zhOnly ? 'zh-TW' : 'en-GB'; u.rate = VC.RATE || 1;\n      if (i === chunks.length - 1) u.onend = () => { $('#stopBtn').disabled = true; };\n      synth.speak(u);\n    });\n    $('#stopBtn').disabled = false;\n  };\n  $('#stopBtn').onclick = () => { synth && synth.cancel(); $('#stopBtn').disabled = true; };\n\n  /* ---------- search index (offline) ---------- */\n  let INDEX = null;\n  function buildIndex() {\n    INDEX = [];\n    DOCS.forEach((d) => {\n      if (!d.tpl) return;   // the facsimile has page images only\n      const h = document.createElement('div'); h.appendChild(document.getElementById(d.tpl).content.cloneNode(true));\n      sectionsOf(h).forEach((s) => {\n        const tmp = document.createElement('div'); s.nodes.forEach((n) => tmp.appendChild(n.cloneNode(true)));\n        tmp.querySelectorAll('p,li,td,.notes,figcaption').forEach((el) => {\n          const t = el.textContent.replace(/\\s+/g, ' ').trim(); if (t.length > 25) INDEX.push({ doc: d.id, sec: s.id, title: s.title, t });\n        });\n      });\n      const z = ZH[d.id] && ZH[d.id].sections;\n      if (z) Object.entries(z).forEach(([sid, v]) => (v.text || '').split(/\\n{2,}/).forEach((t) => { if (t.trim()) INDEX.push({ doc: d.id, sec: sid, title: sid + ' \:00b7 \:4e2d\:6587', t: t.trim() }); }));\n    });\n  }\n  function search(q, max = 40, any = false) {\n    if (!INDEX) buildIndex();\n    const terms = q.toLowerCase().split(/\\s+/).filter(Boolean);\n    const isZh = /[\:3400-\:9fff]/.test(q);\n    const scored = [];\n    for (const e of INDEX) {\n      const low = e.t.toLowerCase(); let sc = 0;\n      if (isZh) { if (low.includes(q)) sc = 5; }\n      else for (const w of terms) { const k = low.split(w).length - 1; if (k) sc += 1 + Math.min(k, 3); else if (!any) { sc = -1e9; } }\n      if (low.includes(q.toLowerCase())) sc += 3;\n      if (sc > 0) scored.push([sc, e]);\n    }\n    return scored.sort((a, b) => b[0] - a[0]).slice(0, max).map((x) => x[1]);\n  }\n  const esc = (s) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));\n  function snippet(t, q) {\n    const low = t.toLowerCase(), w = q.toLowerCase().split(/\\s+/)[0]; let i = Math.max(0, low.indexOf(w) - 120);\n    let s = (i ? '\:2026' : '') + t.slice(i, i + 320) + (t.length > i + 320 ? '\:2026' : '');\n    s = esc(s); q.split(/\\s+/).filter(Boolean).forEach((x) => { s = s.replace(new RegExp('(' + x.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&') + ')', 'gi'), '<b>$1</b>'); });\n    return s;\n  }\n  $('#sForm').onsubmit = (e) => {\n    e.preventDefault(); const q = $('#sIn').value.trim(); if (!q) return;\n    const hits = search(q), out = $('#sOut');\n    out.innerHTML = hits.length ? `<div class=\"src\">${hits.length} result${hits.length > 1 ? 's' : ''}</div>` : '<span class=\"pending\">Nothing found.</span>';\n    hits.forEach((h) => {\n      const d = DOCS.find((x) => x.id === h.doc), el = document.createElement('div'); el.className = 'hit';\n      el.innerHTML = `<div>${snippet(h.t, q)}</div><div class=\"src\">${d.title} \:00b7 ${esc(h.title)}</div>`;\n      el.onclick = () => { openDoc(h.doc); setTimeout(() => { const s = $(`.sec[data-sec=\"${h.sec}\"]`); if (s) s.scrollIntoView(); highlightIn(s, q); }, 50); };\n      out.appendChild(el);\n    });\n  };\n  function highlightIn(root, q) {\n    if (!root) return; const w = q.split(/\\s+/)[0]; if (!w) return;\n    const re = new RegExp(w.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&'), 'i');\n    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT); let n;\n    while ((n = walker.nextNode())) { const m = n.data.match(re); if (m) { const r = document.createRange(); r.setStart(n, m.index); r.setEnd(n, m.index + m[0].length); const mk = document.createElement('mark'); r.surroundContents(mk); mk.scrollIntoView({ block: 'center' }); return; } }\n  }\n\n  /* ---------- Ask: CCN Cloud chat through HanKitabKernel (same protocol as TUTUKernel) ---------- */\n  const CFG = window.HANKITAB_CONFIG || {};\n  const KERNEL_URL = String(CFG.WOLFRAM_URL || '');\n  let CCN = false;\n  const PERSONA = 'You are the Han Kitab Guide in the Computational Classnotes Han Kitab reader. You answer questions about the Han Kitab (Chinese Islamic texts by Wang Daiyu, Ma Zhu, Liu Zhi, Ma Dexin and others), Islam in China and the texts in this app. Use the passages you are given first, say which text and section they come from, and say plainly when the passages do not answer the question. Be accurate, fair and concise. If someone asks whether they are talking to a person, answer honestly that they are not. Give no personal details about the people who make this app; send such requests to Lucia Valente, director, lucia@compclassnotes.com. Answer in the language of the question.';\n  function b64enc(str) { const bytes = new TextEncoder().encode(str); let bin = ''; for (let i = 0; i < bytes.length; i += 0x8000) bin += String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000)); return btoa(bin); }\n  function b64dec(b) { return new TextDecoder().decode(Uint8Array.from(atob(b), (c) => c.charCodeAt(0))); }\n  async function kernelCall(params) {\n    const r = await fetch(KERNEL_URL, { method: 'POST', body: new URLSearchParams(params) });\n    const j = await r.json().catch(() => null);\n    if (!j) throw new Error('Unreadable reply (HTTP ' + r.status + ')');\n    if (j.Success === false || j.Failure || j.Message === 'bad key') throw new Error(j.Message || 'Kernel error');\n    return j;\n  }\n  const stateEl = $('#ccnState'), logEl = $('#log');\n  async function ccnConnect() {\n    stateEl.textContent = 'Connecting to CCN Cloud\:2026';\n    try {\n      const j = await kernelCall({ mode: 'status' });\n      if (j.chat_ready === false) { stateEl.textContent = 'Written answers are not available right now; you will get passages from the texts.'; return false; }\n      CCN = true; stateEl.textContent = 'Connected to CCN Cloud.'; return true;\n    } catch (e) { stateEl.textContent = 'Offline: answers are passages from the texts.'; return false; }\n  }\n  ccnConnect();\n  /* ---------- Weekly news (HanKitabKernel mode \"news\") ---------- */\n  (function () {\n    let NEWS = null, sec = 'zh';\n    const list = $('#newsList'), foot = $('#newsFoot');\n    const fmt = (d) => { const t = new Date(d); return isNaN(t) ? '' : t.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }); };\n    function draw() {\n      const items = (NEWS && NEWS[sec]) || [];\n      list.innerHTML = '';\n      if (!items.length) { list.innerHTML = '<li class=\"meta\">No stories this week.</li>'; return; }\n      const wk = Date.now() - 7 * 864e5;\n      for (const it of items) {\n        const li = document.createElement('li'); if (it.lang === 'zh') li.className = 'zh';\n        const a = document.createElement('a'); a.href = it.link; a.target = '_blank'; a.rel = 'noopener noreferrer'; a.textContent = it.title;\n        const m = document.createElement('div'); m.className = 'meta';\n        if (new Date(it.date) >= wk) { const n = document.createElement('span'); n.className = 'new'; n.textContent = 'This week'; m.appendChild(n); }\n        m.appendChild(document.createTextNode(it.source + ' \:00b7 ' + fmt(it.date)));\n        li.append(a, m); list.appendChild(li);\n      }\n    }\n    $('#newsSeg').addEventListener('click', (e) => { const b = e.target.closest('button'); if (!b) return; sec = b.dataset.s; for (const x of $('#newsSeg').children) x.setAttribute('aria-pressed', x === b); draw(); });\n    async function load() {\n      try {\n        const j = await kernelCall({ mode: 'news' });\n        NEWS = JSON.parse(b64dec(j.news_b64 || '') || '{}');\n        try { localStorage.setItem('hk-news', JSON.stringify({ u: j.updated, n: NEWS })); } catch (e) {}\n        foot.textContent = 'Updated weekly \:00b7 last update ' + fmt(j.updated) + '. Headlines from Chinese, Asian and Middle Eastern news outlets; each link opens the original story.';\n      } catch (e) {\n        let c = null; try { c = JSON.parse(localStorage.getItem('hk-news') || 'null'); } catch (x) {}\n        if (c) { NEWS = c.n; foot.textContent = 'Offline \:00b7 showing headlines from ' + fmt(c.u) + '.'; }\n        else { list.innerHTML = '<li class=\"meta\">News is not available offline.</li>'; return; }\n      }\n      draw();\n    }\n    load();\n  })();\n  window.addEventListener('online', ccnConnect);\n  function addMsg(who, text) { const d = document.createElement('div'); d.className = 'msg ' + who; d.textContent = text; logEl.appendChild(d); logEl.scrollTop = logEl.scrollHeight; return d; }\n  const convo = [];\n  addMsg('bot', 'Ask me about the Han Kitab, Liu Zhi, Wang Daiyu, Ma Zhu, Islam in China, or anything in Mason\:2019s Arabian Prophet.');\n  $('#askForm').onsubmit = async (e) => {\n    e.preventDefault(); const q = $('#askIn').value.trim(); if (!q) return; $('#askIn').value = '';\n    addMsg('me', q);\n    const STOP = new Set('a an and are as at be by did do does for from had has have how in is it its of on or that the this to was were what when where which who whom why with about tell me please'.split(' '));\n    const kw = q.replace(/[?\:ff1f!.,\:ff0c\:3002:;'\"\:201c\:201d\:2018\:2019()]/g, ' ').split(/\\s+/).filter((w) => w && !STOP.has(w.toLowerCase()) && (w.length > 1 || /[\\u3400-\\u9fff]/.test(w))).slice(0, 6);\n    const hits = search(kw.join(' ') || q, 6, kw.length > 1);\n    if (!CCN) {\n      if (!hits.length) { addMsg('bot', 'I found no passage for that. Try other words, or connect a CCN Cloud key for a written answer.'); return; }\n      addMsg('bot', 'Passages from the texts:\\n\\n' + hits.slice(0, 4).map((h) => `\:2022 ${h.t.slice(0, 420)}${h.t.length > 420 ? '\:2026' : ''}\\n   (${DOCS.find((d) => d.id === h.doc).title} \:00b7 ${h.title})`).join('\\n\\n'));\n      return;\n    }\n    const wait = addMsg('bot wait', 'Reading the texts\:2026');\n    const ctx = hits.map((h, i) => { const d = DOCS.find((x) => x.id === h.doc); return `[${i + 1}] Source: ${d.source || d.title} Section: ${h.title}${/notes to p\\./.test(h.t) ? ' (a footnote by Isaac Mason)' : ''}.\\n${h.t.slice(0, 900)}`; }).join('\\n\\n');\n    convo.push({ role: 'user', content: `Passages:\\n${ctx || '(none found)'}\\n\\nQuestion: ${q}` });\n    try {\n      const j = await kernelCall({ mode: 'chat', payload_b64: b64enc(JSON.stringify({ max_tokens: 1500, system: PERSONA, messages: convo.slice(-8) })) });\n      if (j.error) throw new Error(j.error);\n      let t = b64dec(j.text_b64 || '');\n      try { const o = JSON.parse(t); t = o.reply || (o.content && o.content[0] && o.content[0].text) || t; } catch (e2) {}\n      wait.innerHTML = esc(t.trim()).replace(/\\*\\*([^*\\n]+)\\*\\*/g, '<b>$1</b>').replace(/(^|[^*])\\*([^*\\n]+)\\*/g, '$1<i>$2</i>').replace(/^#{1,4}\\s*(.+)$/gm, '<b>$1</b>');\n      wait.className = 'msg bot'; convo.push({ role: 'assistant', content: t.trim() });\n    } catch (err) { wait.textContent = 'The cloud connection failed: ' + err.message; wait.className = 'msg bot'; convo.pop(); }\n  };\n\n  /* ---------- install + offline ---------- */\n  /* Always shown, as in Tutu Cat: installs when the browser allows it, otherwise says what to do. */\n  let deferred = null;\n  const ibtn = $('#installBtn'), imsg = $('#installMsg'); let itimer = 0;\n  const say = (t) => { imsg.textContent = t; imsg.hidden = false; clearTimeout(itimer); itimer = setTimeout(() => { imsg.hidden = true; }, 12000); };\n  imsg.onclick = () => { imsg.hidden = true; };\n  const ua = navigator.userAgent;\n  const isIOS = /iPad|iPhone|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);\n  const isSafariMac = /Safari/.test(ua) && !/Chrome|Chromium|Edg|OPR/.test(ua) && !isIOS;\n  const isFirefox = /Firefox/.test(ua);\n  const installed = () => matchMedia('(display-mode: standalone)').matches || navigator.standalone === true;\n  const secure = location.protocol === 'https:' || location.hostname === 'localhost' || location.hostname === '127.0.0.1';\n  if (installed()) ibtn.hidden = true;\n  window.addEventListener('beforeinstallprompt', (e) => { e.preventDefault(); deferred = e; ibtn.hidden = false; });\n  window.addEventListener('appinstalled', () => { ibtn.hidden = true; say('Han Kitab is installed. Open it from your home screen or apps list; the texts work offline.'); });\n  ibtn.addEventListener('click', async () => {\n    if (deferred) {\n      deferred.prompt();\n      try { const c = await deferred.userChoice; if (c && c.outcome === 'dismissed') say('Install cancelled. Tap Install app to try again.'); } catch (e) {}\n      deferred = null; return;\n    }\n    if (installed()) { say('Han Kitab is already installed.'); return; }\n    if (location.protocol === 'file:') { say('Opened as a file, so it cannot be installed. Open https://lossofgenerality.github.io/han-kitab/ instead.'); return; }\n    if (!secure) { say('Installing needs a secure https:// address. Open Han Kitab from an https:// link.'); return; }\n    if (isIOS) { say('On iPhone and iPad: tap the Share button, then Add to Home Screen. (In Chrome on iPhone, the Share button is in the address bar.)'); return; }\n    if (isSafariMac) { say('In Safari on a Mac: choose File, then Add to Dock.'); return; }\n    if (isFirefox) { say('Firefox cannot install web apps. Open this page in Chrome or Edge, or on Android use the menu and Install.'); return; }\n    if (!('serviceWorker' in navigator)) { say('This browser cannot install web apps. Try Chrome or Edge.'); return; }\n    say('No install offer yet. Make sure this is not a private or incognito window and that Han Kitab is not already installed (check chrome://apps). Otherwise open the browser menu and choose Install Han Kitab, or Cast, save and share, then Install page as app. On Android: menu, then Install app or Add to Home screen.');\n  });\n  if ('serviceWorker' in navigator && location.protocol === 'https:') navigator.serviceWorker.register('sw.js').catch(() => {});\n\n  /* ---------- start ---------- */\n  const h = (location.hash || '').slice(1).split('/');\n  if (h[2] && /^(en|par|zh)$/.test(h[2])) lang = h[2];\n  if (h[0] === 'read') openDoc(h[1] || 'mason'); else if (h[0]) show(h[0]);\n})();\n</script>\n</body>\n</html>\n", "Program"],
Cell["tools/clean_zh_pages_v001.py", "Section"],
Cell["#!/usr/bin/env python3\n\"\"\"Clean the page images of \:5929\:65b9\:81f3\:8056\:5be6\:9304 (1924 printing, juan 1-10; NLC scan on Wikimedia Commons).\nPages are NOT altered in content: only (1) removal of isolated specks <= 6 px, (2) trimming to the printed\narea with an even margin, (3) centring on one common page size. \:00a9 Computational Classnotes \:00b7 CC BY-NC-SA 4.0\"\"\"\nimport glob, numpy as np, json\nfrom PIL import Image\nfrom scipy import ndimage\nfs = sorted(glob.glob('pages/p-*.png'))\nboxes = []; arrs = []\nfor f in fs:\n    a = np.array(Image.open(f).convert('L')) < 128          # True = ink\n    lab, n = ndimage.label(a)\n    sizes = ndimage.sum(a, lab, range(1, n + 1))\n    small = np.isin(lab, np.where(sizes <= 6)[0] + 1)\n    a = a & ~small\n    # trim: ignore a thin border strip (scanner edge shadows)\n    h, w = a.shape; m = 25\n    inner = a[m:h - m, m:w - m]\n    ys, xs = np.where(inner)\n    if len(ys) < 50: box = None\n    else:\n        box = (xs.min() + m, ys.min() + m, xs.max() + m + 1, ys.max() + m + 1)\n    boxes.append(box); arrs.append(a)\nW = max(b[2] - b[0] for b in boxes if b) + 160\nH = max(b[3] - b[1] for b in boxes if b) + 200\nlog = []\nfor i, (f, a, b) in enumerate(zip(fs, arrs, boxes), 1):\n    canvas = Image.new('1', (W, H), 1)\n    if b:\n        crop = Image.fromarray((~a[b[1]:b[3], b[0]:b[2]]).astype(np.uint8) * 255).convert('1')\n        canvas.paste(crop, ((W - crop.width) // 2, (H - crop.height) // 2))\n    canvas.save(f'clean/page_{i:03d}.png', optimize=True)\n    log.append({'page': i, 'src': f, 'box': [int(v) for v in b] if b else None})\njson.dump({'W': int(W), 'H': int(H), 'pages': log}, open('clean_log_v001.json', 'w'), indent=0)\nprint(W, H)\n", "Program"],
Cell["tools/make_app.py", "Section"],
Cell["#!/usr/bin/env python3\n\"\"\"Build the Han Kitab reader app (index.html) from the template and the texts in this repo.\nRun from the repo root:  python3 tools/make_app.py\n\:00a9 Computational Classnotes \:00b7 CC BY-NC-SA 4.0\"\"\"\nimport json, os, re, subprocess\n\nOUT = \"index.html\"\n\ndef frag(md, opts=()):\n    return subprocess.run([\"pandoc\", md, \"-t\", \"html5\", *opts], capture_output=True, text=True, check=True).stdout\n\ndef size(path):\n    b = os.path.getsize(path)\n    return f\"{b / 1e6:.1f} MB\" if b >= 1e6 else f\"{b / 1e3:.0f} KB\"\n\nmason = frag(\"texts/ArabianProphet_Mason1921_v001.md\", [\"-f\", \"markdown-tex_math_dollars\"])\nmason = mason.replace('src=\"plates/', 'src=\"texts/plates/')\nreport = frag(\"docs/HanKitab_Research_v001.md\", [\"-f\", \"markdown\"])\nfor s in (mason, report):\n    assert \"</template>\" not in s\n\n# Chinese facsimile: juan start pages (scan page numbers), found by reading the first column of each page\n# (records/03_zh_juan_detection_ocr_v001.txt) and checked against the page images.\nJUAN = [(1, \"\:5c01\:9762 Cover\"), (2, \"\:66f8\:540d Title\"), (9, \"\:5e74\:8b5c\:5e8f Preface\"), (23, \"\:91cd\:5370\:5e8f Reprint preface\"), (43, \"\:5377\:76ee Contents\"),\n        (51, \"\:5377\:4e00 Juan 1\"), (77, \"\:5377\:4e8c Juan 2\"), (97, \"\:5377\:4e09 Juan 3\"), (109, \"\:5377\:56db Juan 4\"), (123, \"\:5377\:4e94 Juan 5\"),\n        (145, \"\:5377\:516d Juan 6\"), (163, \"\:5377\:4e03 Juan 7\"), (197, \"\:5377\:516b Juan 8\"), (231, \"\:5377\:4e5d Juan 9\"), (257, \"\:5377\:5341 Juan 10\"),\n        (295, \"\:5c01\:5e95 Back cover\")]\n# Mason's chapters follow Liu Zhi's year-by-year order; this map opens the juan each chapter corresponds to (approximate).\nMASON_MAP = {\"top\": 2, \"list-of-illustrations\": 2, \"foreword\": 9, \"preface\": 9, \"concerning-the-chinese-author\": 9,\n             \"chapter-i\": 51, \"chapter-ii\": 109, \"chapter-iii\": 123, \"chapter-iv\": 145,\n             \"chapter-v\": 163, \"chapter-vi\": 197, \"chapter-vii\": 231, \"chapter-viii\": 257}\nnpages = len([f for f in os.listdir(\"texts/zh_pages\") if f.endswith(\".png\")])\nFACS = {\"dir\": \"texts/zh_pages\", \"pages\": npages, \"juan\": [{\"page\": p, \"label\": l} for p, l in JUAN],\n        \"mason_map\": MASON_MAP,\n        \"note\": \"Pages of the 1924 printing (prefaces and juan 1\:201310), unchanged. Mason condensed and selected, so the match with his chapters is by juan, not line by line.\"}\n\nDL = [\n    {\"title\": \"The Arabian Prophet \:00b7 clear-text edition v001\",\n     \"desc\": \"Mason\:2019s 1921 English translation of Liu Zhi, re-typeset with all twenty original illustrations. Edition \:00a9 Computational Classnotes \:00b7 CC BY-NC-SA 4.0; 1921 text public domain.\",\n     \"files\": [{\"label\": \"PDF\", \"href\": \"texts/ArabianProphet_Mason1921_v001.pdf\", \"primary\": True},\n               {\"label\": \"Markdown\", \"href\": \"texts/ArabianProphet_Mason1921_v001.md\"}]},\n    {\"title\": \"\:5929\:65b9\:81f3\:8056\:5be6\:9304 \:00b7 facsimile v001\",\n     \"desc\": \"Liu Zhi\:2019s Chinese text, 1924 printing, prefaces and juan 1\:201310: the original pages unchanged, with a cover and copyright page added.\",\n     \"files\": [{\"label\": \"PDF\", \"href\": \"texts/TianfangZhishengShilu_1924_facsimile_v001.pdf\", \"primary\": True}]},\n    {\"title\": \"Han Kitab research report v001\",\n     \"desc\": \"Publications, Chinese\:2013English passages, glossary and a history of Sinification.\",\n     \"files\": [{\"label\": \"PDF\", \"href\": \"docs/HanKitab_Research_v001.pdf\", \"primary\": True},\n               {\"label\": \"Markdown\", \"href\": \"docs/HanKitab_Research_v001.md\"}]},\n    {\"title\": \"Original scan \:00b7 The Arabian Prophet (1921)\",\n     \"desc\": \"Cornell University Library copy, digitized by the Internet Archive (cu31924024748232). Unchanged.\",\n     \"files\": [{\"label\": \"Original PDF\", \"href\": \"originals/ArabianProphet_Mason1921_original_scan_cu31924024748232.pdf\"}]},\n    {\"title\": \"Original scan \:00b7 \:5929\:65b9\:81f3\:8056\:5be6\:9304 (1924)\",\n     \"desc\": \"National Library of China copy, published on Wikimedia Commons (NLC416-13jh005373-59385). Unchanged.\",\n     \"files\": [{\"label\": \"Original PDF\", \"href\": \"originals/TianfangZhishengShilu_1924_original_scan_NLC416-13jh005373-59385.pdf\"}]},\n]\nfor g in DL:\n    for f in g[\"files\"]:\n        f[\"size\"] = size(f[\"href\"])\n\ntpl = open(\"tools/app_template.html\").read()\nhtml = (tpl.replace(\"__MASON__\", mason).replace(\"__REPORT__\", report)\n        .replace(\"__ZHDATA__\", json.dumps({}, ensure_ascii=False))\n        .replace(\"__FACSDATA__\", json.dumps(FACS, ensure_ascii=False))\n        .replace(\"__DLDATA__\", json.dumps(DL, ensure_ascii=False))\n        .replace(\"__GALDATA__\", json.dumps(json.load(open(\"gallery/gallery_v001.json\")), ensure_ascii=False))\n        )\nimport hashlib\nopen(OUT, \"w\").write(html)\n# service worker cache name follows the content, so installed copies update by themselves\nh = hashlib.sha1(html.encode()).hexdigest()[:10]\nsw = open(\"sw.js\").read()\nsw = re.sub(r\"const VERSION = '[^']*';\", f\"const VERSION = 'hankitab-{h}';\", sw)\nopen(\"sw.js\", \"w\").write(sw)\nprint(OUT, len(html))\n", "Program"],
Cell["tools/make_gallery_v001.py", "Section"],
Cell["#!/usr/bin/env python3\n\"\"\"Build gallery/ (images + gallery_v001.json) from Wikimedia Commons downloads.\nUsage: python3 -I make_gallery_v001.py RAW_DIR REPO_DIR\n\:00a9 Computational Classnotes \:00b7 CC BY-NC-SA 4.0 (gallery selection and captions; each photo keeps its own licence)\"\"\"\nimport json, os, re, sys, html\nfrom PIL import Image, ImageOps\nRAW, REPO = sys.argv[1], sys.argv[2]\nP = json.load(open(os.path.join(RAW, 'picks.json')))\nD = json.load(open(os.path.join(RAW, 'cand', 'cands.json')))\nC = D['cands']; ALT = D['alt']\ndef pick(n): return dict(P[n-1], file=os.path.join(RAW, f'g{n:02d}.jpg'))\ndef cand(i, j, cat, label, zh, place):\n    c = dict(C[i-1][j-1]); c.update(cat=cat, label=label, zh=zh, place=place, file=os.path.join(RAW, 'cand', f'c{i:02d}_{j}.jpg')); return c\nITEMS = [  # (source, description)\n (cand(1,2,'Mosques','Huaisheng Mosque','\:61f7\:8056\:5bfa','Guangzhou, Guangdong'), 'Traditionally dated to the Tang dynasty, one of the oldest mosques in China. Its smooth round minaret, the Guangta, is a Guangzhou landmark.'),\n (pick(2), 'Founded in 1009 and rebuilt in 1310; the stone gateway is in West Asian style, unlike most Chinese mosques.'),\n (pick(3), 'Laid out like a Chinese temple, with courtyards, pavilions and a pagoda-like minaret. Most of the present buildings are Ming (14th\:201317th century).'),\n (cand(8,2,'Mosques','Great Mosque of Xi\:2019an, prayer hall','\:5316\:89ba\:5df7\:6e05\:771f\:5927\:5bfa\:79ae\:62dc\:6bbf','Xi\:2019an, Shaanxi'), 'Carved wooden panels with Qur\:2019anic inscriptions line the walls of the prayer hall.'),\n (pick(4), 'Beijing\:2019s oldest and largest mosque, founded in 996 according to tradition, at the heart of the Niujie Hui neighbourhood.'),\n (cand(13,1,'Mosques','Niujie Mosque, prayer hall','\:725b\:8857\:79ae\:62dc\:5bfa\:79ae\:62dc\:6bbf','Beijing'), 'Inside the prayer hall: Chinese timber construction, painted beams and Arabic inscriptions.'),\n (pick(5), 'Founded in 1447 under the Ming, one of Beijing\:2019s principal mosques.'),\n (pick(6), 'One of the four great early mosques of China\:2019s coast; rebuilt in the Yuan dynasty.'),\n (pick(7), 'Founded in the Song dynasty; its plan is said to resemble a crane (\:4ed9\:9db4).'),\n (pick(8), 'Shanghai\:2019s oldest mosque, built in the Yuan dynasty.'),\n (pick(9), 'Shandong\:2019s largest mosque. Its 1528 inscription, \:4f86\:5fa9\:9298, is one of the earliest Chinese texts on Islam by a Muslim author.'),\n (cand(2,3,'Mosques','East Great Mosque','\:6fdf\:5be7\:6771\:5927\:5bfa','Jining, Shandong'), 'On the Grand Canal; Jining was a centre of the Shandong school of scripture-hall learning.'),\n (pick(11), 'A Qing-era mosque in Chinese style in the old city of Tianjin.'),\n (pick(12), 'Ming-era mosque of Nanjing (Jinling), the city where Wang Daiyu and Liu Zhi wrote the Han Kitab.'),\n (pick(13), 'Qing-dynasty mosque joining Chinese roofs to Islamic arches.'),\n (pick(14), 'Ming-dynasty mosque of the Na clan, in a Hui village near Yinchuan.'),\n (pick(15), 'The oldest surviving mosque in Ningxia, built in Chinese style.'),\n (pick(16), 'Qinghai\:2019s largest mosque, founded in 1380.'),\n (dict(pick(17), label='Hanjia Mosque, Linxia', zh='\:81e8\:590f\:97d3\:5bb6\:6e05\:771f\:5bfa'), 'Linxia (Hezhou), often called China\:2019s \:201cLittle Mecca\:201d, has dozens of mosques and Sufi shrines.'),\n (pick(18), 'Xinjiang\:2019s largest mosque, built in 1442 at the centre of Kashgar.'),\n (cand(3,1,'Mosques','Emin Minaret','\:984d\:654f\:5854','Turpan, Xinjiang'), 'Built in 1777\:201378 by Emin Khoja: 44 metres of sun-dried brick in geometric patterns.'),\n (pick(20), 'Kaifeng\:2019s main mosque. The city\:2019s Hui community also keeps women\:2019s mosques (\:5973\:5bfa), led by women.'),\n (pick(21), 'One of the oldest Muslim foundations in Kunming, Yunnan, rebuilt in modern times.'),\n (cand(10,1,'Mosques','Great Mosque of Shadian','\:6c99\:7538\:5927\:6e05\:771f\:5bfa','Shadian, Yunnan'), 'The Hui town of Shadian rebuilt its great mosque in 2009 in a Middle Eastern style.'),\n (pick(22), 'Hong Kong\:2019s largest mosque, opened in 1984.'),\n (pick(23), 'The principal mosque of Chengdu, Sichuan.'),\n (pick(24), 'The principal mosque of Lanzhou, Gansu.'),\n (cand(11,1,'Heritage','Tomb of Sa\:2018d ibn Abi Waqqas (traditional)','\:6e05\:771f\:5148\:8ce2\:53e4\:5893','Guangzhou, Guangdong'), 'Chinese Muslim tradition holds that a companion of the Prophet, Sa\:2018d ibn Abi Waqqas, is buried here.'),\n (pick(25), 'Traditionally the tombs of two companions of the Prophet who came to Quanzhou in the Tang dynasty.'),\n (pick(26), 'Mausoleum of the 17th-century Sufi leader Afaq Khoja and his family.'),\n (cand(4,2,'Heritage','Basmala in Sini script','\:6e05\:771f\:5bfa\:7d93\:5b57','Qingjing Mosque, Quanzhou'), 'The basmala, \:201cIn the name of God, the Merciful, the Compassionate\:201d, in Sini, the Chinese style of Arabic calligraphy.'),\n (cand(4,1,'Heritage','al-\:1e24amdu li-ll\:0101h in Sini script','\:7d93\:5b57\:756b','China'), '\:201cPraise be to God\:201d, written in the round brush strokes of Sini calligraphy.'),\n (pick(28), 'Xi\:2019an\:2019s Hui quarter around the Great Mosque, known for its food streets.'),\n (cand(15,1,'Quarters','Muslim Quarter at night','\:56de\:6c11\:8857\:591c\:5e02','Xi\:2019an, Shaanxi'), 'Evening crowds in the lanes of the Muslim Quarter.'),\n (pick(29), 'The Hui neighbourhood around Niujie Mosque in Beijing.'),\n (pick(30), 'The Uyghur old town of Kashgar; much of it has been rebuilt since 2009.'),\n (pick(31), 'Linxia city in Gansu, a historic centre of Hui, Dongxiang and Salar life.'),\n (cand(16,1,'Markets','Market street, Linxia','\:81e8\:590f\:5e02\:5834','Linxia, Gansu'), 'A street market below a mosque minaret.'),\n (pick(34), 'Spicy lamb trotters (\:9ebb\:8fa3\:7f8a\:8e44) and other halal snacks in Xi\:2019an.'),\n (cand(12,1,'Markets','Yangrou paomo','\:7f8a\:8089\:6ce1\:9943','Xi\:2019an, Shaanxi'), 'Xi\:2019an\:2019s signature Hui dish: flatbread broken into mutton soup.'),\n (pick(35), 'The Sunday market of Kashgar.'),\n (pick(36), 'The International Grand Bazaar of \:00dcr\:00fcmqi.'),\n (pick(37), 'A Lanzhou beef-noodle shop; Hui-run noodle restaurants are found all over China.'),\n (dict(pick(38), label='A qingzhen (halal) restaurant, early 20th century'), 'From the Japanese photograph series \:4e9c\:6771\:5370\:753b\:8f2f (1920s\:20131940s); the sign \:6e05\:771f marks Muslim food.'),\n (cand(7,3,'Markets','Livestock market, Hotan','\:548c\:7530\:5df4\:624e','Hotan, Xinjiang'), 'The sheep market at the Hotan bazaar.'),\n]\ndef clean(s):\n    s = re.sub(r'<[^>]+>', '', s or ''); s = html.unescape(s); return re.sub(r'\\s+', ' ', s).strip()\nout = os.path.join(REPO, 'gallery'); os.makedirs(out, exist_ok=True)\ndata = []\nfor k, (it, desc) in enumerate(ITEMS, 1):\n    im = ImageOps.exif_transpose(Image.open(it['file'])).convert('RGB')\n    big = im.copy(); big.thumbnail((1400, 1400)); big.save(os.path.join(out, f'photo_{k:02d}.jpg'), quality=82, optimize=True, progressive=True)\n    sm = im.copy(); sm.thumbnail((560, 560)); sm.save(os.path.join(out, f'thumb_{k:02d}.jpg'), quality=78, optimize=True, progressive=True)\n    data.append({'n': k, 'cat': it['cat'], 'label': it['label'], 'zh': it['zh'], 'place': it['place'], 'desc': desc,\n                 'artist': clean(it.get('artist')) or 'Unknown', 'license': it.get('license', ''), 'licenseUrl': it.get('licenseUrl', ''),\n                 'page': it['page'], 'title': it['title'].replace('File:', ''), 'w': big.width, 'h': big.height,\n                 'img': f'gallery/photo_{k:02d}.jpg', 'thumb': f'gallery/thumb_{k:02d}.jpg'})\njson.dump(data, open(os.path.join(out, 'gallery_v001.json'), 'w'), ensure_ascii=False, indent=1)\nprint(len(data), 'photos')\n", "Program"],
Cell["tools/make_mason_v001.py", "Section"],
Cell["#!/usr/bin/env python3\n\"\"\"Rebuild Mason, The Arabian Prophet (1921) as clean Markdown with the original plates.\nInput: src.pdf (Internet Archive scan cu31924024748232). Output: ArabianProphet_Mason1921_v001.md\n\:00a9 Computational Classnotes \:00b7 CC BY-NC-SA 4.0 (this edition's processing; the 1921 text is public domain)\n\"\"\"\nimport re, subprocess\n\nSRC = \"src.pdf\"\nNPAGES = 368\n\nPLATES = {\n    6:   (\"Mosque and Minaret at Canton (the \:201cPagoda-without-ornament\:201d mosque)\", \"Frontispiece\"),\n    19:  (\"Facsimile of the Chinese title-page: \:81f3\:8056\:5be6\:9304, \:201cThe True Annals of the Prophet\:201d\", \"Facing p. ix\"),\n    31:  (\"Map of Arabia in the time of the Prophet\", \"Facing p. 2\"),\n    67:  (\"Mecca and the Kaaba\", \"p. 68\"),\n    100: (\"The Black Stone at Mecca\", \"p. 83\"),\n    115: (\"Page from a Moslem ritual, in Chinese and Arabic\", \"p. 84\"),\n    116: (\"Part of the First Chapter of the Koran, with Chinese translation and transliteration\", \"Facing p. 114\"),\n    147: (\"An Imam preaching in a Mosque\", \"p. 136\"),\n    171: (\"Medina\", \"p. 146\"),\n    183: (\"The Mihrab, or prayer-niche, of a Shanghai Mosque\", \"p. 171\"),\n    210: (\"Ancient Moslem Grave-yard at Canton\", \"p. 218\"),\n    259: (\"Interior of a Tientsin Mosque\", \"p. 240\"),\n    283: (\"Plan of Mecca and the Kaaba\", \"p. 259\"),\n    303: (\"The Kalima, etc.\", \"p. 260\"),\n    304: (\"Parting Injunctions of the Prophet\", \"Facing p. 268\"),\n    313: (\"Training School for Ahungs (Shanghai); Tomb of a Moslem Pioneer at Canton\", \"pp. 268, 276\"),\n    323: (\"A Ming Dynasty Monument\", \"p. 277\"),\n    324: (\"A Monument at Sianfu, Shensi, recording the building of a mosque\", \"p. 302\"),\n    351: (\"Chinese Mohammedan Paraphernalia\", \"p. 302\"),\n}\nPLATE_ONLY = set(PLATES) - {100}\nBLANK = {1, 2, 3, 4, 5, 7, 8, 10, 20, 27, 28, 32, 68, 148, 172, 184, 209, 260, 284, 314, 352} | set(range(365, NPAGES + 1))\nLINES_MODE = {7, 14, 23, 24, 25, 26, 364} | set(range(357, 364))\n\ndef page_text(p):\n    return subprocess.run([\"pdftotext\", \"-layout\", \"-f\", str(p), \"-l\", str(p), SRC, \"-\"],\n                          capture_output=True, text=True).stdout\n\nFIX = [\n    (r\"\\btlie\\b\", \"the\"), (r\"\\bTlie\\b\", \"The\"), (r\"\\btliis\\b\", \"this\"), (r\"\\bliis\\b\", \"his\"),\n    (r\"\\bthfe\\b\", \"the\"), (r\"\\bwliich\\b\", \"which\"), (r\"\\bwlio\\b\", \"who\"), (r\"\\btliat\\b\", \"that\"),\n    (r\"\\bTHB\\b\", \"THE\"), (r\"\:25a0\", \"\"), (r\"\\s+([,.;:!?])\", r\"\\1\"), (r\"([,.;:])\\s*[\\-'\:2019`]+(\\s|$)\", r\"\\1\\2\"),\n    (r\"(?<=\\w)\\^+|\\^+(?=\\w)\", \"[?]\"), (r\"\\^+(\\s*\\^+)*\", \"[Chinese]\"), (r\" {2,}\", \" \"),\n]\n\ndef clean(s):\n    for a, b in FIX:\n        s = re.sub(a, b, s)\n    s = s.replace(\"*\", r\"\\*\").replace(\"_\", r\"\\_\")\n    return s.strip()\n\nROMAN = re.compile(r\"^[ivxlcy]+$\", re.I)\nCHAP = re.compile(r\"^\\s*(CHAPTER|APPENDIX)\\s+([IVXLnlH\\]1]+)(\\s.*)?$\")\nNOTE = re.compile(r\"^\\s{2,10}(\\d{1,2}|[Il])\\s?[.,]\\s+\\S\")\n\ndef is_header(line):\n    s = line.strip()\n    if not s:\n        return False\n    toks = s.split()\n    caps = re.sub(r\"[^A-Za-z ]\", \"\", \" \".join(t for t in toks if not ROMAN.match(t) and not re.search(r\"\\d\", t)))\n    if len(caps) and caps.upper() == caps and (re.match(r\"^\\S{1,4}$\", toks[0]) or re.match(r\"^\\S{1,4}$\", toks[-1])):\n        return True\n    if caps.upper() == caps and len(s) < 60 and (\"ARABIAN\" in s or \"APPENDIX\" in s or \"MOHAMMEDANISM\" in s):\n        return True\n    return False\n\ndef header_pageno(line):\n    toks = line.strip().split()\n    for t in (toks[0], toks[-1]):\n        d = re.sub(r\"[^0-9]\", \"\", t.replace(\"o\", \"0\").replace(\"O\", \"0\").replace(\"l\", \"1\").replace(\"I\", \"1\"))\n        if d and len(d) <= 3:\n            return int(d)\n    return None\n\nout = []\npara = []\npending = []   # notes / plates to emit after the paragraph closes\n\ndef flush_para():\n    global para\n    if para:\n        txt = \"\"\n        for ln in para:\n            if txt.endswith(\"-\") and ln[:1].islower():\n                txt = txt[:-1] + ln\n            elif txt:\n                txt += \" \" + ln\n            else:\n                txt = ln\n        out.append(clean(txt) + \"\\n\")\n        para = []\n    while pending:\n        out.append(pending.pop(0))\n\ndef plate_md(p):\n    cap, loc = PLATES[p]\n    return f'<figure class=\"plate\"><img src=\"plates/plate_{p:03d}.jpg\" alt=\"{cap}\"><figcaption>{cap} <span class=\"loc\">(original {loc})</span></figcaption></figure>\\n'\n\nlast_no = 0\nfor p in range(1, NPAGES + 1):\n    if p in BLANK:\n        continue\n    if p in PLATE_ONLY:\n        pending.append(plate_md(p))\n        continue\n    raw = page_text(p).splitlines()\n    lines = [l.rstrip() for l in raw]\n    while lines and not lines[0].strip():\n        lines.pop(0)\n    if not lines:\n        continue\n\n    if p == 9:  # dedication only\n        flush_para()\n        out.append('<div class=\"dedication\">To my Wife<br>who has bravely shared many years of pioneer missionary service with me<br>in West China</div>\\n')\n        continue\n\n    if p in LINES_MODE:\n        flush_para()\n        block = []\n        for l in lines:\n            s = clean(l)\n            if not s:\n                continue\n            if p >= 357 and block and (s[:1].islower() or s[:1].isdigit()) and not re.match(r\"^[A-Z]$\", s):\n                block[-1] += \" \" + s\n            else:\n                block.append(s)\n        cls = \"index\" if 357 <= p <= 363 else \"lines\"\n        if p == 357:\n            out.append(\"## Index\\n\")\n            block = [b for b in block if b.upper() != \"INDEX\"]\n        elif p > 357:\n            block = [b for b in block if b.upper() != \"INDEX\" and not re.match(r\"^\\d{3}$\", b)]\n        out.append(f'<div class=\"{cls}\">\\n' + \"<br>\\n\".join(block) + \"\\n</div>\\n\")\n        continue\n\n    # running header\n    first = lines[0]\n    pno = None\n    if is_header(first) and not CHAP.match(first):\n        pno = header_pageno(first)\n        lines = lines[1:]\n    if p == 100:\n        # drop the vertical caption of the Black Stone plate\n        lines = [l for l in lines if len(l.strip()) > 2]\n    if pno is None or not (0 < pno - last_no <= 4):\n        pno = last_no + 1 if p >= 29 else None\n    if p >= 29:\n        last_no = pno\n\n    # split body / notes\n    body, notes = lines, []\n    for i, l in enumerate(lines):\n        if i > 3 and NOTE.match(l):\n            body, notes = lines[:i], lines[i:]\n            break\n\n    body = [l for l in body if not re.match(r\"^\\s*([ivxlc]{1,5}|\\d{1,3})\\s*$\", l, re.I)]\n    ind = [len(l) - len(l.lstrip()) for l in body if l.strip()]\n    base = min(ind) if ind else 0\n    if ind:\n        from collections import Counter\n        base = Counter(ind).most_common(1)[0][0]\n    # page marker\n    if pno:\n        mark = f'<span class=\"pg\">[p. {pno}]</span>'\n    else:\n        mark = \"\"\n    started = False\n    in_summary = False\n    for l in body:\n        if not l.strip():\n            if in_summary:\n                in_summary = False\n                flush_para()\n            continue\n        m = CHAP.match(l)\n        if m:\n            flush_para()\n            kind = m.group(1).title()\n            num = m.group(2).replace(\"n\", \"II\").replace(\"H\", \"II\").replace(\"]\", \"I\").replace(\"l\", \"I\").replace(\"1\", \"I\")\n            if num == \"IIII\": num = \"III\"\n            out.append(f\"## {kind} {num}\\n\")\n            in_summary = (kind == \"Chapter\")\n            if in_summary:\n                para.append(\"\")  # summary paragraph\n            continue\n        s = l.strip()\n        s = re.sub(r\"^[ivxl]{1,4}\\s{2,}(?=[A-Z\\\"'])\", \"\", s)\n        if s in (\"THE ARABIAN PROPHET\", \"THE ARABIAN  PROPHET\") and not started:\n            continue\n        if re.sub(r\"\\s+\", \" \", s) in (\"FOREWORD\", \"PREFACE\", \"CONCERNING THE CHINESE AUTHOR\"):\n            s = re.sub(r\"\\s+\", \" \", s)\n            flush_para()\n            out.append(f\"## {s.title()}\\n\")\n            continue\n        indent = len(l) - len(l.lstrip())\n        if in_summary:\n            para.append(s)\n            continue\n        prev_hy = bool(para) and para[-1].endswith(\"-\")\n        if indent >= base + 3 and para and not prev_hy and not s[:1].islower():\n            flush_para()\n        if not started and mark:\n            s = mark + \" \" + s if not para else s\n            if para:\n                para[-1] += \" \" + mark\n            started = True\n        para.append(s)\n    if not started and mark:\n        para.append(mark)\n\n    if notes:\n        nl = []\n        for l in notes:\n            s = l.strip()\n            if not s:\n                continue\n            if NOTE.match(l) or not nl:\n                nl.append(s)\n            else:\n                if nl[-1].endswith(\"-\") and s[:1].islower():\n                    nl[-1] = nl[-1][:-1] + s\n                else:\n                    nl[-1] += \" \" + s\n        pending.append('<div class=\"notes\">' + \"<br>\\n\".join(clean(n) for n in nl) + f' <span class=\"loc\">(notes to p. {pno})</span></div>\\n')\n    if p == 100:\n        pending.append(plate_md(100))\n\nflush_para()\n\n# fix summary paragraphs: italicise first paragraph right after a chapter heading\nmd = \"\\n\".join(out)\nmd = re.sub(r\"(## Chapter [IVXL]+\\n\\n)\\s*([^\\n<#][^\\n]*)\", lambda m: m.group(1) + \"*\" + m.group(2).strip() + \"*\", md)\n\nillus = \"\\n\".join(f\"| {PLATES[p][0]} | {PLATES[p][1]} |\" for p in sorted(PLATES))\nfront = f\"\"\"---\ntitle: \"The Arabian Prophet: A Life of Mohammed from Chinese and Arabic Sources\"\n---\n\n<div class=\"titlepage\">\n<h1>The Arabian Prophet</h1>\n<p class=\"sub\">A Life of Mohammed from Chinese and Arabic Sources<br>A Chinese-Moslem Work</p>\n<p>by <b>Liu Chai-lien</b> (Liu Zhi \:5289\:667a, Liu Jielian \:5289\:4ecb\:5ec9, c. 1660\:2013c. 1730)<br>\nTranslation of <i>Tianfang zhisheng shilu</i> \:5929\:65b9\:81f3\:8056\:5be6\:9304 (completed 1724)</p>\n<p>Translated by <b>Isaac Mason</b><br>of Friends' Foreign Mission Association, and Christian Literature Society for China;\nHonorary Secretary, Royal Asiatic Society, North-China Branch</p>\n<p>With Appendices on Chinese Mohammedanism<br>Foreword by Rev. Samuel M. Zwemer, F.R.G.S., of Cairo</p>\n<p>Shanghai: Commercial Press, 1921</p>\n</div>\n\n<div class=\"ednote\">\n\n**About this edition (v001).** A clear-text re-setting of the 1921 edition, made from the Cornell University Library copy digitized by the Internet Archive (archive.org/details/cu31924024748232). The text was taken from the scan's OCR layer, with running heads removed, paragraphs re-joined, line-end hyphens removed and common OCR errors corrected. All twenty original illustrations are reproduced from the scan at their places in the book. Mason's footnotes are printed in smaller type after the paragraph where they fall, marked with the page they belong to. Original page numbers appear in the margin as [p. N] so that references to the 1921 edition still work.\n\n*Limits:* the OCR could not read the Chinese characters that Mason quotes in the text and notes. Where a run of them was detected it is marked **[Chinese]**, and an unreadable character inside a word is marked **[?]**; some other places may still carry stray symbols. Check any Chinese terms, and any sentence that looks wrong, against the scan. Not every line has been proofread by hand.\n\nThe 1921 text is in the public domain. Edition and processing \:00a9 Computational Classnotes \:00b7 CC BY-NC-SA 4.0.\n\n</div>\n\n## List of Illustrations\n\n| Illustration | Position in the 1921 edition |\n|---|---|\n{illus}\n\n\"\"\"\nmd = front + md + \"\\n\\n---\\n\\n*Edition v001 \:00b7 prepared 2026 \:00b7 \:00a9 Computational Classnotes \:00b7 CC BY-NC-SA 4.0 (1921 text public domain)*\\n\"\nopen(\"ArabianProphet_Mason1921_v001.md\", \"w\").write(md)\nprint(len(md))\n", "Program"],
Cell["tools/make_notebooks_v001.py", "Section"],
Cell["#!/usr/bin/env python3\n\"\"\"Write the Han Kitab Wolfram notebooks (plain Notebook[] expressions, ASCII-escaped) into wolfram/.\n  HanKitabKernel_v001.nb          deploy + test HanKitabKernel\n  HanKitabOperationsLog_v001.nb   (T) rewrites u x v -> u y v and (DO) runs with indexed iterations\n  HanKitabDevelopmentLog_v001.nb  how the work was built: trials, results, fixes, glossary\n  HanKitabScripts_v001.nb         every script and the app template, one cell each\nRun from the repo root: python3 tools/make_notebooks_v001.py\n\:00a9 Computational Classnotes \:00b7 CC BY-NC-SA 4.0\"\"\"\nimport glob, os\n\ndef esc(s):\n    out = []\n    for ch in s:\n        o = ord(ch)\n        if ch == \"\\\\\": out.append(\"\\\\\\\\\")\n        elif ch == '\"': out.append('\\\\\"')\n        elif ch == \"\\n\": out.append(\"\\\\n\")\n        elif ch == \"\\t\": out.append(\"    \")\n        elif o < 32: continue\n        elif o < 128: out.append(ch)\n        elif o <= 0xFFFF: out.append(\"\\\\:%04x\" % o)\n        else: out.append(\"\\\\|%06x\" % o)\n    return \"\".join(out)\n\ndef cell(text, style): return 'Cell[\"%s\", \"%s\"]' % (esc(text), style)\nCOPY = \"\:00a9 Computational Classnotes \:00b7 CC BY-NC-SA 4.0\"\n\ndef notebook(path, cells):\n    body = \",\\n\".join(cells + [cell(COPY, \"Text\")])\n    open(path, \"w\", encoding=\"ascii\").write(\n        \"(* Content-type: application/vnd.wolfram.mathematica *)\\n(* \" + esc(COPY) + \" *)\\n\"\n        \"Notebook[{\\n\" + body + \"\\n}, WindowTitle -> \\\"\" + esc(os.path.basename(path)) + \"\\\"]\\n\")\n\n# ---------- 1. kernel ----------\nwl = open(\"wolfram/HanKitabKernel_v001.wl\", encoding=\"utf-8\").read()\nblocks = [b.strip() for b in wl.split(\"\\n\\n\") if b.strip()]\ncells = [cell(\"HanKitabKernel v001\", \"Title\"),\n         cell(\"Wolfram Cloud chat proxy for the Han Kitab reader. Same protocol as TUTUKernel and LaplacianLabKernel (CCN Cloud Kit). Deployed at https://www.wolframcloud.com/obj/ccn2/HanKitabKernel on 21 Nov 2026. The chat key is read from the private cloud object LaplacianLab/apikey; the app key (secret) is stored privately as HanKitab/secret and in HanKitabKernel_SECRET_private.txt in the Desktop folder. Never commit the secret.\", \"Text\")]\nfor b in blocks:\n    if b.startswith(\"(*\") and b.endswith(\"*)\"):\n        cells.append(cell(b[2:-2].strip(), \"Text\"))\n    else:\n        cells.append(cell(b, \"Input\"))\ncells += [cell(\"Test (DO006)\", \"Section\"),\n          cell('u = \"https://www.wolframcloud.com/obj/ccn2/HanKitabKernel\"; secret = CloudGet[\"HanKitab/secret\"];\\n'\n               'URLExecute[HTTPRequest[u, <|\"Method\" -> \"POST\", \"Body\" -> {\"key\" -> secret, \"code\" -> \"{$VersionNumber, 1 + 1}\"}|>], \"RawJSON\"]', \"Input\"),\n          cell('pl = BaseEncode[StringToByteArray[ExportString[<|\"model\" -> \"claude-sonnet-5-5\", \"max_tokens\" -> 1500, \"system\" -> \"Answer in one short sentence.\", \"messages\" -> {<|\"role\" -> \"user\", \"content\" -> \"Who wrote \:5929\:65b9\:6027\:7406?\"|>}|>, \"RawJSON\", \"Compact\" -> True]]];\\n'\n               'ch = URLExecute[HTTPRequest[u, <|\"Method\" -> \"POST\", \"Body\" -> {\"key\" -> secret, \"mode\" -> \"chat\", \"payload_b64\" -> pl}|>], \"RawJSON\"];\\n'\n               '{ch[\"stop_reason\"], ByteArrayToString[BaseDecode[ch[\"text_b64\"]]]}', \"Input\")]\nnotebook(\"wolfram/HanKitabKernel_v001.nb\", cells)\n\n# ---------- 2. operations log ----------\nT = [  # (index, file, u, x, v, y, why)\n (\"T001\", \"tools/make_mason_v001.py\", 'CHAP = re.compile(r\"^\\\\s*(CHAPTER|APPENDIX)\\\\s+(', '[IVXLnl1]+)\\\\b(.*)$\")', '', '[IVXLnlH\\\\]1]+)(\\\\s.*)?$\")', 'OCR read IX as \"]X\" and XII as \"XH\"'),\n (\"T002\", \"tools/make_mason_v001.py\", 'num = m.group(2).replace(\"n\", \"II\")', '', '.replace(\"l\", \"I\")', '.replace(\"H\", \"II\").replace(\"]\", \"I\")', 'normalise chapter numerals'),\n (\"T003\", \"tools/make_mason_v001.py\", 'caps = re.sub(r\"[^A-Za-z ]\", \"\", ', 's', ')', '\" \".join(t for t in toks if not ROMAN.match(t) and not re.search(r\"\\\\d\", t))', 'headers such as \"ii FOREWORD\" were not recognised'),\n (\"T004\", \"tools/make_mason_v001.py\", '    # page marker', '', '', 'body = [l for l in body if not re.match(r\"^\\\\s*([ivxlc]{1,5}|\\\\d{1,3})\\\\s*$\", l)] + base indent (most common indent)', 'drop page-number lines; measure indent from the page base'),\n (\"T005\", \"tools/make_mason_v001.py\", 'if indent >= ', '3', ' and para:', 'base + 3 and para and not prev_hy and not s[:1].islower()', 'false paragraph breaks from ragged OCR layout'),\n (\"T006\", \"tools/make_mason_v001.py\", 's = l.strip()\\\\n', '', '        if s in', 's = re.sub(r\"^[ivxl]{1,4}\\\\s{2,}(?=[A-Z\\\\\"\\'])\", \"\", s)\\\\n', 'roman page numbers glued to the next line'),\n (\"T007\", \"tools/make_mason_v001.py\", 'ROMAN = re.compile(r\"^[ivxlc', '', ']+$\", re.I)', 'y', 'OCR reads vii as \"yii\"; also re.I on the footer filter and whitespace-normalised headings'),\n (\"T008\", \"tools/make_mason_v001.py\", 'BLANK = {1, 2, 3, 4, 5, ', '', '8,', '7, ', 'drop the OCR copy of the title page (a new title page is set)'),\n (\"T009\", \"tools/make_mason_v001.py\", 'FIX = [ ... ', '', '(r\"\\\\^+(\\\\s*\\\\^+)*\", \"[Chinese]\")', '(r\"(?<=\\\\w)\\\\^+|\\\\^+(?=\\\\w)\", \"[?]\"), ', 'an unreadable letter inside a word was being labelled [Chinese]'),\n (\"T010\", \"tools/mason_book_v001.css\", 'font-family: ', '\"Noto Serif\",\"Noto Serif CJK SC\",serif;', '', '\"Crimson Text\",\"Liberation Serif\",\"Noto Serif CJK TC\",serif; font-size: 11.5pt;', 'Noto Serif not installed: CJK font gave full-width apostrophes'),\n (\"T011\", \"tools/spellfix_mason_v001.py\", 'def sub(p):', '', '', 'BLOCK = {...27 words...}; fixes.update({\"liad\":\"had\",\"tlien\":\"then\",\"rnan\":\"man\",...})', 'automatic choices that were wrong (liad->lead, tlien->lien, rnan->ran)'),\n (\"T012\", \"plates (rotation table)\", 'rot = {6:-90, ', '67:90, 171:90, 183:90', ', 210:-90, ...}', '67:-90, 171:-90, 183:-90', 'three photographs came out upside down'),\n (\"T013\", \"plates\", 'plate 351 ', '(as scanned)', '', 'rotate -90', 'plate was sideways'),\n (\"T014\", \"plates\", 'im.crop((0,int(h*', '0.12', '),w,int(h*0.80)))', '0.17', 'Black Stone crop included a line of text'),\n (\"T015\", \"tools/clean_zh_pages_v001.py\", \"json.dump({'W': \", \"W, 'H': H\", \", 'pages': log}\", \"int(W), 'H': int(H)\", 'numpy integers are not JSON serialisable (also box values)'),\n (\"T016\", \"tools/zh_facsimile_front_v001.html\", '<span>', '\:70b9', '</span>', '\:9ede', 'traditional form of the Justice Node seal'),\n (\"T017\", \"tools/zh_facsimile_front_v001.html\", '<div class=\"seal\">...</div>', '', '', '<div ...>CCN \:5236\:4f5c</div>', 'seal caption as on other CCN works'),\n (\"T018\", \"tools/app_template_v001.html\", '.lightbox{position:fixed', '', '', '.viewer{...} .dl{...} ', 'styles for the page viewer and downloads'),\n (\"T019\", \"tools/app_template_v001.html\", 'Ask</button>', '', '\\\\n', '\\\\n<button ... data-v=\"downloads\">Downloads</button>', 'Downloads tab (user request: originals for public download)'),\n (\"T020\", \"tools/app_template_v001.html\", '__ZHDATA__</script>', '', '', '<script id=\"dl-data\">__DLDATA__</script><script id=\"facs-data\">__FACSDATA__</script>', 'data blocks filled by make_app'),\n (\"T021\", \"tools/app_template_v001.html\", 'const DOCS = [', 'two entries', '];', 'three entries incl. facsimile (facs: true)', 'Chinese facsimile as its own text'),\n (\"T022\", \"tools/app_template_v001.html\", \"$('#mdLink').href = \", 'd.md;', '', \"d.md || '#'; hide when none; language switch only for Mason\", 'facsimile has no Markdown'),\n (\"T023\", \"tools/app_template_v001.html\", 'const d = DOCS.find((x) => x.id === current);', '', '', '\\\\nif (d.facs) { renderFacs(); return; }', 'render the facsimile'),\n (\"T024\", \"tools/app_template_v001.html\", 'function zhBlock(z, s) {', '', '', 'if (current === \"mason\" && FACS.pages) return makeViewer(...)', 'Chinese pane = page viewer at the matching juan'),\n (\"T025\", \"tools/app_template_v001.html\", 'docSel.onchange', '', '', 'makeViewer, renderFacs, keyboard paging, downloads list', 'viewer and downloads code'),\n (\"T026\", \"tools/app_template_v001.html\", 'Never give personal details about the people who make this app.', '', '', 'AI-honesty answer + privacy referral to Lucia Valente', 'EMAIL-CONTEXT rules'),\n (\"T027\", \"tools/app_template_v001.html\", 'go(k) { ... ', 'preload always', '', 'preload only after the reader turns a page; img.loading = lazy', 'avoid loading 70 pages when the parallel view opens'),\n (\"T028\", \"tools/app_template_v001.html\", '.par .zhpane{', '', 'font-family', 'align-self:start;', 'sticky viewer inside the grid'),\n (\"T029\", \"tools/app_template_v001.html\", \"if (h[0] === 'read')\", '', '', \"if (h[2] ...) lang = h[2]; \", '#read/mason/par links (and headless test)'),\n (\"T030\", \"tools/app_template_v001.html\", '.btn.primary{', '', '', '.btn{text-decoration:none;display:inline-block}', 'download links were underlined'),\n (\"T031\", \"tools/app_template_v001.html\", 'max_tokens: ', '900', ', system: PERSONA', '1500', 'DO006[3]: empty reply at the token limit'),\n (\"T032\", \"tools/make_app_v001.py\", 'MASON_MAP = {', '', '\"foreword\": 9,', '\"top\": 2, \"list-of-illustrations\": 2, ', 'title section opened the cover, not the title page'),\n]\nDO = [  # (index, what, [(iteration, result)], record)\n (\"DO001\", \"OCR trials on \:5929\:65b9\:81f3\:8056\:5be6\:9304 p. 10\", [(\"1\", \"tesseract chi_tra psm 5: unusable\"), (\"2\", \"tesseract jpn_vert psm 5: ~55 %\"), (\"3\", \"cells -> one line, chi_tra psm 7: ~70 %\"), (\"4\", \"+ ring punctuation removed: ~70 %\"), (\"5\", \"single cells psm 10: ~65 %\"), (\"6\", \"RapidOCR PP-OCRv3: ~80 %, simplified forms\")], \"records/04_ocr_trials_v001.md\"),\n (\"DO002\", \"fold-label OCR (right margin) on 295 cleaned pages\", [(\"1\:2013295\", \"no labels found: margin was trimmed away\")], \"records/03_zh_juan_detection_ocr_v001.txt\"),\n (\"DO003\", \"first-column OCR on 295 pages to find juan headings\", [(\"1\:2013295\", \"found \:5e8f p. 9, \:91cd\:5370\:5e8f p. 23, \:5377\:76ee p. 43, \:5377\:4e00\:2026\:5377\:5341 pp. 51, 77, 97, 109, 123, 145, 163, 197, 231, 257\")], \"records/03_zh_juan_detection_ocr_v001.txt\"),\n (\"DO004\", \"Mason clear-text build (tools/make_mason_v001.py)\", [(\"1\", \"19 headings, false paragraph breaks\"), (\"2\", \"23 headings after T001\:2013T002\"), (\"3\", \"front matter fixed (T003\:2013T007)\"), (\"4\", \"295 page markers, gaps only at plate pages\"), (\"5\", \"PDF 338 pp.\"), (\"6\", \"PDF 278 pp. with Crimson Text (T010)\"), (\"7\", \"PDF 277 pp., 8.8 MB after T008\")], \"texts/ArabianProphet_Mason1921_v001.md\"),\n (\"DO005\", \"spelling pass (tools/spellfix_mason_v001.py)\", [(\"1\", \"121 automatic fixes\"), (\"2\", \"97 after review (T011)\")], \"records/01_mason_spellfixes_v001.json\"),\n (\"DO006\", \"HanKitabKernel tests\", [(\"1\", \"bad key refused\"), (\"2\", \"{15., 2}, chat_ready True\"), (\"3\", \"max_tokens 60: empty text\"), (\"4\", \"max_tokens 1500: correct answer\")], \"records/05_kernel_tests_v001.md\"),\n (\"DO007\", \"app headless browser tests (Chrome, localhost)\", [(\"1\", \"#library: renders, no console errors\"), (\"2\", \"#read/mason\"), (\"3\", \"#read/facs: viewer at \:5377\:4e00 p. 51\"), (\"4\", \"#downloads: 5 rows with sizes\"), (\"5\", \"#read/mason/par: English + page viewer\"), (\"6\", \"390\:00d7844 mobile: facsimile readable\")], \"records/06_app_screens_v001.png\"),\n (\"DO008\", \"facsimile PDF build\", [(\"1\", \"img2pdf from PNG: 297 pp., 18.0 MB\"), (\"2\", \"CCITT G4 TIFF: 297 pp., 10.7 MB\")], \"texts/TianfangZhishengShilu_1924_facsimile_v001.pdf\"),\n]\ncells = [cell(\"Han Kitab \:00b7 Operations Log v001\", \"Title\"),\n         cell(\"Every code change is written as (T) u x v \:2192 u y v: u is the text just before the change, x the text removed, v the text just after it, y the text put in. Every run or test is a (DO) entry with its iterations [i]. Raw outputs are in records/. Conventions: docs/CCN_Acronyms_and_Conventions_v002.md.\", \"Text\"),\n         cell(\"(T) Rewrites\", \"Section\")]\nfor idx, f, u, x, v, y, why in T:\n    cells.append(cell(f\"{idx} \:00b7 {f}\", \"Subsection\"))\n    cells.append(cell(f\"u = {u}\\nx = {x if x else '(empty: insertion)'}\\nv = {v if v else '(empty)'}\\ny = {y}\\nwhy: {why}\", \"Program\"))\ncells.append(cell(\"(DO) Runs\", \"Section\"))\nfor idx, what, its, rec in DO:\n    cells.append(cell(f\"{idx} \:00b7 {what}\", \"Subsection\"))\n    cells.append(cell(\"\\n\".join(f\"[{i}] {r}\" for i, r in its) + f\"\\nraw output: {rec}\", \"Program\"))\ncells.append(cell(\"Operations data as a Wolfram expression\", \"Section\"))\nq = lambda t: '\"' + t.replace(\"\\\\\", \"\\\\\\\\\").replace('\"', '\\\\\"') + '\"'\ndata = \"opsT = {\" + \", \".join(\"<|\\\"index\\\" -> %s, \\\"file\\\" -> %s, \\\"why\\\" -> %s|>\" % (q(i), q(f), q(w)) for i, f, u, x, v, y, w in T) + \"};\\n\" \\\n       \"opsDO = {\" + \", \".join(\"<|\\\"index\\\" -> %s, \\\"what\\\" -> %s, \\\"iterations\\\" -> %d|>\" % (q(i), q(w), len(it)) for i, w, it, r in DO) + \"};\\n{Length[opsT], Length[opsDO]}\"\ncells.append(cell(data, \"Input\"))\nnotebook(\"wolfram/HanKitabOperationsLog_v001.nb\", cells)\n\n# ---------- 3. development log ----------\ndev = [\n (\"Title\", \"Han Kitab \:00b7 Development Log v001\"),\n (\"Text\", \"How the Han Kitab reader and its editions were built on 20\:201321 November 2026.\"),\n (\"Section\", \"1. Research report\"),\n (\"Text\", \"Web research on the Han Kitab corpus, authors, editions and the history of Sinification; written as docs/HanKitab_Research_v001.md and rendered to PDF with pandoc and headless Chrome. Chinese passages are short public-domain excerpts with new English translations; unverified items are flagged in the report.\"),\n (\"Section\", \"2. The Arabian Prophet (Mason 1921), clear-text edition\"),\n (\"Text\", \"Source: Internet Archive scan cu31924024748232 (Cornell copy), 368 pages, with an OCR text layer. tools/make_mason_v001.py reads each page with pdftotext -layout, removes running heads and page-number lines, splits footnotes from body text, rejoins paragraphs and hyphenated words, marks unreadable Chinese as [Chinese] and unreadable letters as [?], and keeps the original page numbers as [p. N]. Plates were cut from the scan at 200 dpi, trimmed and turned upright. tools/spellfix_mason_v001.py makes cautious one-edit spelling fixes, checked by hand (records/01). Trials and fixes: Operations Log T001\:2013T014, DO004\:2013DO005.\"),\n (\"Section\", \"3. \:5929\:65b9\:81f3\:8056\:5be6\:9304 (1924), facsimile\"),\n (\"Text\", \"Source: National Library of China scan on Wikimedia Commons, NLC416-13jh005373-59385, 295 pages (prefaces, contents, juan 1\:201310). Text recognition was tried with Tesseract and RapidOCR (DO001, records/04); at best about 80 % of characters were right and some came out in simplified form. The user decided: copy the pages as they are and add only a cover and copyright page. tools/clean_zh_pages_v001.py removes specks of 6 pixels or fewer, trims each page to its printed area and centres it on one page size; nothing else is touched. The PDF uses CCITT G4 images (10.7 MB). Juan start pages were found by reading the first column of every page (DO003).\"),\n (\"Section\", \"4. The app (HanKitab_v001.html)\"),\n (\"Text\", \"Modelled on the TUTUcat repository (single index.html + manifest + service worker + icons), without the talking head. Tabs: Library, Read (English, English + \:4e2d\:6587 with the Chinese page viewer opened at the matching juan, or \:4e2d\:6587 alone; text size; read aloud with browser voices), Search (offline, across all texts), Ask (HanKitabKernel chat with passages from the texts; offline it returns the passages), Downloads (editions and the unchanged original scans), About. Built by tools/make_app_v001.py from tools/app_template_v001.html. Tests: DO007.\"),\n (\"Section\", \"5. HanKitabKernel\"),\n (\"Text\", \"Same design as TUTUKernel / LaplacianLabKernel. Deployed from the user's signed-in Wolfram kernel to https://www.wolframcloud.com/obj/ccn2/HanKitabKernel, reusing the private chat key object LaplacianLab/apikey and a new private secret HanKitab/secret. Tests DO006: the chat needs max_tokens well above 60 (T031).\"),\n (\"Section\", \"Glossary\"),\n (\"Text\", \"Han Kitab \:6f22\:514b\:5854\:5e03: Chinese-language Islamic books. juan \:5377: a fascicle or chapter of a Chinese book. \:5929\:65b9\:81f3\:8056\:5be6\:9304: Liu Zhi's life of the Prophet. Facsimile: the pages reproduced as images, unchanged. OCR: machine reading of text from images. CCITT G4: lossless compression for black-and-white images. PWA: a web page that can be installed like an app. (T) / (DO): see docs/CCN_Acronyms_and_Conventions_v002.md.\"),\n]\nnotebook(\"wolfram/HanKitabDevelopmentLog_v001.nb\", [cell(t, s) for s, t in dev])\n\n# ---------- 4. scripts ----------\ncells = [cell(\"Han Kitab \:00b7 Scripts v001\", \"Title\"),\n         cell(\"Every script and template used to build this release, one cell each (Program style). The files themselves are in tools/ and wolfram/.\", \"Text\")]\nfor f in sorted(glob.glob(\"tools/*.py\") + glob.glob(\"tools/*.html\") + glob.glob(\"tools/*.css\") + [\"sw.js\", \"manifest.webmanifest\", \"wolfram/HanKitabKernel_v001.wl\"]):\n    cells.append(cell(f, \"Section\"))\n    cells.append(cell(open(f, encoding=\"utf-8\").read(), \"Program\"))\nnotebook(\"wolfram/HanKitabScripts_v001.nb\", cells)\nprint(\"notebooks written\")\n", "Program"],
Cell["tools/make_notebooks_v002.py", "Section"],
Cell["#!/usr/bin/env python3\n\"\"\"Write the Han Kitab Wolfram notebooks (plain Notebook[] expressions, ASCII-escaped) into wolfram/.\n  HanKitabKernel_v002.nb          deploy + test HanKitabKernel\n  HanKitabOperationsLog_v002.nb   (T) rewrites u x v -> u y v and (DO) runs with indexed iterations\n  HanKitabDevelopmentLog_v002.nb  how the work was built: trials, results, fixes, glossary\n  HanKitabScripts_v002.nb         every script and the app template, one cell each\nRun from the repo root: python3 tools/make_notebooks_v002.py\n\:00a9 Computational Classnotes \:00b7 CC BY-NC-SA 4.0\"\"\"\nimport glob, os\n\ndef esc(s):\n    out = []\n    for ch in s:\n        o = ord(ch)\n        if ch == \"\\\\\": out.append(\"\\\\\\\\\")\n        elif ch == '\"': out.append('\\\\\"')\n        elif ch == \"\\n\": out.append(\"\\\\n\")\n        elif ch == \"\\t\": out.append(\"    \")\n        elif o < 32: continue\n        elif o < 128: out.append(ch)\n        elif o <= 0xFFFF: out.append(\"\\\\:%04x\" % o)\n        else: out.append(\"\\\\|%06x\" % o)\n    return \"\".join(out)\n\ndef cell(text, style): return 'Cell[\"%s\", \"%s\"]' % (esc(text), style)\nCOPY = \"\:00a9 Computational Classnotes \:00b7 CC BY-NC-SA 4.0\"\n\ndef notebook(path, cells):\n    body = \",\\n\".join(cells + [cell(COPY, \"Text\")])\n    open(path, \"w\", encoding=\"ascii\").write(\n        \"(* Content-type: application/vnd.wolfram.mathematica *)\\n(* \" + esc(COPY) + \" *)\\n\"\n        \"Notebook[{\\n\" + body + \"\\n}, WindowTitle -> \\\"\" + esc(os.path.basename(path)) + \"\\\"]\\n\")\n\n# ---------- 1. kernel ----------\nwl = open(\"wolfram/HanKitabKernel_v002.wl\", encoding=\"utf-8\").read()\nblocks = [b.strip() for b in wl.split(\"\\n\\n\") if b.strip()]\ncells = [cell(\"HanKitabKernel v002\", \"Title\"),\n         cell(\"Wolfram Cloud chat proxy for the Han Kitab reader. Same protocol as TUTUKernel and LaplacianLabKernel (CCN Cloud Kit). Deployed at https://www.wolframcloud.com/obj/ccn2/HanKitabKernel on 21 Nov 2026. The chat key is read from the private cloud object LaplacianLab/apikey; the app key (secret) is stored privately as HanKitab/secret and in HanKitabKernel_SECRET_private.txt in the Desktop folder. Never commit the secret.\", \"Text\")]\nfor b in blocks:\n    if \"CloudPut[\" in b and \"apikey\" in b:\n        cells.append(cell(\"Step 1 (only if the key is not stored yet). Paste the key, evaluate once, then delete the key from this cell and save the notebook, so the key is not kept in the file.\", \"Text\"))\n    if b.startswith(\"(*\") and b.endswith(\"*)\"):\n        cells.append(cell(b[2:-2].strip(), \"Text\"))\n    else:\n        cells.append(cell(b, \"Input\"))\ncells += [cell(\"Tests (DO012). Each cell is self-contained; no key is needed for status and chat.\", \"Section\"),\n          cell('u = \"https://www.wolframcloud.com/obj/ccn2/HanKitabKernel\";\\n'\n               'URLExecute[HTTPRequest[u, <|\"Method\" -> \"POST\", \"Body\" -> {\"mode\" -> \"status\"}|>], \"RawJSON\"]', \"Input\"),\n          cell('u = \"https://www.wolframcloud.com/obj/ccn2/HanKitabKernel\";\\n'\n               'pl = BaseEncode[ExportByteArray[<|\"max_tokens\" -> 1500, \"system\" -> \"Answer in one short sentence.\", \"messages\" -> {<|\"role\" -> \"user\", \"content\" -> \"Who wrote \\u5929\\u65b9\\u6027\\u7406?\"|>}|>, \"RawJSON\", \"Compact\" -> True]];\\n'\n               'ch = URLExecute[HTTPRequest[u, <|\"Method\" -> \"POST\", \"Body\" -> {\"mode\" -> \"chat\", \"payload_b64\" -> pl}|>], \"RawJSON\"];\\n'\n               'If[KeyExistsQ[ch, \"text_b64\"], {ch[\"stop_reason\"], ByteArrayToString[BaseDecode[ch[\"text_b64\"]]]}, ch]', \"Input\"),\n          cell('u = \"https://www.wolframcloud.com/obj/ccn2/HanKitabKernel\";\\n'\n               'URLExecute[HTTPRequest[u, <|\"Method\" -> \"POST\", \"Body\" -> {\"mode\" -> \"wolfram\", \"key\" -> CloudGet[\"HanKitab/secret\"], \"code\" -> \"{$VersionNumber, 1 + 1}\"}|>], \"RawJSON\"]', \"Input\")]\nnotebook(\"wolfram/HanKitabKernel_v003.nb\", cells)\n\n# ---------- 2. operations log ----------\nT = [  # (index, file, u, x, v, y, why)\n (\"T001\", \"tools/make_mason_v001.py\", 'CHAP = re.compile(r\"^\\\\s*(CHAPTER|APPENDIX)\\\\s+(', '[IVXLnl1]+)\\\\b(.*)$\")', '', '[IVXLnlH\\\\]1]+)(\\\\s.*)?$\")', 'OCR read IX as \"]X\" and XII as \"XH\"'),\n (\"T002\", \"tools/make_mason_v001.py\", 'num = m.group(2).replace(\"n\", \"II\")', '', '.replace(\"l\", \"I\")', '.replace(\"H\", \"II\").replace(\"]\", \"I\")', 'normalise chapter numerals'),\n (\"T003\", \"tools/make_mason_v001.py\", 'caps = re.sub(r\"[^A-Za-z ]\", \"\", ', 's', ')', '\" \".join(t for t in toks if not ROMAN.match(t) and not re.search(r\"\\\\d\", t))', 'headers such as \"ii FOREWORD\" were not recognised'),\n (\"T004\", \"tools/make_mason_v001.py\", '    # page marker', '', '', 'body = [l for l in body if not re.match(r\"^\\\\s*([ivxlc]{1,5}|\\\\d{1,3})\\\\s*$\", l)] + base indent (most common indent)', 'drop page-number lines; measure indent from the page base'),\n (\"T005\", \"tools/make_mason_v001.py\", 'if indent >= ', '3', ' and para:', 'base + 3 and para and not prev_hy and not s[:1].islower()', 'false paragraph breaks from ragged OCR layout'),\n (\"T006\", \"tools/make_mason_v001.py\", 's = l.strip()\\\\n', '', '        if s in', 's = re.sub(r\"^[ivxl]{1,4}\\\\s{2,}(?=[A-Z\\\\\"\\'])\", \"\", s)\\\\n', 'roman page numbers glued to the next line'),\n (\"T007\", \"tools/make_mason_v001.py\", 'ROMAN = re.compile(r\"^[ivxlc', '', ']+$\", re.I)', 'y', 'OCR reads vii as \"yii\"; also re.I on the footer filter and whitespace-normalised headings'),\n (\"T008\", \"tools/make_mason_v001.py\", 'BLANK = {1, 2, 3, 4, 5, ', '', '8,', '7, ', 'drop the OCR copy of the title page (a new title page is set)'),\n (\"T009\", \"tools/make_mason_v001.py\", 'FIX = [ ... ', '', '(r\"\\\\^+(\\\\s*\\\\^+)*\", \"[Chinese]\")', '(r\"(?<=\\\\w)\\\\^+|\\\\^+(?=\\\\w)\", \"[?]\"), ', 'an unreadable letter inside a word was being labelled [Chinese]'),\n (\"T010\", \"tools/mason_book_v001.css\", 'font-family: ', '\"Noto Serif\",\"Noto Serif CJK SC\",serif;', '', '\"Crimson Text\",\"Liberation Serif\",\"Noto Serif CJK TC\",serif; font-size: 11.5pt;', 'Noto Serif not installed: CJK font gave full-width apostrophes'),\n (\"T011\", \"tools/spellfix_mason_v001.py\", 'def sub(p):', '', '', 'BLOCK = {...27 words...}; fixes.update({\"liad\":\"had\",\"tlien\":\"then\",\"rnan\":\"man\",...})', 'automatic choices that were wrong (liad->lead, tlien->lien, rnan->ran)'),\n (\"T012\", \"plates (rotation table)\", 'rot = {6:-90, ', '67:90, 171:90, 183:90', ', 210:-90, ...}', '67:-90, 171:-90, 183:-90', 'three photographs came out upside down'),\n (\"T013\", \"plates\", 'plate 351 ', '(as scanned)', '', 'rotate -90', 'plate was sideways'),\n (\"T014\", \"plates\", 'im.crop((0,int(h*', '0.12', '),w,int(h*0.80)))', '0.17', 'Black Stone crop included a line of text'),\n (\"T015\", \"tools/clean_zh_pages_v001.py\", \"json.dump({'W': \", \"W, 'H': H\", \", 'pages': log}\", \"int(W), 'H': int(H)\", 'numpy integers are not JSON serialisable (also box values)'),\n (\"T016\", \"tools/zh_facsimile_front_v001.html\", '<span>', '\:70b9', '</span>', '\:9ede', 'traditional form of the Justice Node seal'),\n (\"T017\", \"tools/zh_facsimile_front_v001.html\", '<div class=\"seal\">...</div>', '', '', '<div ...>CCN \:5236\:4f5c</div>', 'seal caption as on other CCN works'),\n (\"T018\", \"tools/app_template_v001.html\", '.lightbox{position:fixed', '', '', '.viewer{...} .dl{...} ', 'styles for the page viewer and downloads'),\n (\"T019\", \"tools/app_template_v001.html\", 'Ask</button>', '', '\\\\n', '\\\\n<button ... data-v=\"downloads\">Downloads</button>', 'Downloads tab (user request: originals for public download)'),\n (\"T020\", \"tools/app_template_v001.html\", '__ZHDATA__</script>', '', '', '<script id=\"dl-data\">__DLDATA__</script><script id=\"facs-data\">__FACSDATA__</script>', 'data blocks filled by make_app'),\n (\"T021\", \"tools/app_template_v001.html\", 'const DOCS = [', 'two entries', '];', 'three entries incl. facsimile (facs: true)', 'Chinese facsimile as its own text'),\n (\"T022\", \"tools/app_template_v001.html\", \"$('#mdLink').href = \", 'd.md;', '', \"d.md || '#'; hide when none; language switch only for Mason\", 'facsimile has no Markdown'),\n (\"T023\", \"tools/app_template_v001.html\", 'const d = DOCS.find((x) => x.id === current);', '', '', '\\\\nif (d.facs) { renderFacs(); return; }', 'render the facsimile'),\n (\"T024\", \"tools/app_template_v001.html\", 'function zhBlock(z, s) {', '', '', 'if (current === \"mason\" && FACS.pages) return makeViewer(...)', 'Chinese pane = page viewer at the matching juan'),\n (\"T025\", \"tools/app_template_v001.html\", 'docSel.onchange', '', '', 'makeViewer, renderFacs, keyboard paging, downloads list', 'viewer and downloads code'),\n (\"T026\", \"tools/app_template_v001.html\", 'Never give personal details about the people who make this app.', '', '', 'AI-honesty answer + privacy referral to Lucia Valente', 'EMAIL-CONTEXT rules'),\n (\"T027\", \"tools/app_template_v001.html\", 'go(k) { ... ', 'preload always', '', 'preload only after the reader turns a page; img.loading = lazy', 'avoid loading 70 pages when the parallel view opens'),\n (\"T028\", \"tools/app_template_v001.html\", '.par .zhpane{', '', 'font-family', 'align-self:start;', 'sticky viewer inside the grid'),\n (\"T029\", \"tools/app_template_v001.html\", \"if (h[0] === 'read')\", '', '', \"if (h[2] ...) lang = h[2]; \", '#read/mason/par links (and headless test)'),\n (\"T030\", \"tools/app_template_v001.html\", '.btn.primary{', '', '', '.btn{text-decoration:none;display:inline-block}', 'download links were underlined'),\n (\"T031\", \"tools/app_template_v001.html\", 'max_tokens: ', '900', ', system: PERSONA', '1500', 'DO006[3]: empty reply at the token limit'),\n (\"T032\", \"tools/make_app_v001.py\", 'MASON_MAP = {', '', '\"foreword\": 9,', '\"top\": 2, \"list-of-illustrations\": 2, ', 'title section opened the cover, not the title page'),\n (\"T033\", \"wolfram/HanKitabKernel_v002.wl\", 'Which[\\n', '', '     #key =!= secret,', '#mode === \"status\", <|\"chat_ready\" ..., \"open_chat\" -> True|>,\\n #mode === \"chat\", ... (moved above the key check)\\n', 'readers ask without a key; only code evaluation stays behind the secret'),\n (\"T034\", \"wolfram/HanKitabKernel_v002.wl\", '\"key\" -> \"String\"', '', ',', ' -> \"\"', 'key optional'),\n (\"T035\", \"wolfram/HanKitabKernel_v002.wl\", '\"max_tokens\" -> Clip[..., {1, ', '4096', '}]', '1500', 'limit spend on an open address; also at most 12 messages and 60 000 characters'),\n (\"T036\", \"wolfram/HanKitabKernel_v002.wl\", 'With[{', 'keyObj = CloudObject[\"HanKitab/apikey\"]', ', secret = ...}', 'keyObjs = {CloudObject[\"HanKitab/apikey\"], CloudObject[\"LaplacianLab/apikey\"]}', 'use HanKitab/apikey once it is stored; until then the LaplacianLab key'),\n (\"T037\", \"tools/app_template_v002.html\", '<div class=\"keyrow\">', '<span ...>Offline\:2026</span><input id=\"keyIn\"\:2026><button id=\"connectBtn\">Connect</button>', '</div>', '<span id=\"ccnState\">Connecting to CCN Cloud\:2026</span>', 'no key box for readers'),\n (\"T038\", \"tools/app_template_v002.html\", 'async function ccnConnect() {', 'if (!ccnKey) return false; \:2026 mode wolfram check \:2026', '}', 'kernelCall({ mode: \"status\" }); auto-connect on load and when back online', 'automatic connection'),\n (\"T039\", \"tools/app_template_v002.html\", \"new URLSearchParams(\", \"{ key: ccnKey, ...params }\", \")\", \"params\", 'no key sent'),\n (\"T040\", \"sw.js, manifest.webmanifest, index.html\", \"HanKitab_\", \"v001\", \".html\", \"v002\", 'point installs and the redirect at the v002 app; cache hankitab-v002'),\n (\"T041\", \"app files\", \"OUT = \", 'f\"HanKitab_{VERSION}.html\"', \"\", '\"index.html\"', 'editor: no app versioning; one fixed URL, overwritten each time. HanKitab_v001.html removed; template and builder renamed app_template.html, make_app.py'),\n (\"T043\", \"tools/app_template.html\", \"\", \"the About line on Ask answers, the AI/Claude/Anthropic wording in Ask, the MODEL setting and the credit title\", \"\", \"(removed; neutral wording: 'Connected to CCN Cloud.'; the kernel chooses the model)\", 'editor request; the guide still answers honestly if asked whether it is a person'),\n (\"T044\", \"tools/app_template.html\", \"DOCS.forEach((d) => {\\n\", \"\", \"      const h = ...getElementById(d.tpl)\", \"      if (!d.tpl) return;\\n\", 'search and Ask failed (null template) once the facsimile was added; found in the live test DO010[2]'),\n (\"T045\", \"tools/app_template.html\", \"const hits = search(\", \"words longer than 3 letters, all required\", \", 6);\", \"key words without stop-words (Liu, Zhi kept), any may match\", 'Ask found no passage for \"Who was Liu Zhi?\" (DO010[3])'),\n (\"T046\", \"tools/make_notebooks_v002.py (kernel tests)\", \"pl = BaseEncode[\", 'StringToByteArray[ExportString[..., \"RawJSON\", ...]]', \"];\", 'ExportByteArray[..., \"RawJSON\", ...]', 'test failed in the notebook: u and secret were defined in another cell, and the Chinese question was UTF-8 encoded twice; each test cell is now self-contained (HanKitabKernel_v003.nb)'),\n (\"T047\", \"tools/app_template.html\", \"const ctx = hits.map((h, i) => `[${i + 1}] \", \"${title} \:00b7 ${section}\", \": ${text}`\", \"Source: <full source line> Section: <section> (a footnote by Isaac Mason).\", 'Ask was unsure whether a footnote was Mason\\'s; each passage now carries its source'),\n (\"T048\", \"tools/app_template.html\", 'data-v=\"search\"', '', '', 'History tab: sections 1, 2, 3, 7 and 8 of the research report, with its own contents list', 'editor: add the history research to the site'),\n (\"T049\", \"tools/app_template.html\", \"wait.\", \"textContent = t.trim();\", \" wait.className\", \"innerHTML = esc(t) with **bold**, *italic* and # headings rendered\", 'answers showed raw ** marks (DO013[2])'),\n (\"T050\", \"tools/app_template.html\", 'Justice Node</a>', '', '</footer>', ' \:00b7 <a href=\"https://discuss.compclassnotes.com/\">CCN Node</a>', 'editor: link to the CCN discussion site in the footer'),\n (\"T051\", \"tools/app_template.html\", 'History</button>', '', '\\n', '\\n<button ... data-v=\"gallery\">Gallery</button> + section v-gallery (header image, category chips, masonry tiles, lightbox with credit, keys and swipe)', 'editor: a rich gallery of Chinese mosques and Muslim areas'),\n (\"T052\", \"tools/app_template.html\", '<h1 class=\"page\">Library</h1>', '', '', 'hero with the \:5929\:65b9\:6b63\:5b78 (1861) alif page as cover art and credit line', 'editor: cover art from the Manchester page'),\n (\"T053\", \"tools/make_app.py\", '.replace(\"__DLDATA__\", ...)', '', '', '\\n.replace(\"__GALDATA__\", gallery/gallery_v001.json)', 'gallery data embedded in index.html'),\n (\"T054\", \"tools/app_template.html\", '.hero figure{margin:0', ';transform:rotate(1.5deg)', '}', '', 'editor: the cover art looked crooked; tilt removed (caption counter-tilt removed too)'),\n (\"T055\", \"tools/app_template.html\", '<figure>', '', '<img src=\"img/cover_...\">', '<a id=\"coverLink\" href=\"img/cover_TianfangZhengxue_1861.jpg\"> + caption links: Full size \:00b7 original photograph with colour chart', 'editor: a link to the larger image; the cover also opens full size on tap'),\n (\"T056\", \"docs/HanKitab_Research_v001.md (+ .pdf, index.html, project copy)\", \"imposed from above.\", \" Scholars such as David Stroup describe its aim as greater state supervision; some critics call it an erasure of Muslim identity.\", \"\\n\", \"\", 'editor request: sentence removed (section 7.2); also \"; critics see its use as cover for repression\" -> \".\" (section 8.5)'),\n(\"T057\", \"wolfram/HanKitabKernel_v004.wl\", 'Which[\\n #mode === \"status\", ...,', '', '\\n #mode === \"chat\",', '\\n #mode === \"news\", <|\"updated\" -> ..., \"news_b64\" -> ...|>,', 'keyless weekly news; owner key + code \"refresh\" forces a new fetch'),\n (\"T058\", \"wolfram/HanKitabKernel_v004.wl\", 'getNews[force_] := ... AbsoluteTime[] - Lookup[c, \"t\", 0] < ', '', '', '7*24*3600', 'editor: \"I like a weekly update\"; cache HanKitab/newscache (private) refreshed once a week'),\n (\"T059\", \"wolfram/HanKitabKernel_v004.wl\", 'x = ', 'ImportString[r[\"Body\"], \"XML\"]', ';', 'ImportByteArray[r[\"BodyByteArray\"], \"XML\"] /. s_String :> FromCharacterCode[ToCharacterCode[s], \"UTF-8\"]', 'headlines arrived as raw UTF-8 bytes (mojibake, Chinese filtered out); decoded'),\n (\"T060\", \"wolfram/HanKitabKernel_v004.wl\", 'pickIt[list_, lang_, n_] := ', 'Take[sorted, UpTo[n]]', '', 'past 7 days; if fewer than 3, past 45 days; if still fewer than 3, latest 4', 'Google News ignores when:7d on long site: queries; dates filtered in the kernel'),\n (\"T061\", \"tools/app_template.html\", '<h1 class=\"page\">', '', 'Library</h1>', '<section class=\"news\" id=\"news\"> \:4e2d\:6587 / China / Middle East / Asia tabs, headline list, footer </section>', 'editor: Chinese Muslim news on the front page, only Chinese, Asian and Middle Eastern outlets'),\n (\"T062\", \"tools/app_template.html\", '/* ---------- install + offline ---------- */\\n', \"beforeinstallprompt shows a hidden button\", '', 'button always shown; installs when allowed, otherwise a message with steps for iPhone, Safari, Firefox, Chrome (as in Tutu Cat)', 'editor: install button as in Tutu Cat'),\n(\"T063\", \"wolfram/HanKitabKernel_v004.wl\", 'Select[list, okq[#1] && ', 'StringContainsQ[title, kw] && StringContainsQ[title, cnkw]', ' & ]', 'StringContainsQ[title, kw] with kw = Chinese-Muslim phrases only (chinese muslim, muslims in china, hui people/muslim, uyghur, ningxia hui, linxia, sinicisation, mosques in china, chinese halal, \:56de\:65cf, \:6e05\:771f, \:7ef4\:543e\:5c14, \:4e2d\:56fd\:7a46\:65af\:6797 \:2026)', 'editor: the Netanyahu headline (China and Muslims named separately) is not about Chinese Muslims; a China word plus a Muslim word is no longer enough'),\n(\"T064\", \"tools/app_template.html\", '<section class=\"view on\" id=\"v-library\"> ... ', '<section class=\"news\" id=\"news\"> ... </section>', '<h1 class=\"page\">Library</h1>', '', 'editor: news off the front page'),\n (\"T065\", \"tools/app_template.html\", '<!-- GALLERY -->', '', '', '<section class=\"view\" id=\"v-news\"> News \:00b7 \:4e2d\:570b\:7a46\:65af\:6797\:65b0\:805e, editorial (about Chinese Muslims; weekly; Chinese, Asian and Middle Eastern outlets; views are the outlets\\' own), headline panel with tabs </section>; nav button News after Gallery', 'editor: a News button with the panel and an editorial on top'),\n(\"T066\", \"manifest.webmanifest\", '\"id\": \"', './', '\",', '/han-kitab/', 'bug: installing Han Kitab replaced Packing Station. The manifest id is resolved against the site origin, not the folder, so \"./\" meant https://lossofgenerality.github.io/ for every app on the site (Packing Station, Tutu Cat, Han Kitab); Chrome saw one app'),\n (\"T042\", \"sw.js\", \"const VERSION = '\", \"hankitab-v002\", \"';\", \"hankitab-<sha1 of index.html, 10 hex>\", 'cache name set automatically by make_app.py'),\n]\nDO = [  # (index, what, [(iteration, result)], record)\n (\"DO001\", \"OCR trials on \:5929\:65b9\:81f3\:8056\:5be6\:9304 p. 10\", [(\"1\", \"tesseract chi_tra psm 5: unusable\"), (\"2\", \"tesseract jpn_vert psm 5: ~55 %\"), (\"3\", \"cells -> one line, chi_tra psm 7: ~70 %\"), (\"4\", \"+ ring punctuation removed: ~70 %\"), (\"5\", \"single cells psm 10: ~65 %\"), (\"6\", \"RapidOCR PP-OCRv3: ~80 %, simplified forms\")], \"records/04_ocr_trials_v001.md\"),\n (\"DO002\", \"fold-label OCR (right margin) on 295 cleaned pages\", [(\"1\:2013295\", \"no labels found: margin was trimmed away\")], \"records/03_zh_juan_detection_ocr_v001.txt\"),\n (\"DO003\", \"first-column OCR on 295 pages to find juan headings\", [(\"1\:2013295\", \"found \:5e8f p. 9, \:91cd\:5370\:5e8f p. 23, \:5377\:76ee p. 43, \:5377\:4e00\:2026\:5377\:5341 pp. 51, 77, 97, 109, 123, 145, 163, 197, 231, 257\")], \"records/03_zh_juan_detection_ocr_v001.txt\"),\n (\"DO004\", \"Mason clear-text build (tools/make_mason_v001.py)\", [(\"1\", \"19 headings, false paragraph breaks\"), (\"2\", \"23 headings after T001\:2013T002\"), (\"3\", \"front matter fixed (T003\:2013T007)\"), (\"4\", \"295 page markers, gaps only at plate pages\"), (\"5\", \"PDF 338 pp.\"), (\"6\", \"PDF 278 pp. with Crimson Text (T010)\"), (\"7\", \"PDF 277 pp., 8.8 MB after T008\")], \"texts/ArabianProphet_Mason1921_v001.md\"),\n (\"DO005\", \"spelling pass (tools/spellfix_mason_v001.py)\", [(\"1\", \"121 automatic fixes\"), (\"2\", \"97 after review (T011)\")], \"records/01_mason_spellfixes_v001.json\"),\n (\"DO006\", \"HanKitabKernel tests\", [(\"1\", \"bad key refused\"), (\"2\", \"{15., 2}, chat_ready True\"), (\"3\", \"max_tokens 60: empty text\"), (\"4\", \"max_tokens 1500: correct answer\")], \"records/05_kernel_tests_v001.md\"),\n (\"DO007\", \"app headless browser tests (Chrome, localhost)\", [(\"1\", \"#library: renders, no console errors\"), (\"2\", \"#read/mason\"), (\"3\", \"#read/facs: viewer at \:5377\:4e00 p. 51\"), (\"4\", \"#downloads: 5 rows with sizes\"), (\"5\", \"#read/mason/par: English + page viewer\"), (\"6\", \"390\:00d7844 mobile: facsimile readable\")], \"records/06_app_screens_v001.png\"),\n (\"DO009\", \"HanKitabKernel v002 tests\", [(\"1\", \"status without key: chat_ready True, open_chat True\"), (\"2\", \"wolfram 1+1 without key: refused\"), (\"3\", \"wolfram 1+1 with secret: 2\"), (\"4\", \"chat without key: answer received\")], \"records/07_kernel_v002_tests_v001.md\"),\n (\"DO010\", \"live page test, v002 (GitHub Pages, built-in browser)\", [(\"1\", \"status: Connected, no key box\"), (\"2\", \"Ask failed: null template -> T044\"), (\"3\", \"no passages -> T045\"), (\"4\", \"answer citing the report\"), (\"5\", \"Search Black Stone: 11\"), (\"6\", \"7 downloads: 200\"), (\"7\", \"no Claude/Anthropic in the page\")], \"records/08_live_v002_test_v001.md\"),\n (\"DO011\", \"own chat key\", [(\"1\", \"HanKitab/apikey stored, owner-only\"), (\"2\", \"open chat answered using it\")], \"records/09_own_chat_key_v001.md\"),\n (\"DO012\", \"kernel notebook tests (v003 cells, run in the local kernel)\", [(\"1\", \"status\"), (\"2\", \"chat in Chinese\"), (\"3\", \"code with secret\")], \"records/10_kernel_notebook_tests_v001.md\"),\n (\"DO013\", \"History tab and source labels\", [(\"1\", \"headless: History renders sections 1, 2, 3, 7, 8 with contents\"), (\"2\", \"live: Ask on the Black Stone credits Mason's footnote\")], \"records/11_history_tab_v001.png\"),\n (\"DO014\", \"gallery: Commons search and selection (run on the editor's local Wolfram kernel)\", [(\"1\", \"44 subjects searched, 39 images with open licences\"), (\"2\", \"contact sheet: 7 wrong or weak images found (plaque, map, stairs, dessert\:2026)\"), (\"3\", \"16 alternative searches, 42 candidates, 14 chosen\"), (\"4\", \"45 photographs in 4 categories; headless test of Library hero and Gallery\")], \"gallery/CREDITS_v001.md, records/12_gallery_and_cover_v001.png\"),\n(\"DO015\", \"weekly news (kernel v004, local Wolfram kernel)\", [(\"1\", \"deploy broke chat (chatCall missing): redeployed with full chatCall; chat end_turn\"), (\"2\", \"Chinese section 0: bytes not decoded; fixed: 10 items, Linxia 70th anniversary\"), (\"3\", \"when:7d ignored; kernel date window; sections 4/4/4/10\"), (\"4\", \"code mode with secret: 1+1 = 2\"), (\"5\", \"stricter filter: Netanyahu headline gone; sections 3/4/4/10, chat end_turn\")], \"wolfram/HanKitabKernel_v004.wl\"),\n (\"DO008\", \"facsimile PDF build\", [(\"1\", \"img2pdf from PNG: 297 pp., 18.0 MB\"), (\"2\", \"CCITT G4 TIFF: 297 pp., 10.7 MB\")], \"texts/TianfangZhishengShilu_1924_facsimile_v001.pdf\"),\n]\ncells = [cell(\"Han Kitab \:00b7 Operations Log v002\", \"Title\"),\n         cell(\"Every code change is written as (T) u x v \:2192 u y v: u is the text just before the change, x the text removed, v the text just after it, y the text put in. Every run or test is a (DO) entry with its iterations [i]. Raw outputs are in records/. Conventions: docs/CCN_Acronyms_and_Conventions_v002.md.\", \"Text\"),\n         cell(\"(T) Rewrites\", \"Section\")]\nfor idx, f, u, x, v, y, why in T:\n    cells.append(cell(f\"{idx} \:00b7 {f}\", \"Subsection\"))\n    cells.append(cell(f\"u = {u}\\nx = {x if x else '(empty: insertion)'}\\nv = {v if v else '(empty)'}\\ny = {y}\\nwhy: {why}\", \"Program\"))\ncells.append(cell(\"(DO) Runs\", \"Section\"))\nfor idx, what, its, rec in DO:\n    cells.append(cell(f\"{idx} \:00b7 {what}\", \"Subsection\"))\n    cells.append(cell(\"\\n\".join(f\"[{i}] {r}\" for i, r in its) + f\"\\nraw output: {rec}\", \"Program\"))\ncells.append(cell(\"Operations data as a Wolfram expression\", \"Section\"))\nq = lambda t: '\"' + t.replace(\"\\\\\", \"\\\\\\\\\").replace('\"', '\\\\\"') + '\"'\ndata = \"opsT = {\" + \", \".join(\"<|\\\"index\\\" -> %s, \\\"file\\\" -> %s, \\\"why\\\" -> %s|>\" % (q(i), q(f), q(w)) for i, f, u, x, v, y, w in T) + \"};\\n\" \\\n       \"opsDO = {\" + \", \".join(\"<|\\\"index\\\" -> %s, \\\"what\\\" -> %s, \\\"iterations\\\" -> %d|>\" % (q(i), q(w), len(it)) for i, w, it, r in DO) + \"};\\n{Length[opsT], Length[opsDO]}\"\ncells.append(cell(data, \"Input\"))\nnotebook(\"wolfram/HanKitabOperationsLog_v002.nb\", cells)\n\n# ---------- 3. development log ----------\ndev = [\n (\"Title\", \"Han Kitab \:00b7 Development Log v002\"),\n (\"Text\", \"How the Han Kitab reader and its editions were built on 20\:201321 November 2026. v002 (21 Nov): Ask is open to readers without a key (section 6).\"),\n (\"Section\", \"1. Research report\"),\n (\"Text\", \"Web research on the Han Kitab corpus, authors, editions and the history of Sinification; written as docs/HanKitab_Research_v001.md and rendered to PDF with pandoc and headless Chrome. Chinese passages are short public-domain excerpts with new English translations; unverified items are flagged in the report.\"),\n (\"Section\", \"2. The Arabian Prophet (Mason 1921), clear-text edition\"),\n (\"Text\", \"Source: Internet Archive scan cu31924024748232 (Cornell copy), 368 pages, with an OCR text layer. tools/make_mason_v001.py reads each page with pdftotext -layout, removes running heads and page-number lines, splits footnotes from body text, rejoins paragraphs and hyphenated words, marks unreadable Chinese as [Chinese] and unreadable letters as [?], and keeps the original page numbers as [p. N]. Plates were cut from the scan at 200 dpi, trimmed and turned upright. tools/spellfix_mason_v001.py makes cautious one-edit spelling fixes, checked by hand (records/01). Trials and fixes: Operations Log T001\:2013T014, DO004\:2013DO005.\"),\n (\"Section\", \"3. \:5929\:65b9\:81f3\:8056\:5be6\:9304 (1924), facsimile\"),\n (\"Text\", \"Source: National Library of China scan on Wikimedia Commons, NLC416-13jh005373-59385, 295 pages (prefaces, contents, juan 1\:201310). Text recognition was tried with Tesseract and RapidOCR (DO001, records/04); at best about 80 % of characters were right and some came out in simplified form. The user decided: copy the pages as they are and add only a cover and copyright page. tools/clean_zh_pages_v001.py removes specks of 6 pixels or fewer, trims each page to its printed area and centres it on one page size; nothing else is touched. The PDF uses CCITT G4 images (10.7 MB). Juan start pages were found by reading the first column of every page (DO003).\"),\n (\"Section\", \"4. The app (HanKitab_v002.html)\"),\n (\"Text\", \"Modelled on the TUTUcat repository (single index.html + manifest + service worker + icons), without the talking head. Tabs: Library, Read (English, English + \:4e2d\:6587 with the Chinese page viewer opened at the matching juan, or \:4e2d\:6587 alone; text size; read aloud with browser voices), Search (offline, across all texts), Ask (HanKitabKernel chat with passages from the texts; offline it returns the passages), Downloads (editions and the unchanged original scans), About. Built by tools/make_app_v002.py from tools/app_template_v002.html. Tests: DO007.\"),\n (\"Section\", \"5. HanKitabKernel\"),\n (\"Text\", \"Same design as TUTUKernel / LaplacianLabKernel. Deployed from the user's signed-in Wolfram kernel to https://www.wolframcloud.com/obj/ccn2/HanKitabKernel, reusing the private chat key object LaplacianLab/apikey and a new private secret HanKitab/secret. Tests DO006: the chat needs max_tokens well above 60 (T031).\"),\n (\"Section\", \"6. v002: open Ask\"),\n (\"Text\", \"The editor asked that readers should not have to enter a key, as the readership is small. HanKitabKernel v002 answers mode status and mode chat without a key; only mode wolfram (code evaluation) still needs the secret. To protect the account on an open address, answers are capped at 1500 tokens, a request may carry at most 12 messages and 60 000 characters, and only Claude models are allowed. The chat key is read from HanKitab/apikey once it is stored, otherwise from LaplacianLab/apikey. The app connects by itself (mode status) and shows no key box (T033\:2013T040, DO009\:2013DO010).\"),\n (\"Section\", \"Glossary\"),\n (\"Text\", \"Han Kitab \:6f22\:514b\:5854\:5e03: Chinese-language Islamic books. juan \:5377: a fascicle or chapter of a Chinese book. \:5929\:65b9\:81f3\:8056\:5be6\:9304: Liu Zhi's life of the Prophet. Facsimile: the pages reproduced as images, unchanged. OCR: machine reading of text from images. CCITT G4: lossless compression for black-and-white images. PWA: a web page that can be installed like an app. (T) / (DO): see docs/CCN_Acronyms_and_Conventions_v002.md.\"),\n]\nnotebook(\"wolfram/HanKitabDevelopmentLog_v002.nb\", [cell(t, s) for s, t in dev])\n\n# ---------- 4. scripts ----------\ncells = [cell(\"Han Kitab \:00b7 Scripts v002\", \"Title\"),\n         cell(\"Every script and template used to build this release, one cell each (Program style). The files themselves are in tools/ and wolfram/.\", \"Text\")]\nfor f in sorted(glob.glob(\"tools/*.py\") + glob.glob(\"tools/*.html\") + glob.glob(\"tools/*.css\") + [\"sw.js\", \"manifest.webmanifest\", \"wolfram/HanKitabKernel_v002.wl\", \"wolfram/HanKitabKernel_v004.wl\"]):\n    cells.append(cell(f, \"Section\"))\n    cells.append(cell(open(f, encoding=\"utf-8\").read(), \"Program\"))\nnotebook(\"wolfram/HanKitabScripts_v002.nb\", cells)\nprint(\"notebooks written\")\n", "Program"],
Cell["tools/mason_book_v001.css", "Section"],
Cell["@page { size: A5; margin: 16mm 14mm 16mm 14mm; }\nbody { font-family: \"Crimson Text\",\"Liberation Serif\",\"Noto Serif CJK TC\",serif; font-size: 11.5pt; font-size: 10.5pt; line-height: 1.5; color:#1a1a1a; text-align: justify; hyphens: auto; }\nh1 { font-size: 24pt; text-align:center; margin: 0 0 6px; letter-spacing: .5px; }\nh2 { font-size: 15pt; text-align:center; margin-top: 0; padding-top: 18px; page-break-before: always; color:#222; letter-spacing:1px; }\nh2 + p em, h2 + p > em { display:block; font-size: 9.5pt; text-align:center; color:#444; margin: 0 6mm 10px; }\np { margin: 0 0 6px; text-indent: 1.2em; }\n.titlepage { text-align:center; padding-top: 30mm; page-break-after: always; }\n.titlepage p { text-indent:0; margin: 12px 0; }\n.titlepage .sub { font-size: 12pt; font-style: italic; }\n.ednote { font-size: 9pt; border:1px solid #bbb; padding: 6px 10px; margin: 10px 0; page-break-after: always; }\n.ednote p { text-indent:0; }\n.dedication { text-align:center; font-style: italic; padding: 40mm 10mm; page-break-after: always; }\n.pg { font-size: 7pt; color:#888; font-family: sans-serif; white-space: nowrap; }\n.notes { font-size: 8.3pt; line-height: 1.35; color:#333; border-top: 0.5px solid #aaa; margin: 4px 0 10px; padding-top: 3px; text-align:left; }\n.loc { color:#888; font-size: 7.5pt; font-family:sans-serif; }\n.lines { text-align:center; font-size: 9.5pt; margin: 10px 0; }\n.index { font-size: 8.5pt; line-height: 1.3; column-count: 2; column-gap: 6mm; text-align:left; }\nfigure.plate { page-break-inside: avoid; margin: 10px 0; text-align:center; }\nfigure.plate img { max-width: 100%; max-height: 165mm; }\nfigcaption { font-size: 8.5pt; font-style: italic; margin-top: 4px; }\ntable { border-collapse: collapse; font-size: 8.5pt; width:100%; } td,th { border-bottom: 0.5px solid #ccc; padding: 2px 4px; text-align:left; }\nheader#title-block-header { display:none; }\n", "Program"],
Cell["tools/spellfix_mason_v001.py", "Section"],
Cell["#!/usr/bin/env python3\n\"\"\"Conservative OCR spelling fixes: a lower-case word unknown to the dictionary and rare in the book\nis replaced only by a single-edit candidate that is a dictionary word AND occurs >=3 times in the book.\"\"\"\nimport re, sys, collections, json\nfrom spellchecker import SpellChecker\nsp = SpellChecker(distance=1)\nsrc = sys.argv[1]\nmd = open(src).read()\n# protect html tags\nparts = re.split(r\"(<[^>]+>)\", md)\nwords = collections.Counter(w for i, p in enumerate(parts) if i % 2 == 0 for w in re.findall(r\"[A-Za-z]+\", p))\nlow = collections.Counter({w: c for w, c in words.items() if w.islower()})\nfixes = {}\nfor w, c in low.items():\n    if c > 2 or len(w) < 4 or w in sp:\n        continue\n    cands = [x for x in sp.edit_distance_1(w) if x in sp and low.get(x, 0) >= 3]\n    if len(cands) == 1 or (cands and max(cands, key=lambda x: low[x]) and sorted(cands, key=lambda x: -low[x])[0]):\n        best = sorted(cands, key=lambda x: -low[x])\n        if best and (len(best) == 1 or low[best[0]] >= 3 * low[best[1]]):\n            fixes[w] = best[0]\nBLOCK = {\"othe\",\"ther\",\"thei\",\"ohammed\",\"cometo\",\"losa\",\"elie\",\"aith\",\"doesn\",\"couldn\",\"sheeps\",\"ardour\",\"ither\",\"hter\",\"thos\",\n         \"erid\",\"recognise\",\"laine\",\"ching\",\"appl\",\"mits\",\"coun\",\"oach\",\"nien\",\"pened\",\"teing\",\"ived\"}\nfor b in BLOCK: fixes.pop(b, None)\nfixes.update({\"liad\":\"had\",\"tlien\":\"then\",\"rnan\":\"man\",\"moming\":\"morning\",\"arrd\":\"and\",\"ajid\":\"and\",\"atid\":\"and\",\"pened\":\"opened\",\"teing\":\"being\",\"ived\":\"lived\"})\ndef sub(p):\n    return re.sub(r\"\\b([a-z]+)\\b\", lambda m: fixes.get(m.group(1), m.group(1)), p)\nout = \"\".join(sub(p) if i % 2 == 0 else p for i, p in enumerate(parts))\nopen(src, \"w\").write(out)\njson.dump(fixes, open(\"records_spellfixes_v001.json\", \"w\"), ensure_ascii=False, indent=0)\nprint(len(fixes)); print(list(fixes.items())[:60])\n", "Program"],
Cell["tools/zh_facsimile_front_v001.html", "Section"],
Cell["<!DOCTYPE html><html lang=\"zh-Hant\"><head><meta charset=\"utf-8\"><style>\n@page{size:4.67in 8.387in;margin:0}\nbody{margin:0;font-family:\"Noto Serif CJK TC\",\"Crimson Text\",serif;color:#1c1c1c}\n.pg{width:4.67in;height:8.387in;box-sizing:border-box;page-break-after:always;position:relative;overflow:hidden}\n.cover{background:#F4F1EA;border:0}\n.frame{position:absolute;inset:.32in;border:2px solid #1F5C4F;outline:1px solid #B0812F;outline-offset:-7px}\n.vt{position:absolute;right:1.35in;top:1.05in;writing-mode:vertical-rl;font-size:44pt;font-weight:700;letter-spacing:.12em;color:#1F5C4F}\n.vs{position:absolute;right:.62in;top:1.15in;writing-mode:vertical-rl;font-size:13.5pt;letter-spacing:.2em}\n.en{position:absolute;left:.62in;bottom:1.0in;width:1.75in;font-family:\"Crimson Text\",serif;font-size:11pt;line-height:1.35}\n.en b{font-size:14pt;display:block;margin-bottom:4px}\n.seal{position:absolute;left:.62in;top:1.0in;width:.78in;height:.78in;border:2.5px solid #A3271F;color:#A3271F;display:grid;grid-template-columns:1fr 1fr;place-items:center;font-size:17pt;font-weight:700;line-height:1;padding:3px;box-sizing:border-box}\n.ccn{position:absolute;left:.62in;bottom:.5in;font:8pt \"Crimson Text\",serif;color:#555}\n.cp{padding:.55in .5in;font-family:\"Crimson Text\",\"Noto Serif CJK TC\",serif;font-size:9.6pt;line-height:1.42}\n.cp h2{font-size:13pt;margin:0 0 6px} .cp p{margin:0 0 7px} .cp .zh{font-family:\"Noto Serif CJK TC\";font-size:9.2pt}\n.cp hr{border:0;border-top:1px solid #bbb;margin:10px 0}\n</style></head><body>\n<div class=\"pg cover\"><div class=\"frame\"></div>\n <div class=\"vt\">\:5929\:65b9\:81f3\:8056\:5be6\:9304</div>\n <div class=\"vs\">\:6e05\:3000\:5289\:667a\:3000\:4ecb\:5ec9\:3000\:64b0\:3000\:00b7\:3000\:5377\:9996\:81f3\:5377\:5341</div>\n <div class=\"seal\"><span>\:6b63</span><span>\:7fa9</span><span>\:7bc0</span><span>\:9ede</span></div><div style=\"position:absolute;left:.62in;top:1.84in;width:.78in;text-align:center;font-size:7pt;color:#A3271F\">CCN \:5236\:4f5c</div>\n <div class=\"en\"><b>Tianfang zhisheng shilu</b>The True Annals of the Utmost Sage of Islam<br>by Liu Zhi (Liu Jielian), completed 1724<br><br>Prefaces and juan 1\:201310, from the 1924 printing<br>Facsimile edition v001</div>\n <div class=\"ccn\">Computational Classnotes \:00b7 2026</div>\n</div>\n<div class=\"pg cp\">\n <h2>About this facsimile \:00b7 \:672c\:5f71\:5370\:672c\:8aaa\:660e</h2>\n <p><b>The pages that follow are the original printed pages, reproduced as they are.</b> Not a character has been changed, added or removed. The only work done on the images: isolated specks of dust under 7 pixels were removed, each page was trimmed to its printed area and centred on a page of one size. The original wording, punctuation, page order, the library marks and the binding pages are all kept.</p>\n <p class=\"zh\">\:4ee5\:4e0b\:5404\:9801\:70ba\:539f\:66f8\:5370\:672c\:ff0c\:7167\:539f\:6a23\:5f71\:5370\:ff0c\:4e00\:5b57\:672a\:6539\:3002\:50c5\:6e05\:9664\:7d30\:5c0f\:6c61\:9ede\:ff0c\:88c1\:53bb\:9801\:908a\:ff0c\:7f6e\:65bc\:540c\:4e00\:5c3a\:5bf8\:9801\:9762\:4e4b\:4e2d\:3002</p>\n <p><b>Work:</b> \:5929\:65b9\:81f3\:8056\:5be6\:9304 (also \:5929\:65b9\:81f3\:8056\:5be6\:9304\:5e74\:8b5c), by \:5289\:667a Liu Zhi (c. 1660\:2013c. 1730), a life of the Prophet Muhammad in Classical Chinese, completed 1724. This volume holds the prefaces, the table of contents and juan 1 to 10 of the 20 juan.</p>\n <p><b>Edition reproduced:</b> printing of \:6c11\:570b\:5341\:4e09\:5e74 (1924), publisher not stated, 295 pages. Copy in the National Library of China (\:4e2d\:570b\:570b\:5bb6\:5716\:66f8\:9928), digitized and published on Wikimedia Commons as <i>NLC416-13jh005373-59385 \:5929\:65b9\:81f3\:8056\:5be6\:9304.pdf</i>.</p>\n <p><b>Copyright:</b> Liu Zhi\:2019s text (1724) and the 1924 printing are in the public domain. The original scan is kept unchanged in the project repository for public download. The cover, this page and the processing of the images are \:00a9 Computational Classnotes \:00b7 CC BY-NC-SA 4.0.</p>\n <p><b>English:</b> Isaac Mason translated a selection of this work as <i>The Arabian Prophet</i> (Shanghai, 1921); a clear-text edition is published alongside this facsimile.</p>\n <hr>\n <p>Computational Classnotes \:00b7 Justice Node \:6b63\:7fa9\:7bc0\:9ede \:00b7 https://justice.compclassnotes.com/<br>Source and downloads: https://github.com/lossofgenerality/han-kitab</p>\n <p><b>\:00a9 Computational Classnotes \:00b7 CC BY-NC-SA 4.0</b></p>\n</div>\n</body></html>\n", "Program"],
Cell["wolfram/HanKitabKernel_v002.wl", "Section"],
Cell["(* ::Package:: *)\n(* HanKitabKernel v002 : Wolfram Cloud chat proxy for the Han Kitab reader (HanKitab_v001.html).\n   Same design and protocol as TUTUKernel / LaplacianLabKernel (CCN Cloud Kit):\n     POST key, mode (\"wolfram\" | \"chat\"), code_b64, payload_b64  ->  JSON\n     mode \"status\":  no key needed; returns chat_ready and open_chat\n     mode \"chat\":    no key needed (open to readers; v002); max_tokens capped at 1500, at most 12 messages\n     mode \"wolfram\": needs the secret; evaluates code, returns text, text_b64, chat_ready\n     mode \"chat\":    payload_b64 = base64(UTF-8 JSON {model, max_tokens, system, messages})\n                     returns text_b64 and stop_reason, or error and status. The chat key is never returned.\n   Run these two steps from a signed-in Mathematica or Wolfram Cloud notebook (the Claude Wolfram\n   connector is not signed in to the Cloud, so it cannot deploy).\n   (c) Computational Classnotes . CC BY-NC-SA 4.0 *)\n\n(* Step 1, once: store the chat API key privately in your cloud account.\n   Until HanKitab/apikey exists the kernel falls back to LaplacianLab/apikey. *)\nCloudPut[\"PASTE-THE-CHAT-API-KEY-HERE\", \"HanKitab/apikey\", Permissions -> \"Private\"]\n\n(* Step 2: deploy. The secret only guards the \"wolfram\" mode (code evaluation), for the owner.\n   v002: secret = CloudGet[\"HanKitab/secret\"].\n   Deploying again under the same name keeps the URL:\n   https://www.wolframcloud.com/obj/ccn2/HanKitabKernel *)\nWith[{keyObjs = {CloudObject[\"HanKitab/apikey\"], CloudObject[\"LaplacianLab/apikey\"]}, secret = CloudGet[\"HanKitab/secret\"]},\n CloudDeploy[\n  APIFunction[\n   {\"code\" -> \"String\" -> \"\", \"code_b64\" -> \"String\" -> \"\", \"key\" -> \"String\" -> \"\",\n    \"mode\" -> \"String\" -> \"status\", \"payload_b64\" -> \"String\" -> \"\"},\n   Module[{b64s, fromB64, chatCall, chat, code},\n    b64s[s_String] := BaseEncode[StringToByteArray[s]];\n    fromB64[b_String] := Quiet@Check[ByteArrayToString[BaseDecode[b]], \"\"];\n    chatCall[payload_String, apiKey_String] := Module[{p, model, resp, body, status},\n      p = Quiet@Check[ImportByteArray[StringToByteArray[payload], \"RawJSON\"], $Failed];\n      If[! AssociationQ[p] || ! ListQ[p[\"messages\"]] || Length[p[\"messages\"]] > 12 || StringLength[payload] > 60000,\n       Return[<|\"error\" -> \"bad payload\", \"status\" -> 400|>]];\n      model = Replace[p[\"model\"], Except[_String?(StringStartsQ[\"claude-\"])] -> \"claude-sonnet-5-5\"];\n      resp = URLRead[HTTPRequest[\"https://api.anthropic.com/v1/messages\", <|\"Method\" -> \"POST\",\n          \"Headers\" -> {\"x-api-key\" -> apiKey, \"anthropic-version\" -> \"2023-06-01\", \"content-type\" -> \"application/json\"},\n          \"Body\" -> ExportByteArray[DeleteMissing@<|\"model\" -> model,\n              \"max_tokens\" -> Clip[Replace[p[\"max_tokens\"], Except[_Integer] -> 1500], {1, 1500}],\n              \"system\" -> p[\"system\"], \"messages\" -> p[\"messages\"]|>, \"RawJSON\", \"Compact\" -> True]|>],\n        TimeConstraint -> 110];\n      If[FailureQ[resp], Return[<|\"error\" -> \"chat service unreachable\", \"status\" -> 502|>]];\n      status = resp[\"StatusCode\"];\n      body = Quiet@Check[ImportByteArray[resp[\"BodyByteArray\"], \"RawJSON\"], <||>];\n      If[status === 200 && AssociationQ[body],\n       <|\"text_b64\" -> b64s@StringJoin[Cases[Lookup[body, \"content\", {}],\n            KeyValuePattern[{\"type\" -> \"text\", \"text\" -> t_String}] :> t]],\n         \"stop_reason\" -> Lookup[body, \"stop_reason\", \"\"]|>,\n       <|\"error\" -> If[AssociationQ[body], Lookup[Lookup[body, \"error\", <||>], \"message\", \"chat request failed\"], \"chat request failed\"],\n         \"status\" -> status|>]];\n    chat = \"\";\n    Do[If[chat === \"\", chat = Quiet@Check[CloudGet[o], \"\"]; chat = If[StringQ[chat], StringTrim[chat], \"\"]], {o, keyObjs}];\n    Which[\n     #mode === \"status\", <|\"chat_ready\" -> chat =!= \"\", \"open_chat\" -> True|>,\n     #mode === \"chat\",\n      If[chat === \"\", <|\"error\" -> \"no chat key stored\", \"status\" -> 503|>,\n       chatCall[fromB64[#[\"payload_b64\"]], chat]],\n     #key =!= secret,\n      Failure[\"Forbidden\", <|\"Message\" -> \"bad key\"|>],\n     True,\n      code = If[#[\"code_b64\"] =!= \"\", fromB64[#[\"code_b64\"]], #code];\n      Module[{r = TimeConstrained[ToExpression[code], 60, $Aborted], txt},\n       txt = ToString[r, InputForm];\n       <|\"text\" -> txt, \"text_b64\" -> b64s[txt], \"chat_ready\" -> chat =!= \"\"|>]\n     ]] &,\n   \"JSON\"],\n  \"HanKitabKernel\", Permissions -> \"Public\"]]\n\n(* Step 3, check: mode \"status\" needs no key and should give chat_ready -> True, open_chat -> True *)\n", "Program"],
Cell["wolfram/HanKitabKernel_v004.wl", "Section"],
Cell["(* HanKitabKernel v004: status, chat and weekly news open; code evaluation needs the owner secret.\n   Deployed from the editor's local Wolfram kernel. Needs allowed, kw2 (Chinese-Muslim phrase filter), cnkw2, newsSrc7 defined first\n   (see HanKitab_DevelopmentLog_v002.nb). (c) Computational Classnotes \:00b7 CC BY-NC-SA 4.0 *)\nDownValues[deployHK] = {HoldPattern[deployHK[]] :> With[{keyObjs = {CloudObject[\"HanKitab/apikey\"], CloudObject[\"LaplacianLab/apikey\"]}, secret = CloudGet[\"HanKitab/secret\"], cacheObj = CloudObject[\"HanKitab/newscache\"], allowed = Keys[allowed], kw = kw2, cnkw = cnkw2, newsSrc = newsSrc7}, CloudDeploy[APIFunction[{\"code\" -> \"String\" -> \"\", \"code_b64\" -> \"String\" -> \"\", \"key\" -> \"String\" -> \"\", \"mode\" -> \"String\" -> \"status\", \"payload_b64\" -> \"String\" -> \"\"}, Module[{b64s, fromB64, chatCall, chat, code, gnews, host, okq, clean, pickIt, getNews}, b64s[s_String] := BaseEncode[StringToByteArray[s]]; fromB64[b_String] := Quiet[Check[ByteArrayToString[BaseDecode[b]], \"\"]]; chatCall[payload_String, apiKey_String] := Module[{p, model, resp, body, status}, p = Quiet[Check[ImportByteArray[StringToByteArray[payload], \"RawJSON\"], $Failed]]; If[ !AssociationQ[p] ||  !ListQ[p[\"messages\"]] || Length[p[\"messages\"]] > 12 || StringLength[payload] > 60000, Return[Association[\"error\" -> \"bad payload\", \"status\" -> 400]]]; model = Replace[p[\"model\"], Except[_String?(StringStartsQ[\"claude-\"])] -> \"claude-sonnet-5-5\"]; resp = URLRead[HTTPRequest[\"https://api.anthropic.com/v1/messages\", Association[\"Method\" -> \"POST\", \"Headers\" -> {\"x-api-key\" -> apiKey, \"anthropic-version\" -> \"2023-06-01\", \"content-type\" -> \"application/json\"}, \"Body\" -> ExportByteArray[DeleteMissing[Association[\"model\" -> model, \"max_tokens\" -> Clip[Replace[p[\"max_tokens\"], Except[_Integer] -> 1500], {1, 1500}], \"system\" -> p[\"system\"], \"messages\" -> p[\"messages\"]]], \"RawJSON\", \"Compact\" -> True]]], TimeConstraint -> 110]; If[FailureQ[resp], Return[Association[\"error\" -> \"chat service unreachable\", \"status\" -> 502]]]; status = resp[\"StatusCode\"]; body = Quiet[Check[ImportByteArray[resp[\"BodyByteArray\"], \"RawJSON\"], Association[]]]; If[status === 200 && AssociationQ[body], Association[\"text_b64\" -> b64s[StringJoin[Cases[Lookup[body, \"content\", {}], KeyValuePattern[{\"type\" -> \"text\", \"text\" -> t_String}] :> t]]], \"stop_reason\" -> Lookup[body, \"stop_reason\", \"\"]], Association[\"error\" -> If[AssociationQ[body], Lookup[Lookup[body, \"error\", Association[]], \"message\", \"chat request failed\"], \"chat request failed\"], \"status\" -> status]]]; gnews[q_, hl_, gl_, ceid_] := Module[{r, x}, r = Quiet[URLRead[HTTPRequest[StringJoin[\"https://news.google.com/rss/search?q=\", URLEncode[q], \"&hl=\", hl, \"&gl=\", gl, \"&ceid=\", ceid], Association[\"Headers\" -> {\"User-Agent\" -> \"Mozilla/5.0 CCN-HanKitab/1.0\"}]], TimeConstraint -> 20]]; If[FailureQ[r] || r[\"StatusCode\"] =!= 200, Return[{}]]; x = ReplaceAll[Quiet[ImportByteArray[r[\"BodyByteArray\"], \"XML\"]], s$_String :> If[Max[Append[ToCharacterCode[s$], 0]] < 256, Quiet[Check[FromCharacterCode[ToCharacterCode[s$], \"UTF-8\"], s$]], s$]]; Cases[x, XMLElement[\"item\", _, c_] :> Association[\"title\" -> First[Cases[c, XMLElement[\"title\", _, {t_String}] :> t], \"\"], \"link\" -> First[Cases[c, XMLElement[\"link\", _, {t_String}] :> t], \"\"], \"date\" -> First[Cases[c, XMLElement[\"pubDate\", _, {t_String}] :> t], \"\"], \"source\" -> First[Cases[c, XMLElement[\"source\", _, {t_String}] :> t], \"\"], \"url\" -> First[Cases[c, XMLElement[\"source\", {___, \"url\" -> u_, ___}, _] :> u], \"\"]], Infinity]]; host[u_String] := StringReplace[Replace[Quiet[Check[URLParse[u, \"Domain\"], \"\"]], Except[_String] -> \"\"], StartOfString~~\"www.\" -> \"\"]; okq[it_] := AnyTrue[allowed, StringEndsQ[host[it[\"url\"]], #1] & ]; clean[it_, lang_] := Association[\"title\" -> StringTrim[StringReplace[it[\"title\"], StringJoin[\" - \", it[\"source\"]]~~EndOfString -> \"\"]], \"link\" -> it[\"link\"], \"source\" -> it[\"source\"], \"lang\" -> lang, \"date\" -> Quiet[Check[DateString[DateObject[it[\"date\"]], \"ISODateTime\"], it[\"date\"]]]]; pickIt[list_, lang_, n_] := Module[{s, w}, s = ReverseSortBy[DeleteDuplicatesBy[(clean[#1, lang] & ) /@ Select[list, okq[#1] && StringContainsQ[#1[\"title\"], kw] & ], #title & ], #date & ]; w = Select[s, Quiet[Check[AbsoluteTime[#date], 0]] >= AbsoluteTime[] - 7*86400 & ]; If[Length[w] < 3, w = Select[s, Quiet[Check[AbsoluteTime[#date], 0]] >= AbsoluteTime[] - 45*86400 & ]]; If[Length[w] < 3, w = Take[s, UpTo[4]]]; Take[w, UpTo[n]]]; getNews[force_] := Module[{c = Quiet[Check[CloudGet[cacheObj], None]], fresh}, If[ !force && AssociationQ[c] && AbsoluteTime[] - Lookup[c, \"t\", 0] < 7*24*3600, Return[c]]; fresh = Association[\"t\" -> AbsoluteTime[], \"updated\" -> DateString[\"ISODateTime\", TimeZone -> 0], \"sections\" -> Association[(#1[[1]] -> pickIt[gnews[#1[[2]], #1[[3]], #1[[4]], #1[[5]]], #1[[6]], #1[[7]]] & ) /@ newsSrc]]; Quiet[CloudPut[fresh, cacheObj, Permissions -> \"Private\"]]; fresh]; chat = \"\"; Do[If[chat === \"\", chat = Quiet[Check[CloudGet[o], \"\"]]; chat = If[StringQ[chat], StringTrim[chat], \"\"]], {o, keyObjs}]; Which[#mode === \"status\", Association[\"chat_ready\" -> chat =!= \"\", \"open_chat\" -> True], #mode === \"news\", With[{n = getNews[#key === secret && #code === \"refresh\"]}, Association[\"updated\" -> n[\"updated\"], \"news_b64\" -> BaseEncode[ExportByteArray[n[\"sections\"], \"RawJSON\", \"Compact\" -> True]]]], #mode === \"chat\", If[chat === \"\", Association[\"error\" -> \"no chat key stored\", \"status\" -> 503], chatCall[fromB64[#1[\"payload_b64\"]], chat]], #key =!= secret, Failure[\"Forbidden\", Association[\"Message\" -> \"bad key\"]], True, code = If[#1[\"code_b64\"] =!= \"\", fromB64[#1[\"code_b64\"]], #code]; Module[{r = TimeConstrained[ToExpression[code], 60, $Aborted], txt}, txt = ToString[r, InputForm]; Association[\"text\" -> txt, \"text_b64\" -> b64s[txt], \"chat_ready\" -> chat =!= \"\"]]]] & , \"JSON\"], \"HanKitabKernel\", Permissions -> \"Public\"]]};\n", "Program"],
Cell["\:00a9 Computational Classnotes \:00b7 CC BY-NC-SA 4.0", "Text"]
}, WindowTitle -> "HanKitabScripts_v002.nb"]
