DownValues[deployHK] = {HoldPattern[deployHK[]] :> With[{keyObjs = {CloudObject["HanKitab/apikey"], CloudObject["LaplacianLab/apikey"]}, secret = CloudGet["HanKitab/secret"], cacheObj = CloudObject["HanKitab/newscache"], allowed = Keys[allowed], kw = kw2, cnkw = cnkw2, newsSrc = newsSrc7}, CloudDeploy[APIFunction[{"code" -> "String" -> "", "code_b64" -> "String" -> "", "key" -> "String" -> "", "mode" -> "String" -> "status", "payload_b64" -> "String" -> ""}, Module[{b64s, fromB64, chatCall, chat, code, gnews, host, okq, clean, pickIt, getNews}, b64s[s_String] := BaseEncode[StringToByteArray[s]]; fromB64[b_String] := Quiet[Check[ByteArrayToString[BaseDecode[b]], ""]]; chatCall[payload_String, apiKey_String] := Module[{p, model, resp, body, status}, p = Quiet[Check[ImportByteArray[StringToByteArray[payload], "RawJSON"], $Failed]]; If[ !AssociationQ[p] ||  !ListQ[p["messages"]] || Length[p["messages"]] > 12 || StringLength[payload] > 60000, Return[Association["error" -> "bad payload", "status" -> 400]]]; model = Replace[p["model"], Except[_String?(StringStartsQ["claude-"])] -> "claude-sonnet-5-5"]; resp = URLRead[HTTPRequest["https://api.anthropic.com/v1/messages", Association["Method" -> "POST", "Headers" -> {"x-api-key" -> apiKey, "anthropic-version" -> "2023-06-01", "content-type" -> "application/json"}, "Body" -> ExportByteArray[DeleteMissing[Association["model" -> model, "max_tokens" -> Clip[Replace[p["max_tokens"], Except[_Integer] -> 1500], {1, 1500}], "system" -> p["system"], "messages" -> p["messages"]]], "RawJSON", "Compact" -> True]]], TimeConstraint -> 110]; If[FailureQ[resp], Return[Association["error" -> "chat service unreachable", "status" -> 502]]]; status = resp["StatusCode"]; body = Quiet[Check[ImportByteArray[resp["BodyByteArray"], "RawJSON"], Association[]]]; If[status === 200 && AssociationQ[body], Association["text_b64" -> b64s[StringJoin[Cases[Lookup[body, "content", {}], KeyValuePattern[{"type" -> "text", "text" -> t_String}] :> t]]], "stop_reason" -> Lookup[body, "stop_reason", ""]], Association["error" -> If[AssociationQ[body], Lookup[Lookup[body, "error", Association[]], "message", "chat request failed"], "chat request failed"], "status" -> status]]]; gnews[q_, hl_, gl_, ceid_] := Module[{r, x}, r = Quiet[URLRead[HTTPRequest[StringJoin["https://news.google.com/rss/search?q=", URLEncode[q], "&hl=", hl, "&gl=", gl, "&ceid=", ceid], Association["Headers" -> {"User-Agent" -> "Mozilla/5.0 CCN-HanKitab/1.0"}]], TimeConstraint -> 20]]; If[FailureQ[r] || r["StatusCode"] =!= 200, Return[{}]]; x = ReplaceAll[Quiet[ImportByteArray[r["BodyByteArray"], "XML"]], s$_String :> If[Max[Append[ToCharacterCode[s$], 0]] < 256, Quiet[Check[FromCharacterCode[ToCharacterCode[s$], "UTF-8"], s$]], s$]]; Cases[x, XMLElement["item", _, c_] :> Association["title" -> First[Cases[c, XMLElement["title", _, {t_String}] :> t], ""], "link" -> First[Cases[c, XMLElement["link", _, {t_String}] :> t], ""], "date" -> First[Cases[c, XMLElement["pubDate", _, {t_String}] :> t], ""], "source" -> First[Cases[c, XMLElement["source", _, {t_String}] :> t], ""], "url" -> First[Cases[c, XMLElement["source", {___, "url" -> u_, ___}, _] :> u], ""]], Infinity]]; host[u_String] := StringReplace[Replace[Quiet[Check[URLParse[u, "Domain"], ""]], Except[_String] -> ""], StartOfString~~"www." -> ""]; okq[it_] := AnyTrue[allowed, StringEndsQ[host[it["url"]], #1] & ]; clean[it_, lang_] := Association["title" -> StringTrim[StringReplace[it["title"], StringJoin[" - ", it["source"]]~~EndOfString -> ""]], "link" -> it["link"], "source" -> it["source"], "lang" -> lang, "date" -> Quiet[Check[DateString[DateObject[it["date"]], "ISODateTime"], it["date"]]]]; pickIt[list_, lang_, n_] := Module[{s, w}, s = ReverseSortBy[DeleteDuplicatesBy[(clean[#1, lang] & ) /@ Select[list, okq[#1] && StringContainsQ[#1["title"], kw] && StringContainsQ[#1["title"], cnkw] & ], #title & ], #date & ]; w = Select[s, Quiet[Check[AbsoluteTime[#date], 0]] >= AbsoluteTime[] - 7*86400 & ]; If[Length[w] < 3, w = Select[s, Quiet[Check[AbsoluteTime[#date], 0]] >= AbsoluteTime[] - 45*86400 & ]]; If[Length[w] < 3, w = Take[s, UpTo[4]]]; Take[w, UpTo[n]]]; getNews[force_] := Module[{c = Quiet[Check[CloudGet[cacheObj], None]], fresh}, If[ !force && AssociationQ[c] && AbsoluteTime[] - Lookup[c, "t", 0] < 7*24*3600, Return[c]]; fresh = Association["t" -> AbsoluteTime[], "updated" -> DateString["ISODateTime", TimeZone -> 0], "sections" -> Association[(#1[[1]] -> pickIt[gnews[#1[[2]], #1[[3]], #1[[4]], #1[[5]]], #1[[6]], #1[[7]]] & ) /@ newsSrc]]; Quiet[CloudPut[fresh, cacheObj, Permissions -> "Private"]]; fresh]; chat = ""; Do[If[chat === "", chat = Quiet[Check[CloudGet[o], ""]]; chat = If[StringQ[chat], StringTrim[chat], ""]], {o, keyObjs}]; Which[#mode === "status", Association["chat_ready" -> chat =!= "", "open_chat" -> True], #mode === "news", With[{n = getNews[#key === secret && #code === "refresh"]}, Association["updated" -> n["updated"], "news_b64" -> BaseEncode[ExportByteArray[n["sections"], "RawJSON", "Compact" -> True]]]], #mode === "chat", If[chat === "", Association["error" -> "no chat key stored", "status" -> 503], chatCall[fromB64[#1["payload_b64"]], chat]], #key =!= secret, Failure["Forbidden", Association["Message" -> "bad key"]], True, code = If[#1["code_b64"] =!= "", fromB64[#1["code_b64"]], #code]; Module[{r = TimeConstrained[ToExpression[code], 60, $Aborted], txt}, txt = ToString[r, InputForm]; Association["text" -> txt, "text_b64" -> b64s[txt], "chat_ready" -> chat =!= ""]]]] & , "JSON"], "HanKitabKernel", Permissions -> "Public"]]};
